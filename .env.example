# ---- Resend (contact form) ----
RESEND_API_KEY=
# Must live on a domain verified in Resend.
CONTACT_FROM_EMAIL=c@comandos.me
CONTACT_TO_EMAIL=c@comandos.me

# ---- Cloudflare Turnstile (anti-spam) ----
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Analytics (optional) ----
PUBLIC_GA_ID=

# ---- Search engine verification (optional) ----
# Google Search Console (Settings → Ownership verification → HTML tag → copy "content")
PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools (Site verification → HTML Meta Tag → copy "content")
PUBLIC_BING_VERIFICATION=
