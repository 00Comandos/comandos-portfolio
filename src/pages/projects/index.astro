---
import { getImage } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ProjectCard from "~/components/projects/ProjectCard.astro";
import { MARKETS, MARKET_LABELS, projects } from "~/data/projects";
import { site } from "~/lib/site";

export const prerender = true;

const sorted = [...projects].sort((a, b) => a.order - b.order);
// Filter tabs: only markets that have cases, with their counts.
const markets = MARKETS.map((m) => ({ id: m, label: MARKET_LABELS[m], count: sorted.filter((p) => p.market === m).length })).filter(
  (m) => m.count > 0,
);

const ogVariant = await getImage({
  src: sorted[0].image,
  width: 1200,
  format: "webp",
});

const description =
  "Product design case studies by Comandos for Stori, Karta, Truora, Legalario, Yaydoo and more: FinTech, SaaS, IoT and FoodTech, with real outcomes.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Product Design Case Studies — Comandos",
    url: `${site.url}/projects/`,
    description,
    hasPart: sorted.map((p) => ({
      "@type": "CreativeWork",
      name: p.title,
      url: `${site.url}/projects/${p.slug}/`,
      about: { "@type": "Organization", name: p.brand },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Projects",
        item: `${site.url}/projects/`,
      },
    ],
  },
];
---

<BaseLayout
  title="Product Design Case Studies: FinTech, SaaS, IoT"
  description={description}
  image={ogVariant.src}
  imageAlt={`${sorted[0].brand} — ${sorted[0].title}. Featured product design case study by Carlos Comandos.`}
  jsonLd={jsonLd}
>
  <section class="container-page pt-12 md:pt-20 pb-20">
    <div class="grid gap-10 md:gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <aside class="lg:pt-6 min-w-0">
        <div class="lg:sticky lg:top-24">
          <h1 class="display-serif text-[3.25rem] md:text-[4rem] lg:text-[3.25rem] xl:text-[4rem] max-w-[14ch]">
            Building<br /><em>exponential<br />growth</em>
          </h1>
          <nav class="pf" aria-label="Filter case studies by market" data-pf>
            <button type="button" class="pf-tab" data-market="all" aria-pressed="true">
              All <span class="pf-count mono">{sorted.length}</span>
            </button>
            {
              markets.map((m) => (
                <button type="button" class="pf-tab" data-market={m.id} aria-pressed="false">
                  {m.label} <span class="pf-count mono">{m.count}</span>
                </button>
              ))
            }
          </nav>
          <p class="sr-only" aria-live="polite" data-pf-status></p>
        </div>
      </aside>

      <div class="min-w-0 divide-y divide-[color:var(--color-border)]" data-pf-list>
        {
          sorted.map((project) => (
            <div data-market={project.market}>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Market filter: show/hide cards; the choice lives in ?market= so a
  // filtered list can be shared. Without JS every case shows.
  const nav = document.querySelector<HTMLElement>("[data-pf]");
  const list = document.querySelector<HTMLElement>("[data-pf-list]");
  const status = document.querySelector<HTMLElement>("[data-pf-status]");
  if (nav && list) {
    const tabs = Array.from(nav.querySelectorAll<HTMLButtonElement>("[data-market]"));
    const items = Array.from(list.querySelectorAll<HTMLElement>(":scope > [data-market]"));
    const apply = (m: string, push: boolean) => {
      const valid = tabs.some((t) => t.dataset.market === m) ? m : "all";
      tabs.forEach((t) => t.setAttribute("aria-pressed", String(t.dataset.market === valid)));
      let n = 0;
      items.forEach((it) => {
        const show = valid === "all" || it.dataset.market === valid;
        it.hidden = !show;
        if (show) n++;
      });
      if (status) status.textContent = `${n} case ${n === 1 ? "study" : "studies"}`;
      if (push) {
        const url = new URL(location.href);
        if (valid === "all") url.searchParams.delete("market");
        else url.searchParams.set("market", valid);
        history.replaceState(null, "", url);
      }
    };
    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        apply(t.dataset.market ?? "all", true);
        // On phones the list starts below the fold — bring it into view.
        if (window.matchMedia("(max-width: 1023px)").matches) list.scrollIntoView({ behavior: "smooth", block: "start" });
      }),
    );
    apply(new URL(location.href).searchParams.get("market") ?? "all", false);
  }
</script>

<style>
  /* Phones/tablet: one swipeable row, bleeding to the screen edges. */
  .pf {
    display: flex;
    gap: 0.5rem;
    margin: 2rem -1.25rem 0;
    padding: 0 1.25rem 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-padding-inline: 1.25rem;
  }
  .pf::-webkit-scrollbar {
    display: none;
  }
  .pf-tab {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-paper);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .pf-tab:hover {
    border-color: var(--color-ink);
  }
  .pf-tab[aria-pressed="true"] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .pf-count {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .pf-tab[aria-pressed="true"] .pf-count {
    color: var(--color-accent);
  }
  /* Desktop: the same chips, wrapping under the sticky title. */
  @media (min-width: 1024px) {
    .pf {
      flex-wrap: wrap;
      overflow: visible;
      margin: 2.25rem 0 0;
      padding: 0;
      max-width: 26rem;
    }
  }
  [data-pf-list] > [hidden] {
    display: none;
  }
</style>
