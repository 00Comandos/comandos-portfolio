---
// PROTOTYPE (internal, noindex) — /method hero in the engraved line +
// halftone style, to compare before touching the live page.
import BaseLayout from "~/layouts/BaseLayout.astro";
import MountainArt from "~/components/method/MountainArt.astro";
import { ui } from "~/i18n";

export const prerender = true;
const t = ui.en;
const p = t.methodPage;
const camps = t.method.steps.map((s) => s.label);
---

<BaseLayout title="Prototype — Method hero (internal)" description="Internal prototype." noindex>
  <p class="proto-note mono container-page">Prototype · /method hero · line + halftone · not live</p>

  <section class="mh">
    <div class="container-page mh-top">
      <p class="eyebrow">{p.hero.label}</p>
      <h1 class="mh-title">
        {p.hero.title.replace(" —", " —")} <span class="hl">{p.hero.titleHl}</span>
      </h1>
    </div>
    <div class="container-page mh-art">
      <MountainArt camps={camps} />
    </div>
    <div class="mh-body">
      <div class="container-page mh-split">
        <p class="mono mh-count">01 — 04</p>
        <div>
          <p class="mh-sub">{p.hero.sub}</p>
          <div class="mh-actions">
            <a href={t.links.discovery} class="btn-primary">{p.hero.cta}</a>
            <a href="/method/#phases" class="mh-link">{p.hero.secondary}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mh-variant">
    <p class="proto-note mono">Variant · navy ink (closer to the reference)</p>
    <MountainArt camps={camps} ink="#1f2a4d" />
  </section>
</BaseLayout>

<style>
  .proto-note {
    display: block;
    padding-top: 1rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .mh-top {
    display: grid;
    gap: 1.25rem;
    padding-top: 2.5rem;
  }
  @media (min-width: 1024px) {
    .mh-top {
      grid-template-columns: 39fr 61fr;
      align-items: end;
      padding-top: 3.5rem;
    }
  }
  .mh-title {
    font-size: clamp(2.75rem, 5.4vw, 5.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .mh-art {
    margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .mh-art {
      margin-top: 2.5rem;
    }
  }
  .mh-body {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: 1.75rem 2.25rem;
  }
  .mh-split {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 1024px) {
    .mh-split {
      grid-template-columns: 39fr 61fr;
    }
  }
  .mh-count {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .mh-sub {
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .mh-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .mh-link {
    font-size: 0.9375rem;
    border-bottom: 1px solid var(--color-ink);
  }
  .mh-variant {
    padding-block: 4rem 6rem;
  }
</style>
