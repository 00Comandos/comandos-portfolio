---
/*
 * /ds/ — internal design-system catalogue. NOT for visitors:
 *  - noindex,nofollow meta (BaseLayout → SEO), X-Robots-Tag header
 *    (vercel.json), excluded from the sitemap (astro.config.mjs);
 *  - never linked from the site (keep it out of nav/footer).
 * Every live render uses the real component with data lifted from the
 * case-study files (src/data/case-studies/*.ts) — no invented samples.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import Entry from "~/components/ds/Entry.astro";
import Variant from "~/components/ds/Variant.astro";
import { pick, layoutOf, checklistUsage, type BlockOf, type ChecklistResolved } from "~/components/ds/catalogue";
import themeCss from "~/styles/global.css?raw";

import Checklist from "~/components/case-study/Checklist.astro";
import Scene from "~/components/case-study/Scene.astro";
import CardStack from "~/components/case-study/CardStack.astro";
import BeforeAfterSlider from "~/components/case-study/BeforeAfterSlider.astro";
import CaptureSequence from "~/components/case-study/CaptureSequence.astro";
import ConciergeChat from "~/components/case-study/ConciergeChat.astro";
import BleedVideo from "~/components/case-study/BleedVideo.astro";
import ContentImage from "~/components/case-study/ContentImage.astro";
import FeatureGrid from "~/components/case-study/FeatureGrid.astro";
import TwoColMedia from "~/components/case-study/TwoColMedia.astro";
import ImageGrid from "~/components/case-study/ImageGrid.astro";
import Divider from "~/components/case-study/Divider.astro";
import SectionChip from "~/components/case-study/SectionChip.astro";
import StatIllustration from "~/components/case-study/StatIllustration.astro";
import AnimatedIcon from "~/components/case-study/AnimatedIcon.astro";
import Result from "~/components/case-study/Result.astro";
import PillarArt from "~/components/case-study/PillarArt.astro";
import ServicesPains from "~/components/services/ServicesPains.astro";
import AudienceArt from "~/components/services/AudienceArt.astro";
import PrincipleArt from "~/components/method/PrincipleArt.astro";
import PhaseVisual from "~/components/method/PhaseVisual.astro";
import FinalCTA from "~/components/home/FinalCTA.astro";

import { caseStudies, getCaseStudy } from "~/data/case-studies";
import type { IllustrationScene, PillarArtKind } from "~/data/case-studies/types";

export const prerender = true;

const cs = (slug: string) => {
  const c = getCaseStudy(slug);
  if (!c) throw new Error(`[ds] unknown case study ${slug}`);
  return c;
};
const kartaCard = cs("karta-card");
const kartaApp = cs("karta-app");
const legalario = cs("legalario-e-signature");

/* ---------- Foundations: tokens parsed from global.css @theme ---------- */
const themeBlock = themeCss.match(/@theme\s*\{([\s\S]*?)\n\}/)?.[1] ?? "";
const tokens = [...themeBlock.matchAll(/--([a-z]+)-([\w-]+):\s*([^;]+);/g)].map((m) => ({
  group: m[1],
  name: `--${m[1]}-${m[2]}`,
  value: m[3].replace(/\s+/g, " ").trim(),
}));
const colors = tokens.filter((t) => t.group === "color");
const radii = tokens.filter((t) => t.group === "radius");
const fonts = tokens.filter((t) => t.group === "font");
const shadows = tokens.filter((t) => t.group === "shadow");

const typeScale = [
  { name: "Case header H1 · .csh-title", where: "CaseStudyHeader.astro", style: "font-size: clamp(2.5rem, 4.6vw, 4.5rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.04;", sample: "Display headline" },
  { name: "Section H2 · .display-serif", where: "Adventure / Result / Challenge (clamp(2rem–2.25rem … 3–3.5rem))", style: "font-size: clamp(2.25rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1.04;", sample: "Section heading" },
  { name: "Block H3 · .display-serif", where: "Adventure / Worth headings, Scene title (2rem → 2.375rem md)", style: "font-size: 2.375rem; font-weight: 500; letter-spacing: -0.04em; line-height: 1.04;", sample: "Block heading" },
  { name: "Figure · .metric-fig / .ratio-num", where: "Checklist (300 weight, -0.05em)", style: "font-size: clamp(2.5rem, 4.5vw, 3.5rem); font-weight: 300; letter-spacing: -0.05em; line-height: 1;", sample: "69%" },
  { name: "Result number", where: "Result.astro (container-query sized)", style: "font-size: clamp(4.5rem, 9vw, 8rem); font-weight: 300; letter-spacing: -0.05em; line-height: 1;", sample: "+477" },
  { name: "Lead · intro body", where: "Challenge / header intro", style: "font-size: 1.0625rem; line-height: 1.55; letter-spacing: -0.01em;", sample: "Intro paragraph set at 17px with 1.55 leading for the case-study voice." },
  { name: "Prose body", where: "Adventure / Worth prose (max 42rem)", style: "font-size: 1rem; line-height: 1.7; color: var(--color-ink-soft);", sample: "Body copy at 16px, 1.7 leading, ink-soft. Max measure 42rem inside .cs-body." },
  { name: "Mono micro-label · .eyebrow", where: "global.css", style: "font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase;", sample: "Seeing the mountain" },
];

/* ---------- Checklist: real data for every branch ---------- */
const ck = (slug: string, pred: (b: BlockOf<"checklist">) => boolean) =>
  pick(cs(slug), "checklist", pred);
const ckResearch = ck("stori-inversion-plus", (b) => b.items.every((i) => (i.sub?.length ?? 0) > 0));
const ckQuotes = ck("legalario-e-signature", (b) => layoutOf(b) === "quotes");
const ckChart = ck("legalario-e-signature", (b) => layoutOf(b) === "chart");
const ckFlow = ck("karta-card", (b) => layoutOf(b) === "flow");
const ckCards = ck("karta-card", (b) => layoutOf(b) === "cards");
const ckMetric = ck("truora-report", (b) => b.items[0]?.label.startsWith("69%"));
const ckQuestions = ck("mipos-restaurant-pos", (b) => b.items[0]?.label === "Activation:");
const ckArt = ck("stadio-apple-watch", (b) => b.items.some((i) => i.art));
const ckLead = ck("truora-truconnect", (b) => b.items[0]?.label.startsWith("+20"));
const ckTitled = ck("yaydoo-design-system", (b) => b.items[0]?.label.startsWith("Detailed anatomy"));

const usage = checklistUsage(caseStudies);
// No case currently resolves to the plain list → a generic sample (5 rows, so not pillars).
const plainSample = [
  { label: "Label:", body: "Body continues as muted text." },
  { label: "A finding that stands alone." },
  { label: "Label:", body: "Body continues as muted text." },
  { label: "Another finding." },
  { label: "Label:", body: "Five or more rows are never pillars." },
];
const usageBy = (r: ChecklistResolved) => usage.filter((u) => u.resolved === r);
const resolvedOrder: ChecklistResolved[] = ["research-scene", "quotes", "flow", "chart", "rings", "cards", "pictogram", "metric", "pillars", "list"];

/* ---------- Other blocks (lifted from case data) ---------- */
const sceneImages = pick(kartaCard, "scene");
const cardStack = pick(kartaCard, "card-stack");
const compare = pick(legalario, "compare");
const capture = pick(legalario, "capture-sequence");
const concierge = pick(kartaApp, "concierge-chat");
const bleedVideo = pick(kartaCard, "bleed-video");
const bleedImage = pick(kartaApp, "bleed-image");
const featureGrid = pick(kartaApp, "feature-grid");
const twoCol = pick(kartaApp, "two-col-media");
const imageGrid = pick(kartaApp, "image-grid");

const chipVariants = ["challenge", "adventure", "worth", "result", "seeing-mountain", "making-top", "nps", "interview", "signature"] as const;
const scenes: IllustrationScene[] = [
  "launch", "rise", "retention", "multiply", "audience", "ink", "biometric", "certified", "progress", "documents",
  "signed-growth", "love", "reactivate", "sprint", "unify", "flow", "streak", "orbit", "sync", "whisper", "lap",
  "magnet", "summit", "anydevice", "renew", "simmer", "tap-pay", "refer", "parking", "activate", "wayfind",
];
const pillarKinds: PillarArtKind[] = ["ready", "race", "refer", "travel", "assistant", "liquidity", "conversation", "leads"];
const iconMotions = [
  { name: "lucide:sparkles", motion: "breathe" },
  { name: "lucide:gauge", motion: "rock" },
  { name: "lucide:message-circle", motion: "bounce" },
  { name: "lucide:scan-face", motion: "scan" },
  { name: "lucide:scan-face", motion: "none" },
] as const;

/* ---------- Index ---------- */
const index = [
  { id: "foundations", label: "Foundations", items: [["colour", "Colour"], ["type", "Type"], ["radii", "Radii & shadow"], ["signature", ".hl · .eyebrow · .mono"], ["buttons", "Buttons"], ["hairlines", "Hairlines & rhythm"]] },
  { id: "checklist", label: "Checklist", items: [["ck-rules", "Auto-layout rules"], ["ck-list", "Plain list"], ["ck-pillars", "Pillars"], ["ck-metric", "Metric rows"], ["ck-ratio", "Ratio · cards · rings"], ["ck-chart", "Chart"], ["ck-flow", "Flow"], ["ck-quotes", "Quotes"], ["ck-research", "Research → Scene"], ["ck-usage", "Where used"]] },
  { id: "blocks", label: "Case-study blocks", items: [["scene", "Scene"], ["cardstack", "CardStack"], ["compare", "BeforeAfterSlider"], ["capture", "CaptureSequence"], ["concierge", "ConciergeChat"], ["bleed", "BleedVideo · bleed-image"], ["featuregrid", "FeatureGrid"], ["twocol", "TwoColMedia"], ["imagegrid", "ImageGrid"], ["divider", "Divider"], ["chip", "SectionChip"], ["statillu", "StatIllustration"], ["animicon", "AnimatedIcon"], ["result", "Result"], ["header", "CaseStudyHeader hero"]] },
  { id: "iso", label: "Isometric drawings", items: [["pains", "ServicesPains"], ["audience", "AudienceArt"], ["principle", "PrincipleArt"], ["pillarart", "PillarArt"]] },
  { id: "building", label: "Building blocks", items: [["phase", "PhaseVisual"], ["finalcta", "FinalCTA (dark)"], ["contactform", "ContactForm"]] },
] as const;

/* ---------- Code snippets (kept as strings: no template escaping) ---------- */
const code = {
  ck: `import Checklist from "~/components/case-study/Checklist.astro";
// data: { kind: "checklist", items: ChecklistItem[], layout?: "cards" | "rings" | "chart" | "flow" | "quotes" }
type ChecklistItem = { label: string; body?: string; sub?: string[]; art?: PillarArtKind };
<Checklist items={items} layout={layout} />`,
  ckList: `items: [
  { label: "A finding that stands alone." },
  { label: "Label:", body: "Optional body after it." },   // ← bodies are optional
]`,
  ckPillars: `items: [                       // 2–4 rows, EVERY row has a body
  { label: "Activation:", body: "How do we …?" },
  { label: "Retention:",  body: "What do … need?" },     // all bodies end in "?" → large question setting
  { label: "Sales:",      body: "… the most profitable?", art: "race" },  // art → PillarArt drawing
]
// optional title row: first item has no body → mono title above
// …if that first label starts with a figure ("+20 pilots in …") → headline figure (pillars only)`,
  ckMetric: `items: [                       // ≥ 2 rows, every label STARTS with a figure
  { label: "69% less pages:", body: "…" },
  { label: "-37% support tickets:", body: "…" },
]`,
  ckRatio: `items: [                       // every label starts "N/D" (D ≤ 20 people)
  { label: "8/10 users associate metal cards with …" },
  { label: "10/10 users perceive that …" },
]
layout: undefined | "cards" | "rings"`,
  ckChart: `layout: "chart"
items: [ { label: "57% of users", body: "indicated that …" }, … ]   // all-% metrics
// …or ratio rows ("4/5 users …"). Sorted by value; "users …" / "of users …" prefix dropped.`,
  ckFlow: `layout: "flow"                  // ratio rows, > 1 row, ONE shared denominator
items: [
  { label: "4/5 users did not like the card", body: "…" },
  { label: "5/5 users compared with …", body: "…" },
]`,
  ckQuotes: `layout: "quotes"                // label + body read as one quote
items: [ { label: "I don't feel comfortable signing any documents." }, … ]`,
  ckResearch: `items: [                       // EVERY item has sub[] → pinned Scene, one beat per source
  { label: "NPS and Call Center", body: "Caption line:", sub: ["“Quote one”", "“Quote two”"] },
  …
]`,
  scene: `import Scene from "~/components/case-study/Scene.astro";
// Worth/Adventure: { kind: "scene", label?, heading?, body?, beats: SceneBeat[] }
type SceneBeat = {
  label: string;               // mono "Before" / "New"
  caption: string;             // the line that changes per beat
  media?: ContentImage | ContentVideo;   // omit + pass quotes for a typographic beat
  quotes?: string[];
  impact?: string;             // 1–2 word .hl pill next to the label ("↑477%")
};
<Scene label="…" heading="…" body="…" beats={beats} />   // max ONE per case`,
  cardStack: `{ kind: "card-stack", cards: [{ image: ContentImage /* kind "image" */, label: "First proposal", caption?: "…" }, …] }
<CardStack cards={cards} />`,
  compare: `{ kind: "compare", before: ContentImage, after: ContentImage, label?: "signed document" }  // same canvas size
<BeforeAfterSlider before={before} after={after} label="signed document" />`,
  capture: `{ kind: "capture-sequence", frames: [{ image: ContentImage, label: "Look at the camera" }, …] }
<CaptureSequence frames={frames} />`,
  concierge: `{ kind: "concierge-chat", heading: "… helps you with:", title: "… Concierge",
  channel?: "WhatsApp", backdrop?: ContentImage, items: string[] }   // last item (if > 2) = centred system pill
<ConciergeChat heading=… title=… channel=… backdrop=… items=… />`,
  bleed: `// Worth only — breaks out of the .cs-body column:
{ kind: "bleed-video", video: ContentVideo, line: "One overlaid line." }
{ kind: "bleed-image", image: ContentImage }      // closing image, no radius
<BleedVideo video={video} line="…" />`,
  featureGrid: `{ kind: "feature-grid", columns: 2 | 3, items: [
  { number: "1", label?: "Business", title: "…", body: "…", highlight?: true, art?: "travel" }, … ] }
<FeatureGrid columns={3} items={items} />`,
  twoCol: `{ kind: "two-col-media", items: [{ image: ContentImage, kicker?: "…", title: "…", detail?: "…" }, …] }
<TwoColMedia items={items} />`,
  imageGrid: `{ kind: "image-grid", columns: 2 | 3 | 4, images: ContentImage[] }
<ImageGrid columns={2} images={images} rounded? />`,
  divider: `{ kind: "divider", variant?: "hatched" | "line" }   // variant ignored: always a 1px hairline
<Divider />  <Divider tone="dark" />`,
  chip: `{ kind: "chip", icon: "seeing-mountain" | "making-top" | "nps" | "interview" | "signature" | "worth", label: "…" }
<SectionChip variant="seeing-mountain" label="Seeing the mountain" tone?="dark" />`,
  stat: `// Result stat icon / card scene, or Adventure "illustrated-heading" / "illustrated-groups"
{ kind: "illustration", scene: "rise" }      // StatIcon
{ kind: "illustrated-heading", scene?: "rise", icon?: "lucide:scan-face", still?: true, heading: "…", body?: "…" }
<div class="stat" data-in-view="false"><StatIllustration scene="rise" /></div>   // parent must flip data-in-view="true"`,
  icon: `<AnimatedIcon name="lucide:scan-face" size={40} motion="breathe" | "rock" | "bounce" | "scan" | "none" />
// sets: lucide, ph. Entrance needs an ancestor with data-in-view="true".`,
  result: `result: {
  heading: "…",
  stats: [{ value: "+477%", label: "…", caption?: "…", icon: StatIcon, chart?: ContentImage }],  // 2 → two cols, else three
  cards?: [{ heading: "…", body?: "…", image?: ContentImage, scene?: IllustrationScene }],
}
<Result content={caseStudy.result} />`,
  header: `hero: {
  image: ContentImage, intro: "…", bullets?: string[], mobileStack?: ContentImage[],
  backdrop?: {
    color: "rgb(19 212 124)",   // the image's own background colour → full-width band
    until?: 100,                // % of the image height the band reaches (rest sits on paper)
    align?: "center" | "end",   // "end": flush right/bottom (screens cropped on those sides)
    fade?: true,                // soft-fade cropped right/bottom edges into the band
    card?: true,                // complete screenshot as a centred card (padding + shadow)
  },
}`,
  pains: `<ServicesPains lang="en" />   // whole section, copy from ui[lang].servicesPage.pains`,
  audience: `<section data-glyphs> … <AudienceArt kind={1 | 2 | 3 | 4} /> … </section>
// light strokes for the ink band; rises in when the [data-glyphs] parent gets data-play`,
  principle: `<PrincipleArt kind={1 | 2 | 3 | 4} />   // 1 numbers · 2 no black box · 3 your stage · 4 extended`,
  pillarArt: `type PillarArtKind = "ready" | "race" | "refer" | "travel" | "assistant" | "liquidity" | "conversation" | "leads";
// used via ChecklistItem.art (pillars) or FeatureGridItem.art
<PillarArt kind="race" />`,
  phase: `<PhaseVisual phase={1 | 2 | 3 | 4} lang="en" label="Accessible description" />`,
  finalCta: `<FinalCTA lang="en" />            // tone="dark" default: runs into the black footer
<FinalCTA lang="en" tone="light" />`,
  contactForm: `<ContactForm lang="en" | "es" theme?="light" | "dark" />
// posts to /api/contact (?lang=es); reads ?status= / ?reason= / ?type= presets from the URL`,
};

const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout
  title="Design system (internal)"
  description="Internal design-system catalogue for comandos.me. Not for public use."
  noindex
>
  <div class="ds container-page">
    <header class="ds-hero">
      <p class="eyebrow ds-muted">Internal · noindex · not linked</p>
      <h1 class="display-serif ds-h1">Design <span class="hl">system</span></h1>
      <p class="ds-lead">
        Living catalogue of the comandos.me building blocks. Every render below is the real component fed with data from
        <code>src/data/case-studies/*.ts</code>, so what you see here is what ships. Each entry: name, file, when to use it, the data
        shape, then the live render and its variants.
      </p>
    </header>

    <div class="ds-shell">
      <aside class="ds-index" aria-label="Catalogue index">
        <nav>
          <ol>
            {
              index.map((s, si) => (
                <li>
                  <a href={`#${s.id}`} class="ds-index-sec mono">
                    {pad(si + 1)} {s.label}
                  </a>
                  <ul>
                    {s.items.map(([id, label]) => (
                      <li>
                        <a href={`#${id}`}>{label}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <div class="ds-main">
        <!-- ===================== 01 FOUNDATIONS ===================== -->
        <section class="ds-section" id="foundations" aria-labelledby="h-foundations">
          <h2 class="ds-h2" id="h-foundations"><span class="mono">01</span> Foundations</h2>

          <Entry
            id="colour"
            name="Colour tokens"
            path="src/styles/global.css · @theme"
            when="Paper + ink + cool greys; ONE teal accent used as a highlighter (pills, a single knob, the leading ribbon). Lime/sun/sky/crimson exist for rare data accents only."
            notes={["Parsed live from <code>@theme</code> — edit global.css and this grid follows. Use as <code>var(--color-ink)</code> or Tailwind <code>text-ink</code>, <code>bg-paper-soft</code>, <code>border-border</code>."]}
          >
            <ul class="ds-swatches">
              {
                colors.map((c) => (
                  <li class="ds-swatch">
                    <span class="ds-swatch-chip" style={`background: ${c.value.startsWith("var(") ? `var(${c.name})` : c.value};`} />
                    <span class="ds-swatch-name mono">{c.name.replace("--color-", "")}</span>
                    <span class="ds-swatch-val mono">{c.value}</span>
                  </li>
                ))
              }
            </ul>
          </Entry>

          <Entry
            id="type"
            name="Type scale"
            path="global.css · --font-sans / --font-mono · component styles"
            when="Geist for everything (500 headings, -0.03 to -0.04em tracking, balanced wrap); Geist Mono for labels, numerals, tags and meta. Large figures go thin (300)."
            notes={fonts.map((f) => `<code>${f.name}</code>: ${f.value}`)}
          >
            <ul class="ds-type">
              {
                typeScale.map((t) => (
                  <li>
                    <p class="ds-type-meta mono">
                      {t.name} <span>{t.where}</span>
                    </p>
                    <p style={t.style}>{t.sample}</p>
                  </li>
                ))
              }
            </ul>
          </Entry>

          <Entry
            id="radii"
            name="Radii & shadow"
            path="global.css · --radius-* · --shadow-card"
            when="Mostly square: media and cards use radius-xs (4px); rounded-xl only on rounded media blocks; full for pills and buttons. One soft card shadow."
          >
            <ul class="ds-radii">
              {
                radii.map((r) => (
                  <li>
                    <span class="ds-radius-box" style={`border-radius: var(${r.name});`} />
                    <span class="mono">{r.name.replace("--radius-", "")}</span>
                    <span class="mono ds-muted">{r.value}</span>
                  </li>
                ))
              }
              {
                shadows.map((s) => (
                  <li>
                    <span class="ds-radius-box ds-radius-box--shadow" style={`box-shadow: var(${s.name});`} />
                    <span class="mono">{s.name.replace("--", "")}</span>
                    <span class="mono ds-muted">card</span>
                  </li>
                ))
              }
            </ul>
          </Entry>

          <Entry
            id="signature"
            name=".hl · .eyebrow · .mono · .display-serif"
            path="src/styles/global.css · @layer components"
            when=".hl = the Comandos signature: 1–2 key words in a teal outlined pill (nowrap ≥640px; never more than one per heading). .eyebrow = mono uppercase section label. .mono = mono voice without the uppercase."
            code={`<h2 class="display-serif">Design that <span class="hl">compounds</span></h2>
<p class="eyebrow">Seeing the mountain</p>
<span class="mono">n = 10</span>`}
          >
            <div class="ds-variants">
              <Variant label=".hl on paper">
                <p class="display-serif ds-sample-h">Design that <span class="hl">compounds</span>.</p>
              </Variant>
              <Variant label=".hl on ink">
                <div class="ds-ink-box">
                  <p class="display-serif ds-sample-h">Let's build <span class="hl">together</span>.</p>
                </div>
              </Variant>
              <Variant label=".eyebrow / .mono">
                <p class="eyebrow">Seeing the mountain</p>
                <p class="mono ds-mt">n = 10 · 2021–2023 · 03</p>
              </Variant>
            </div>
          </Entry>

          <Entry
            id="buttons"
            name="Buttons"
            path="global.css (.btn-primary, .btn-outline, .btn-link) · Challenge.astro (.btn-dark-outline) · home/Services.astro (.btn-invert)"
            when="Compact pills with a leading dot that turns teal on hover; min-height 40px. Primary = the one action of a block; outline = secondary; link = inline."
            notes={[
              "<strong>Dark variants are component-scoped</strong>, not global: <code>.btn-dark-outline</code> lives in Challenge.astro and <code>.btn-invert</code> in home/Services.astro. The dark row below is a <em>replica</em> of their CSS so you can see them; to reuse them elsewhere, promote both to global.css first.",
            ]}
            code={`<a class="btn-primary" href="…">Book a discovery call</a>
<a class="btn-outline" href="…">See the work</a>
<a class="btn-link" href="…">All projects</a>`}
          >
            <div class="ds-variants">
              <Variant label="paper">
                <div class="ds-row">
                  <a class="btn-primary" href="#buttons">Primary</a>
                  <a class="btn-outline" href="#buttons">Outline</a>
                  <a class="btn-link" href="#buttons">Link</a>
                </div>
              </Variant>
              <Variant label="ink · replicas" note=".btn-dark-outline · .btn-invert">
                <div class="ds-ink-box ds-row">
                  <a class="ds-btn-invert" href="#buttons">Invert</a>
                  <a class="ds-btn-dark-outline" href="#buttons">Dark outline</a>
                  <a class="btn-primary" href="#buttons">Primary</a>
                </div>
              </Variant>
            </div>
          </Entry>

          <Entry
            id="hairlines"
            name="Hairlines, dividers & rhythm"
            path="global.css (.hairline-t / .hairline-b) · Divider.astro · .cs-body / .container-page"
