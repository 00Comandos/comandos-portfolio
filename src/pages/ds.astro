<script>
  // StatIllustration / AnimatedIcon entrance: flip data-in-view like
  // Adventure.astro does on case pages.
  const els = document.querySelectorAll<HTMLElement>("[data-ds-stat]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).setAttribute("data-in-view", "true");
          io.unobserve(e.target);
        }),
      { threshold: 0.3 },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.setAttribute("data-in-view", "true"));
  }
  // Belt and braces: nothing inside the catalogue's inert demo can submit.
  document.addEventListener(
    "submit",
    (e) => {
      if ((e.target as HTMLElement).closest(".ds-inert")) e.preventDefault();
    },
    true,
  );
</script>

