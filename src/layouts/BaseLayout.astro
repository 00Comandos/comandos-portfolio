---
import "~/styles/global.css";
import Header from "~/components/layout/Header.astro";
import Footer from "~/components/layout/Footer.astro";
import SEO from "~/components/layout/SEO.astro";
import { site } from "~/lib/site";
import { getLang, ui } from "~/i18n";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** hreflang alternates — pass only for pages that exist in both languages. */
  alternates?: { en: string; es: string };
};

const props = Astro.props;
const lang = getLang(Astro.url);
const t = ui[lang];
const gaId = import.meta.env.PUBLIC_GA_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION;

const defaultJsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: site.person.name,
    alternateName: site.person.alternateName,
    jobTitle: site.person.jobTitle,
    url: `${site.url}/`,
    sameAs: [site.social.linkedin, site.social.x],
    description: site.description,
    knowsAbout: [
      "Product design",
      "Product strategy",
      "UX research",
      "Design systems",
      "FinTech product design",
      "SaaS product design",
      "AI product design",
      "LATAM product design",
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Mexico City",
      addressCountry: "MX",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${site.url}/#organization`,
    name: site.name,
    url: `${site.url}/`,
    logo: new URL("/images/Logo-Comandos.svg", site.url).toString(),
    sameAs: [site.social.linkedin, site.social.x],
    description: site.description,
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "c@comandos.me",
      areaServed: ["MX", "LATAM"],
      availableLanguage: ["en", "es"],
    },
    founder: { "@id": `${site.url}/#person` },
  },
];
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap"
    />
    <SEO {...props} jsonLd={props.jsonLd ?? defaultJsonLd} />
    <slot name="head" />
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-black focus:text-white focus:px-3 focus:py-2 focus:rounded"
    >
      {t.meta.skip}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
