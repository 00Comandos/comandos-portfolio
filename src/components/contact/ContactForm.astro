---
import type { Lang } from "~/i18n";
import { contactCopy } from "~/i18n/contact";
import {
  PROJECT_TYPES,
  PROJECT_TYPE_PRESETS,
  REFERRAL_SOURCES,
} from "~/lib/contact";

type Props = { lang: Lang; theme?: "light" | "dark" };
const { lang, theme = "light" } = Astro.props;
const t = contactCopy[lang];

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const params = new URL(Astro.request.url).searchParams;
const status = params.get("status");
const reason = params.get("reason");
const presetType = PROJECT_TYPE_PRESETS[params.get("type") ?? ""];

// Client validation copy travels as JSON — the bundled script reads it.
const clientCopy = JSON.stringify(t.errors);
const action = lang === "es" ? "/api/contact?lang=es" : "/api/contact";
---

{
  status === "success" && (
    <div role="status" class="cf-banner">
      <strong>
        <span class="hl">{t.status.successTitle}</span>
      </strong>
      <span>{t.status.successBody}</span>
    </div>
  )
}
{
  status === "error" && (
    <div role="alert" class="cf-banner cf-banner--error">
      <strong>{t.status.errorTitle}</strong>
      <span>{reason === "captcha" ? t.status.captchaBody : t.status.errorBody}</span>
    </div>
  )
}

<form
  method="POST"
  action={action}
  novalidate
  class="cf"
  data-contact-form
  data-copy={clientCopy}
>
  <fieldset class="cf-field cf-chips-field" data-group="projectType" data-multi>
    <legend class="cf-label">{t.form.projectType}</legend>
    {/* Multi-select. Desktop: chips always visible. Phones: collapsed into a
        dropdown (summary shows what's picked) so the form stays short. */}
    <details class="cf-pick" open data-pick>
      <summary class="cf-pick-summary">
        <span data-pick-label data-empty={lang === "es" ? "Elige una o más…" : "Choose one or more…"}>
          {presetType ? t.projectTypeLabels[presetType] : lang === "es" ? "Elige una o más…" : "Choose one or more…"}
        </span>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </summary>
      <div class="cf-chips">
        {
          PROJECT_TYPES.map((value) => (
            <label class="cf-chip">
              <input
                type="checkbox"
                name="projectType"
                value={value}
                data-label={t.projectTypeLabels[value]}
                checked={value === presetType}
                aria-describedby="projectType-error"
              />
              <span>{t.projectTypeLabels[value]}</span>
            </label>
          ))
        }
      </div>
    </details>
    <span id="projectType-error" data-error class="cf-error" hidden></span>
  </fieldset>

  <div class="cf-row">
    <div class="cf-field">
      <label class="cf-label" for="name">{t.form.name}</label>
      <input
        class="cf-input"
        id="name"
        name="name"
        type="text"
        required
        minlength="2"
        maxlength="120"
        autocomplete="name"
        aria-describedby="name-error"
      />
      <span id="name-error" data-error class="cf-error" hidden></span>
    </div>

    <div class="cf-field">
      <label class="cf-label" for="email">{t.form.email}</label>
      <input
        class="cf-input"
        id="email"
        name="email"
        type="email"
        required
        maxlength="200"
        autocomplete="email"
        aria-describedby="email-error"
      />
      <span id="email-error" data-error class="cf-error" hidden></span>
    </div>
  </div>

  <div class="cf-row">
    <div class="cf-field">
      <label class="cf-label" for="whatsapp">{t.form.whatsapp}</label>
      <input
        class="cf-input"
        id="whatsapp"
        name="whatsapp"
        type="tel"
        required
        maxlength="24"
        inputmode="tel"
        autocomplete="tel"
        placeholder="+52 55 1234 5678"
        aria-describedby="whatsapp-hint whatsapp-error"
      />
      <span id="whatsapp-hint" class="cf-hint">{t.form.whatsappHint}</span>
      <span id="whatsapp-error" data-error class="cf-error" hidden></span>
    </div>

    <div class="cf-field">
      <label class="cf-label" for="company">{t.form.company}</label>
      <input
        class="cf-input"
        id="company"
        name="company"
        type="text"
        required
        minlength="2"
        maxlength="200"
        autocomplete="organization"
        aria-describedby="company-error"
      />
      <span id="company-error" data-error class="cf-error" hidden></span>
    </div>
  </div>

  <div class="cf-field">
    <label class="cf-label" for="referralSource">{t.form.referralSource}</label>
    <div class="cf-select-wrap">
      <select
        class="cf-input cf-select"
        id="referralSource"
        name="referralSource"
        required
        aria-describedby="referralSource-error"
      >
        <option value="">{t.form.referralPlaceholder}</option>
        {
          REFERRAL_SOURCES.map((value) => (
            <option value={value}>{t.referralLabels[value]}</option>
          ))
        }
      </select>
    </div>
    <span id="referralSource-error" data-error class="cf-error" hidden></span>
  </div>

  <div class="cf-field">
    <label class="cf-label" for="message">{t.form.message}</label>
    <textarea
      class="cf-input cf-textarea"
      id="message"
      name="message"
      required
      minlength="10"
      maxlength="4000"
      rows="4"
      placeholder={t.form.messagePlaceholder}
      aria-describedby="message-error"></textarea>
    <span id="message-error" data-error class="cf-error" hidden></span>
  </div>

  <div aria-hidden="true" class="hidden">
    <label>
      {t.form.honeypot}
      <input name="website" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="cf-footer">
    {
      turnstileKey && (
        <>
          <div
            class="cf-turnstile"
            data-sitekey={turnstileKey}
            data-theme={theme}
            data-language={lang}
          />
          <script
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          />
        </>
      )
    }
    <button type="submit" class="btn-primary cf-submit" data-submit>
      {t.form.submit}
    </button>
  </div>
</form>

<script>
  type FieldEl = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  type Copy = {
    required: Record<string, string>;
    requiredFallback: string;
    email: string;
    tooShort: string;
    tooLong: string;
    pattern: string;
    generic: string;
    whatsappPlus: string;
    whatsappChars: string;
    whatsappLength: string;
  };

  /** One validated control per field name — a radio group counts once. */
  type Control = {
    name: string;
    /** Element whose validity we read (any radio of a group works). */
    el: FieldEl;
    /** Elements that carry aria-invalid. */
    targets: FieldEl[];
    /** Wrapper flagged with data-invalid for styling. */
    wrap: HTMLElement | null;
    errEl: HTMLElement | null;
    focus: () => void;
  };

  function fill(tpl: string, vars: Record<string, string | number>): string {
    return tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ""));
  }

  function messageFor(c: Control, copy: Copy): string {
    const field = c.el;
    const v = field.validity;
    if (v.valueMissing) return copy.required[c.name] ?? copy.requiredFallback;
    if (v.customError) return field.validationMessage;
    if (v.typeMismatch && field.type === "email") return copy.email;
    if (v.tooShort && "minLength" in field)
      return fill(copy.tooShort, {
        min: field.minLength,
        count: field.value.trim().length,
      });
    if (v.tooLong && "maxLength" in field)
      return fill(copy.tooLong, { max: field.maxLength });
    if (v.patternMismatch) return copy.pattern;
    return copy.generic;
  }

  function setError(c: Control, msg: string | null) {
    if (msg) {
      c.wrap?.setAttribute("data-invalid", "");
      c.targets.forEach((t) => t.setAttribute("aria-invalid", "true"));
      if (c.errEl) {
        c.errEl.textContent = msg;
        c.errEl.hidden = false;
      }
    } else {
      c.wrap?.removeAttribute("data-invalid");
      c.targets.forEach((t) => t.removeAttribute("aria-invalid"));
      if (c.errEl) {
        c.errEl.textContent = "";
        c.errEl.hidden = true;
      }
    }
  }

  function init() {
    const form = document.querySelector<HTMLFormElement>(
      "form[data-contact-form]",
    );
    if (!form) return;
    const copy = JSON.parse(form.dataset.copy ?? "{}") as Copy;

    // Build one control per field name, in DOM order.
    const controls: Control[] = [];
    const seen = new Set<string>();
    form
      .querySelectorAll<FieldEl>(
        "input[required], select[required], textarea[required]",
      )
      .forEach((el) => {
        if (seen.has(el.name)) return;
        seen.add(el.name);
        const isRadio = el instanceof HTMLInputElement && el.type === "radio";
        const group = isRadio
          ? Array.from(
              form.querySelectorAll<HTMLInputElement>(
                `input[type="radio"][name="${el.name}"]`,
              ),
            )
          : [el];
        controls.push({
          name: el.name,
          el,
          targets: group,
          wrap: isRadio
            ? el.closest<HTMLElement>("fieldset")
            : el.closest<HTMLElement>(".cf-field"),
          errEl: document.getElementById(`${el.name}-error`),
          focus: () =>
            (group.find((r) => (r as HTMLInputElement).checked) ?? group[0]).focus(),
        });
      });

    // Multi-select chip group: valid when at least one box is ticked. The
    // first box carries the custom validity so the generic flow works.
    form.querySelectorAll<HTMLFieldSetElement>("fieldset[data-multi]").forEach((fs) => {
      const boxes = Array.from(fs.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      if (!boxes.length) return;
      const name = boxes[0].name;
      const msg = copy.required[name] ?? copy.requiredFallback;
      const label = fs.querySelector<HTMLElement>("[data-pick-label]");
      const sync = () => {
        const picked = boxes.filter((b) => b.checked);
        boxes[0].setCustomValidity(picked.length ? "" : msg);
        if (label) label.textContent = picked.length ? picked.map((b) => b.dataset.label).join(", ") : label.dataset.empty ?? "";
        label?.toggleAttribute("data-filled", picked.length > 0);
      };
      boxes.forEach((b) => b.addEventListener("change", sync));
      sync();
      controls.unshift({
        name,
        el: boxes[0],
        targets: boxes,
        wrap: fs,
        errEl: document.getElementById(`${name}-error`),
        focus: () => {
          const d = fs.querySelector("details");
          if (d) d.open = true;
          boxes[0].focus();
        },
      });
      // Collapse into a dropdown on phones; always open from 768px up.
      const det = fs.querySelector<HTMLDetailsElement>("[data-pick]");
      if (det) {
        const mq = window.matchMedia("(min-width: 768px)");
        const apply = () => {
          det.open = mq.matches || false;
          det.toggleAttribute("data-static", mq.matches);
        };
        mq.addEventListener("change", apply);
        apply();
      }
    });

    // WhatsApp: E.164-style check — must start with a country code (+),
    // 7–15 digits, separators allowed. Registered before the generic
    // listeners so validity is fresh when they read it.
    const whatsapp = form.querySelector<HTMLInputElement>("#whatsapp");
    if (whatsapp) {
      const validateWhatsapp = () => {
        const v = whatsapp.value.trim();
        const digits = v.replace(/\D/g, "");
        if (!v) whatsapp.setCustomValidity("");
        else if (!v.startsWith("+"))
          whatsapp.setCustomValidity(copy.whatsappPlus);
        else if (!/^\+[0-9\s().-]+$/.test(v))
          whatsapp.setCustomValidity(copy.whatsappChars);
        else if (digits.length < 7 || digits.length > 15)
          whatsapp.setCustomValidity(copy.whatsappLength);
        else whatsapp.setCustomValidity("");
      };
      whatsapp.addEventListener("input", validateWhatsapp);
      whatsapp.addEventListener("blur", validateWhatsapp);
      validateWhatsapp();
    }

    const check = (c: Control) =>
      setError(c, c.el.validity.valid ? null : messageFor(c, copy));

    controls.forEach((c) => {
      const touched = () => c.wrap?.dataset.touched === "true";
      c.targets.forEach((t) => {
        t.addEventListener("input", () => {
          if (touched()) check(c);
        });
        t.addEventListener("change", () => {
          // Picking a chip / option is a deliberate answer — validate now.
          if (c.wrap) c.wrap.dataset.touched = "true";
          check(c);
        });
      });
      // Text fields validate on blur; radio groups only once the focus
      // leaves the whole group (arrowing between chips isn't a blur).
      c.wrap?.addEventListener("focusout", (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (next && c.wrap!.contains(next)) return;
        c.wrap!.dataset.touched = "true";
        check(c);
      });
    });

    // Submit stays enabled: an attempt paints every error and focuses the
    // first invalid field (a disabled button explains nothing).
    form.addEventListener("submit", (e) => {
      const firstInvalid = controls.find((c) => !c.el.validity.valid);
      if (!firstInvalid) return;
      e.preventDefault();
      controls.forEach((c) => {
        if (c.wrap) c.wrap.dataset.touched = "true";
        check(c);
      });
      firstInvalid.focus();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  .cf {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 640px) {
    .cf {
      gap: 2.25rem;
    }
  }

  .cf-field {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .cf-row {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 640px) {
    .cf-row {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .cf-label {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    padding: 0;
  }

  /* Underline-only inputs (Tubik). */
  .cf-input {
    width: 100%;
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    padding: 0.45rem 0 0.7rem;
    font: inherit;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }
  .cf-input::placeholder {
    color: var(--color-muted-soft);
  }
  .cf-input:hover {
    border-bottom-color: var(--color-muted-soft);
  }
  .cf-input:focus,
  .cf-input:focus-visible {
    outline: none;
    border-bottom-color: var(--color-ink);
    box-shadow: 0 1px 0 0 var(--color-ink);
  }
  .cf-field[data-invalid] .cf-input {
    border-bottom-color: var(--color-accent-crimson);
  }
  .cf-field[data-invalid] .cf-input:focus {
    box-shadow: 0 1px 0 0 var(--color-accent-crimson);
  }

  .cf-textarea {
    min-height: 7.5rem;
    resize: vertical;
    line-height: 1.5;
  }

  .cf-select-wrap {
    position: relative;
  }
  .cf-select {
    padding-right: 2rem;
    cursor: pointer;
  }
  .cf-select:invalid {
    color: var(--color-muted);
  }
  .cf-select-wrap::after {
    content: "";
    position: absolute;
    right: 0.3rem;
    top: 45%;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--color-ink);
    border-bottom: 1.5px solid var(--color-ink);
    transform: translateY(-50%) rotate(45deg);
    pointer-events: none;
  }

  .cf-hint {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .cf-error {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-accent-crimson);
  }
  .cf-error[hidden] {
    display: none;
  }

  /* Multi-select wrapper: a dropdown on phones, invisible on desktop. */
  .cf-pick-summary {
    display: none;
  }
  .cf-pick:not([data-static]) > .cf-pick-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1rem;
    color: var(--color-muted-soft);
    cursor: pointer;
    list-style: none;
  }
  .cf-pick-summary::-webkit-details-marker {
    display: none;
  }
  .cf-pick-summary [data-filled] {
    color: var(--color-ink);
  }
  .cf-pick-summary span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cf-pick-summary svg {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-ink);
    transition: transform 0.2s ease;
  }
  .cf-pick[open] .cf-pick-summary svg {
    transform: rotate(180deg);
  }
  .cf-pick:not([data-static])[open] .cf-chips {
    padding-top: 0.85rem;
  }

  /* Selectable pill chips (Tubik) — real checkboxes, visually hidden. */
  .cf-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .cf-chips-field .cf-label {
    margin-bottom: 0.5rem;
  }
  .cf-chip {
    position: relative;
    display: inline-flex;
  }
  .cf-chip input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .cf-chip span {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-full);
    background: var(--color-grey);
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    border: 1px solid transparent;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
    pointer-events: none;
  }
  .cf-chip:hover span {
    background: var(--color-border);
  }
  .cf-chip input:checked + span {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .cf-chip input:focus-visible + span {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .cf-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .cf-submit {
    margin-left: auto;
    padding: 0.8rem 1.6rem 0.8rem 1.4rem;
    font-size: 1rem;
    cursor: pointer;
  }

  /* Server-round-trip status banners. */
  .cf-banner {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .cf-banner strong {
    font-weight: 500;
    font-size: 1.0625rem;
  }
  .cf-banner--error {
    border-color: var(--color-accent-crimson);
  }
</style>
