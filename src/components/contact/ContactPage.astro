---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContactForm from "~/components/contact/ContactForm.astro";
import type { Lang } from "~/i18n";
import { contactCopy } from "~/i18n/contact";
import { site } from "~/lib/site";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = contactCopy[lang];

const EMAIL = "c@comandos.me";
const path = lang === "es" ? "/es/contact/" : "/contact/";
const home = lang === "es" ? `${site.url}/es/` : site.url;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: `${t.meta.title} — Comandos`,
    url: `${site.url}${path}`,
    inLanguage: lang,
    description: t.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t.meta.breadcrumbHome, item: home },
      {
        "@type": "ListItem",
        position: 2,
        name: t.meta.breadcrumb,
        item: `${site.url}${path}`,
      },
    ],
  },
];

const socials = [
  { label: "LinkedIn", href: site.social.linkedin },
  { label: "X", href: site.social.x },
];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
  alternates={{ en: "/contact/", es: "/es/contact/" }}
>
  <section class="container-page contact">
    <!-- DOM order = mobile order: headline → form → bullets/email. -->
    <header class="contact-intro">
      <h1 class="contact-title">
        {t.intro.title} <span class="hl">{t.intro.titleEm}</span>
      </h1>
      <p class="contact-sub">{t.intro.sub}</p>
    </header>

    <div class="contact-form">
      <ContactForm lang={lang} />
    </div>

    <aside class="contact-aside">
      <ul class="contact-bullets">
        {
          t.bullets.map((b) => (
            <li>
              <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path
                  d="M2 2l8 8M10 3.5V10H3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                />
              </svg>
              {b}
            </li>
          ))
        }
      </ul>

      <dl class="contact-direct">
        <div>
          <dt>{t.direct.label}</dt>
          <dd>
            <a href={`mailto:${EMAIL}`} class="contact-link">{EMAIL}</a>
            <button
              type="button"
              class="contact-copy"
              data-copy-email={EMAIL}
              data-label={t.direct.copy}
              data-done={t.direct.copied}
            >
              {t.direct.copy}
            </button>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
          </dd>
        </div>
        <div>
          <dt>{t.direct.follow}</dt>
          <dd>
            {
              socials.map((s) => (
                <a href={s.href} class="contact-link" target="_blank" rel="noopener">
                  {s.label}
                </a>
              ))
            }
          </dd>
        </div>
      </dl>
    </aside>
  </section>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
    .forEach((btn) => {
      const status = btn.parentElement?.querySelector<HTMLElement>(
        "[data-copy-status]",
      );
      let timer: number | undefined;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copyEmail ?? "");
        } catch {
          return;
        }
        btn.textContent = btn.dataset.done ?? "";
        if (status) status.textContent = btn.dataset.done ?? "";
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = btn.dataset.label ?? "";
          if (status) status.textContent = "";
        }, 1800);
      });
    });
</script>

<style>
  .contact {
    display: grid;
    grid-template-areas:
      "intro"
      "form"
      "aside";
    row-gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  .contact-intro {
    grid-area: intro;
  }
  .contact-form {
    grid-area: form;
  }
  .contact-aside {
    grid-area: aside;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "intro form"
        "aside form";
      column-gap: 0;
      row-gap: 3rem;
      padding-top: 5.5rem;
      padding-bottom: 8rem;
    }
    .contact-intro,
    .contact-aside {
      padding-right: clamp(2.5rem, 5vw, 5rem);
    }
    .contact-aside {
      border-top: 0;
      padding-top: 0;
    }
    /* Hairline between the two columns. */
    .contact-form {
      border-left: 1px solid var(--color-border);
      padding-left: clamp(2.5rem, 5vw, 5rem);
      padding-top: 0.6rem;
    }
  }

  .contact-title {
    font-size: clamp(2.5rem, 4.4vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.08;
    color: var(--color-ink);
    max-width: 12em;
  }
  .contact-title .hl {
    padding-block: 0.02em;
  }
  .contact-sub {
    margin-top: 1.75rem;
    max-width: 28rem;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .contact-bullets {
    display: grid;
    gap: 0.85rem;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .contact-bullets li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .contact-bullets svg {
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
    color: var(--color-muted);
    transform: translateY(0.05em);
  }

  .contact-direct {
    margin-top: 2.75rem;
    display: grid;
    gap: 1.1rem;
    font-size: 0.9375rem;
  }
  .contact-direct > div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .contact-direct dt {
    color: var(--color-muted);
  }
  .contact-direct dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.1rem;
    margin: 0;
  }
  .contact-link {
    color: var(--color-ink);
    font-weight: 500;
    padding-bottom: 1px;
    border-bottom: 1px solid var(--color-ink);
    transition: border-color 0.2s ease;
  }
  .contact-link:hover {
    border-bottom-color: var(--color-accent);
  }
  .contact-copy {
    font: inherit;
    font-size: 0.875rem;
    color: var(--color-muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .contact-copy:hover {
    color: var(--color-ink);
  }
</style>
