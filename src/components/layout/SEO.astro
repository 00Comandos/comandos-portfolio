---
import { site } from "~/lib/site";
import { getLang, ui, isEsMirror, basePath } from "~/i18n";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  alternates?: { en: string; es: string };
};

const {
  title,
  description = site.description,
  canonical,
  image = "/og-default.png",
  imageAlt,
  noindex = false,
  type = "website",
  jsonLd,
  alternates,
} = Astro.props;

const lang = getLang(Astro.url);
const ogLocale = ui[lang].meta.ogLocale;
const ogLocaleAlt = ui[lang === "en" ? "es" : "en"].meta.ogLocale;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
// Untranslated ES mirrors point search engines at the English original.
const mirror = isEsMirror(Astro.url.pathname);
const url = mirror
  ? new URL(basePath(Astro.url.pathname), site.url).toString()
  : (canonical ?? new URL(Astro.url.pathname, site.url).toString());
const ogImage = new URL(image, site.url).toString();
const ogImageAlt =
  imageAlt ??
  `${site.name} — ${title ?? site.tagline}. Product design case studies by Carlos Comandos across FinTech, SaaS and AI.`;
const jsonLdArray = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

const twitterHandle = "@01Comandos";
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.person.name} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && mirror && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={ogLocale} />
{alternates && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
{
  alternates && (
    <>
      <link rel="alternate" hreflang="en" href={new URL(alternates.en, site.url).toString()} />
      <link rel="alternate" hreflang="es" href={new URL(alternates.es, site.url).toString()} />
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site.url).toString()} />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:creator" content={twitterHandle} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{
  jsonLdArray.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))
}
