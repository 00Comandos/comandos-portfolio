---
import Logo from "~/components/ui/Logo.astro";
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import { site } from "~/lib/site";

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const menuItems = [
  ...site.nav,
  { label: "North Face Growth", href: "/north-face-growth" },
];
---

<header class="site-header">
  <div class="container-page flex items-center justify-between h-20">
    <a href="/" class="flex items-center" aria-label={`${site.name} — Home`}>
      <Logo height={32} />
    </a>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn-primary hidden sm:inline-flex">
        Contact Us
        <span class="arrow"><ArrowIcon /></span>
      </a>

      <button
        type="button"
        id="menuToggle"
        aria-expanded="false"
        aria-controls="primaryMenu"
        aria-label="Open menu"
        class="menu-btn"
      >
        <span class="menu-btn-bar"></span>
        <span class="menu-btn-bar"></span>
      </button>
    </div>
  </div>

  <nav
    id="primaryMenu"
    aria-label="Primary"
    class="menu-panel"
    data-open="false"
  >
    <ul class="container-page py-8 md:py-10 grid gap-2">
      {
        menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "menu-link",
                isActive(item.href) ? "is-active" : "",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              <span>{item.label}</span>
              <svg
                class="menu-chevron"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </a>
          </li>
        ))
      }
      <li class="sm:hidden mt-3">
        <a href="/contact" class="btn-primary w-full justify-center">
          Contact Us
          <span class="arrow"><ArrowIcon /></span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: transparent;
    transition:
      background-color 0.2s ease,
      backdrop-filter 0.2s ease;
  }
  .site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-paper) 85%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
  }

  /* Over the home hero reel (all viewports): fully transparent bar with
     the logo and burger inverted to white until the user scrolls. When
     the menu takeover is open, revert to ink over the paper panel. */
  .site-header.has-hero:not(.is-scrolled) {
    background-color: transparent;
    border-bottom-color: transparent;
  }
  .site-header.has-hero:not(.is-scrolled) a > :global(img) {
    filter: invert(1) brightness(1.6);
    transition: filter 0.2s ease;
  }
  .site-header.has-hero:not(.is-scrolled) .menu-btn-bar {
    background-color: #fff;
  }
  /* Menu open: the X must read over the paper panel (all widths); the
     logo reverts to ink only on mobile, where the panel covers it —
     on desktop the drawer leaves the logo over the video. */
  .site-header.has-hero:has(.menu-panel[data-open="true"]) .menu-btn-bar {
    background-color: var(--color-ink);
  }
  @media (max-width: 767px) {
    .site-header.has-hero:has(.menu-panel[data-open="true"]) a > :global(img) {
      filter: none;
    }
  }
  @media (max-width: 767px) {
    .site-header {
      border-bottom: 1px solid var(--color-border);
    }
  }

  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .menu-btn-bar {
    display: block;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 2px;
    width: 100%;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      width 0.25s ease;
  }
  .menu-btn[aria-expanded="true"] .menu-btn-bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .menu-btn-bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    position: fixed;
    z-index: -1;
    background-color: var(--color-paper);
    overflow-y: auto;
    visibility: hidden;
    pointer-events: none;
  }
  .menu-panel[data-open="true"] {
    visibility: visible;
    pointer-events: auto;
  }

  /* Shared takeover rows — reference typography: ~20px medium weight,
     airy rhythm, always-visible chevrons, no dividers. */
  .menu-panel ul {
    gap: 0;
    padding-block: 0;
  }
  .menu-panel .menu-link {
    border-bottom: none;
    padding: 1.5rem 0;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .menu-panel .menu-link :global(svg) {
    opacity: 1;
    transform: none;
    width: 18px;
    height: 18px;
    color: var(--color-ink);
  }
  .menu-panel .menu-link.is-active > span {
    text-decoration: none;
  }
  .menu-panel .mt-3 {
    margin-top: 3rem;
  }

  /* Mobile: full-screen takeover. Negative z-index keeps the overlay
     under the header row inside the header's stacking context, so the
     logo and the X stay on top. */
  @media (max-width: 767px) {
    .menu-panel {
      inset: 0;
      height: 100dvh;
      padding-top: 7.5rem;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.25s ease,
        transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0.25s;
    }
    .menu-panel[data-open="true"] {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop: right-side drawer with the same rows — slides in over a
     dimmed backdrop (spread shadow), mobile-like proportions. */
  @media (min-width: 768px) {
    .menu-panel {
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: min(420px, 90vw);
      height: 100dvh;
      padding-top: 7.5rem;
      transform: translateX(100%);
      transition:
        transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.4s ease,
        visibility 0.4s;
    }
    .menu-panel[data-open="true"] {
      transform: translateX(0);
      box-shadow:
        0 0 0 100vmax rgb(0 0 0 / 0.35),
        -32px 0 64px rgb(0 0 0 / 0.18);
    }
    .menu-panel ul {
      padding-inline: 2.5rem;
    }
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-border);
  }
  .menu-link :global(svg) {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }
  .menu-link:hover :global(svg),
  .menu-link:focus-visible :global(svg),
  .menu-link.is-active :global(svg) {
    opacity: 1;
    transform: translateX(0);
  }
  .menu-link.is-active > span {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-ink);
    text-underline-offset: 4px;
  }

  @media (min-width: 640px) {
    .menu-link {
      font-size: 2.5rem;
    }
  }
</style>

<script>
  // Toggle solid paper background once the user scrolls past the hero —
  // transparent at the top so the hero's cream bg shows through, tinted
  // paper after so content sliding underneath stays readable.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    if (document.querySelector("[data-hero-overlap]"))
      header.classList.add("has-hero");
    const onScroll = () => {
      if (window.scrollY > 32) header.classList.add("is-scrolled");
      else header.classList.remove("is-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const toggle = document.getElementById("menuToggle");
  const panel = document.getElementById("primaryMenu");
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.setAttribute("data-open", open ? "true" : "false");
      document.body.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!open);
    });
    panel.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
