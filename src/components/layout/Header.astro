---
import Logo from "~/components/ui/Logo.astro";
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import { site } from "~/lib/site";
import { alternatePath, getLang, localizedPath, ui } from "~/i18n";

const lang = getLang(Astro.url);
const t = ui[lang];
const pathname = Astro.url.pathname;
const L = (href: string) => localizedPath(href, lang);

const isActive = (href: string) =>
  !href.includes("#") && href !== "/" && pathname.startsWith(href);

// Services has its own page (EN + ES); Studio still anchors to the home
// section until its dedicated page ships.
const menuItems = [
  { label: t.nav.work, href: "/projects/" },
  { label: t.nav.services, href: L("/services/") },
  { label: t.nav.method, href: L("/method/") },
  { label: t.nav.studio, href: L("/#studio") },
];

const otherLang = lang === "en" ? "es" : "en";
const switchHref = alternatePath(pathname, otherLang);
---

<header class="site-header">
  <div class="container-page flex items-center justify-between h-[5.5rem]">
    <a href={L("/")} class="flex items-center py-2" aria-label={`${site.name} — Home`}>
      <Logo height={30} />
    </a>


    <div class="flex items-center gap-3 lg:gap-0">
      <nav class="nav-inline" aria-label="Primary">
        <ul>
          {
            menuItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["nav-inline-link", isActive(item.href) && "is-active"]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a
        href={switchHref}
        class="lang-switch"
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t.nav.langSwitch}
        title={t.nav.langSwitch}
      >
        <span class:list={[lang === "en" && "is-current"]}>EN</span>
        <span aria-hidden="true">/</span>
        <span class:list={[lang === "es" && "is-current"]}>ES</span>
      </a>

      <a href={t.links.discovery} class="btn-primary header-cta hidden sm:inline-flex">
        {t.nav.cta}
        <span class="arrow"><ArrowIcon /></span>
      </a>

      <button
        type="button"
        id="menuToggle"
        aria-expanded="false"
        aria-controls="primaryMenu"
        aria-label={t.nav.menuOpen}
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
        class="menu-btn"
      >
        <span class="menu-btn-bar"></span>
        <span class="menu-btn-bar"></span>
      </button>
    </div>
  </div>

  <nav
    id="primaryMenu"
    aria-label="Primary (menu)"
    class="menu-panel"
    data-open="false"
  >
    <ul class="container-page py-8 md:py-10 grid gap-2">
      {
        menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "menu-link",
                isActive(item.href) ? "is-active" : "",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              <span>{item.label}</span>
              <svg
                class="menu-chevron"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </a>
          </li>
        ))
      }
      <li class="sm:hidden mt-3">
        <a href={t.links.discovery} class="btn-primary w-full justify-center">
          {t.nav.cta}
          <span class="arrow"><ArrowIcon /></span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--color-paper);
    transition:
      background-color 0.2s ease,
      backdrop-filter 0.2s ease;
  }
  .site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-paper) 92%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
  }

  /* Over the black closing block (dark form + footer) the header inverts
     so the whole end of the page reads as one dark surface. Swapping the
     palette tokens flips links, lang switch, burger, CTA and drawer. */
  .site-header.is-dark {
    --color-ink: #ffffff;
    --color-paper: #060606;
    --color-border: rgb(255 255 255 / 0.14);
    --color-muted: #8c8c8c;
    color-scheme: dark;
  }
  .site-header.is-dark.is-scrolled {
    background-color: color-mix(in srgb, #060606 88%, transparent);
  }
  .site-header :global(img) {
    transition: filter 0.2s ease;
  }
  .site-header.is-dark :global(img) {
    filter: invert(1);
  }
  .site-header .nav-inline-link,
  .site-header .lang-switch,
  .site-header .menu-btn-bar {
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      opacity 0.2s ease,
      transform 0.25s ease;
  }

  @media (max-width: 767px) {
    .site-header {
      border-bottom: 1px solid var(--color-border);
    }
  }

  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .menu-btn-bar {
    display: block;
    height: 2px;
    background-color: var(--color-ink);
    border-radius: 2px;
    width: 100%;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      width 0.25s ease;
  }
  .menu-btn[aria-expanded="true"] .menu-btn-bar:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .menu-btn-bar:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    position: fixed;
    z-index: -1;
    background-color: var(--color-paper);
    overflow-y: auto;
    visibility: hidden;
    pointer-events: none;
  }
  .menu-panel[data-open="true"] {
    visibility: visible;
    pointer-events: auto;
  }

  /* Shared takeover rows — reference typography: ~20px medium weight,
     airy rhythm, always-visible chevrons, no dividers. */
  .menu-panel ul {
    gap: 0;
    padding-block: 0;
  }
  .menu-panel .menu-link {
    border-bottom: none;
    padding: 1.5rem 0;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .menu-panel .menu-link :global(svg) {
    opacity: 1;
    transform: none;
    width: 18px;
    height: 18px;
    color: var(--color-ink);
  }
  .menu-panel .menu-link.is-active > span {
    text-decoration: none;
  }
  .menu-panel .mt-3 {
    margin-top: 3rem;
  }

  /* Mobile: full-screen takeover. Negative z-index keeps the overlay
     under the header row inside the header's stacking context, so the
     logo and the X stay on top. */
  @media (max-width: 767px) {
    .menu-panel {
      inset: 0;
      height: 100dvh;
      padding-top: 7.5rem;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.25s ease,
        transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0.25s;
    }
    .menu-panel[data-open="true"] {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desktop: right-side drawer with the same rows — slides in over a
     dimmed backdrop (spread shadow), mobile-like proportions. */
  @media (min-width: 768px) {
    .menu-panel {
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: min(420px, 90vw);
      height: 100dvh;
      padding-top: 7.5rem;
      transform: translateX(100%);
      transition:
        transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.4s ease,
        visibility 0.4s;
    }
    .menu-panel[data-open="true"] {
      transform: translateX(0);
      box-shadow:
        0 0 0 100vmax rgb(0 0 0 / 0.35),
        -32px 0 64px rgb(0 0 0 / 0.18);
    }
    .menu-panel ul {
      padding-inline: 2.5rem;
    }
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-border);
  }
  .menu-link :global(svg) {
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }
  .menu-link:hover :global(svg),
  .menu-link:focus-visible :global(svg),
  .menu-link.is-active :global(svg) {
    opacity: 1;
    transform: translateX(0);
  }
  .menu-link.is-active > span {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-ink);
    text-underline-offset: 4px;
  }

  @media (min-width: 640px) {
    .menu-link {
      font-size: 2.5rem;
    }
  }
</style>

<style>
  /* Inline primary nav (lg+) — replaces the burger on wide screens. */
  .nav-inline {
    display: none;
  }
  @media (min-width: 1024px) {
    .nav-inline {
      display: block;
    }
    .menu-btn {
      display: none !important;
    }
  }
  .nav-inline {
    margin-right: 3.25rem;
  }
  .nav-inline ul {
    display: flex;
    gap: 3.25rem;
  }
  @media (min-width: 1024px) {
    .lang-switch {
      margin-right: 1.5rem;
    }
  }
  .nav-inline-link {
    position: relative;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    padding-block: 0.4rem;
    transition: opacity 0.2s ease;
  }
  .nav-inline-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-inline-link:hover::after,
  .nav-inline-link.is-active::after {
    transform: scaleX(1);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
    padding: 0.5rem 0.25rem;
    min-height: 2.75rem;
    transition: color 0.2s ease;
  }
  .lang-switch:hover {
    color: var(--color-ink);
  }
  .lang-switch .is-current {
    color: var(--color-ink);
  }

</style>

<script>
  // Toggle solid paper background once the user scrolls past the hero —
  // transparent at the top so the hero's cream bg shows through, tinted
  // paper after so content sliding underneath stays readable.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    // Dark when the header's midline sits over a [data-dark-zone] block.
    const zones = Array.from(document.querySelectorAll<HTMLElement>("[data-dark-zone]"));
    const onScroll = () => {
      if (window.scrollY > 32) header.classList.add("is-scrolled");
      else header.classList.remove("is-scrolled");
      const mid = header.offsetHeight / 2;
      const dark = zones.some((z) => {
        const r = z.getBoundingClientRect();
        return r.top <= mid && r.bottom > mid;
      });
      header.classList.toggle("is-dark", dark);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const toggle = document.getElementById("menuToggle");
  const panel = document.getElementById("primaryMenu");
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
      );
      panel.setAttribute("data-open", open ? "true" : "false");
      document.documentElement.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!open);
    });
    panel.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    // The burger disappears at 1024px — don't leave the drawer (and the
    // body scroll lock) stuck open if the viewport grows past it.
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
