---
/*
 * Home: a breathing pause between the logos and the work (Aerolab
 * "Startup instincts. Enterprise experience." pattern) — a two-line
 * statement, a whiteboard photo from a real session, and two short
 * paragraphs offset to the right half. Lots of white on purpose.
 */
import { Image } from "astro:assets";
import { ui, type Lang } from "~/i18n";
// A real working session: a conversion funnel on the whiteboard
// to the board — no people — and set in grey like the Studio photo).
import whiteboard from "~/assets/images/studio/comandos-whiteboard-funnel-session.webp";

type Props = { lang: Lang };
const t = ui[Astro.props.lang].statement;
---

<section aria-labelledby="statement-heading" class="statement">
  <div class="container-page statement-grid">
    <h2 id="statement-heading" class="statement-title">
      {t.line1}<br />
      {t.line2Pre}{t.line2Hl}{t.line2End}
    </h2>
    <figure class="statement-media">
      <Image
        src={whiteboard}
        alt={t.imageAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 900px) 44vw, 100vw"
        loading="lazy"
        decoding="async"
        class="statement-img"
      />
    </figure>
    <div class="statement-copy">
      <p>{t.p1}</p>
      <p>{t.p2}</p>
    </div>
  </div>
</section>

<style>
  .statement {
    padding-block: 6rem 1rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .statement {
      padding-block: 9.5rem 2rem;
    }
  }
  .statement-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .statement-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Text left (title, then copy), the tall photo on the right. */
      grid-template-areas:
        "title media"
        "copy media";
      grid-template-rows: auto 1fr;
      row-gap: 2.5rem;
      column-gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
    .statement-title {
      grid-area: title;
    }
    .statement-media {
      grid-area: media;
    }
    .statement-copy {
      grid-area: copy;
      align-self: start;
    }
  }
  .statement-title {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--color-ink);
  }
  .statement-media {
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-grey);
  }
  .statement-media :global(.statement-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    /* Keep the person at the bottom edge in view when cropped. */
    object-position: center 70%;
  }
  .statement-copy {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
  }
  .statement-copy p {
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
  }
</style>
