---
/*
 * Home: clients + proof in one block (Ramp "Join 85,000…" pattern).
 * A two-tone statement (lead in ink, the rest muted) with a quiet link,
 * then a grid of logo tiles — tiles with a case carry an arrow and link
 * to it — next to one large feature tile: Carlos at the strategy board
 * with the headline metric. Replaces the standalone clients strip.
 */
import { Image } from "astro:assets";
import { clients } from "~/data/clients";
import { homeImpact } from "~/data/home-work-i18n";
import { projects } from "~/data/projects";
import { localizedPath, ui, type Lang } from "~/i18n";
import { publicImageSize } from "~/lib/public-image-size";
// Carlos at the strategy whiteboard, in grey like the Studio photo.
import carlosBoard from "~/assets/images/studio/comandos-session-carlos-board.webp";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang].statement;

// Client → its case study (no entry = logo only, no arrow).
const CASES: Record<string, string> = {
  Stori: "stori-inversion-plus",
  Karta: "karta-card",
  Truora: "truora-truconnect",
  Legalario: "legalario-e-signature",
  RebajaTusCuentas: "rebajatuscuentas",
  mipOS: "mipos-kiosk",
};
const sizes = await Promise.all(clients.map((c) => publicImageSize(c.logo)));
const tiles = clients.map((c, i) => ({ ...c, size: sizes[i], slug: CASES[c.name] }));
const shownCases = new Set(Object.values(CASES)).size;
const moreCount = Math.max(0, projects.length - shownCases);

const feature = homeImpact[lang].find((m) => m.slug === "stori-inversion-plus")!;
const featureLogo = await publicImageSize("/images/logo-stori.png");
const href = (slug: string) => localizedPath(`/projects/${slug}/`, lang);
---

<section aria-labelledby="statement-heading" class="statement">
  <div class="container-page">
    <div class="st-head">
      <h2 id="statement-heading" class="st-title">
        <span class="st-lead">{t.lead}</span> {t.rest}
      </h2>
      <a href="#work" class="st-link">
        {t.cta}
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
      </a>
    </div>

    <div class="st-grid">
      <ul class="st-logos">
        {
          tiles.map((c) => {
            const logo = (
              <img
                src={c.logo}
                alt={c.name}
                width={c.size?.width}
                height={c.size?.height}
                loading="lazy"
                decoding="async"
                class="st-logo"
              />
            );
            return (
              <li class="st-tile">
                {c.slug ? (
                  <a href={href(c.slug)} class="st-tile-link" aria-label={`${c.name} — ${t.viewCase}`}>
                    {logo}
                    <span class="st-arrow" aria-hidden="true">
                      <svg viewBox="0 0 12 12"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                    </span>
                  </a>
                ) : (
                  <span class="st-tile-link">{logo}</span>
                )}
              </li>
            );
          })
        }
        {
          moreCount > 0 && (
            <li class="st-tile">
              <a href={localizedPath("/projects/", lang)} class="st-tile-link st-more">
                <span class="st-more-num">+{moreCount}</span>
                <span class="st-more-label">{t.more}</span>
              </a>
            </li>
          )
        }
      </ul>

      <a href={href(feature.slug)} class="st-feature">
        <Image
          src={carlosBoard}
          alt={t.imageAlt}
          widths={[480, 800, 1086]}
          sizes="(min-width: 1024px) 34vw, 100vw"
          loading="lazy"
          decoding="async"
          class="st-feature-img"
        />
        <span class="st-arrow st-arrow--light" aria-hidden="true">
          <svg viewBox="0 0 12 12"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </span>
        <span class="st-feature-body">
          <img src="/images/logo-stori.png" alt={feature.brand} class="st-feature-logo" width={featureLogo?.width} height={featureLogo?.height} loading="lazy" decoding="async" />
          <span class="st-feature-value">{feature.value}</span>
          <span class="st-feature-label">{feature.label}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .statement {
    padding-block: 4rem 3rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .statement {
      padding-block: 5.5rem 4rem;
    }
  }

  /* Two-tone statement: the lead in ink, the rest muted, one paragraph. */
  .st-head {
    max-width: 48rem;
  }
  .st-title {
    font-size: clamp(1.625rem, 2.6vw, 2.375rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .st-lead {
    color: var(--color-ink);
  }
  .st-link {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }
  .st-link svg {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.2s ease;
  }
  .st-link:hover {
    color: var(--color-ink);
  }
  .st-link:hover svg {
    transform: translateX(3px);
  }

  /* Grid: logo tiles + one feature tile. */
  .st-grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.375rem;
  }
  @media (min-width: 768px) {
    .st-grid {
      margin-top: 3.5rem;
    }
  }
  @media (min-width: 1024px) {
    .st-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
  .st-logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
  }
  @media (min-width: 640px) {
    .st-logos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .st-tile-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-paper);
    color: var(--color-ink);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  /* Phones: shorter tiles so the grid doesn't run long. */
  @media (max-width: 639px) {
    .st-tile-link {
      aspect-ratio: 4 / 3;
    }
  }
  a.st-tile-link:hover {
    border-color: var(--color-ink);
  }
  a.st-tile-link:focus-visible,
  .st-feature:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .st-logo {
    display: block;
    width: auto;
    max-width: 86%;
    height: auto;
    max-height: 1.625rem;
    object-fit: contain;
    filter: brightness(0);
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }
  a.st-tile-link:hover .st-logo {
    opacity: 0.9;
  }

  /* Corner arrow on tiles that open a case. */
  .st-arrow {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--color-grey);
    color: var(--color-ink);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .st-arrow svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  a.st-tile-link:hover .st-arrow,
  .st-feature:hover .st-arrow {
    background: var(--color-accent);
    color: var(--color-ink);
  }
  .st-arrow--light {
    background: rgb(255 255 255 / 0.85);
  }

  .st-more {
    align-items: flex-start;
    justify-content: flex-end;
  }
  .st-more-num {
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .st-more-label {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* Feature tile: photo with the headline metric on it. */
  .st-feature {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.75rem;
    aspect-ratio: 4 / 3;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  @media (min-width: 1024px) {
    .st-feature {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }
  /* Below desktop the feature leads, logos follow. */
  @media (max-width: 1023px) {
    .st-feature {
      order: -1;
    }
  }
  .st-feature :global(.st-feature-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 30%;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .st-feature:hover :global(.st-feature-img) {
    transform: scale(1.03);
  }
  .st-feature::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 6 6 / 0.82) 0%, rgb(6 6 6 / 0.35) 45%, rgb(6 6 6 / 0) 70%);
  }
  .st-feature-body {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
  }
  @media (min-width: 768px) {
    .st-feature-body {
      padding: 2rem;
    }
  }
  .st-feature-logo {
    display: block;
    width: auto;
    height: 1.5rem;
    filter: brightness(0) invert(1);
  }
  .st-feature-value {
    margin-top: 1rem;
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .st-feature-label {
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    color: rgb(255 255 255 / 0.85);
  }
  .st-feature-label::first-letter {
    text-transform: uppercase;
  }
  .st-feature .st-arrow {
    z-index: 1;
  }
</style>
