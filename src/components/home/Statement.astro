---
/*
 * Home: a breathing pause between the logos and the work. Structure after
 * ArchiPro's "Project Portfolio" panel: a full-height row with a large
 * statement, a short paragraph and one button on the left (vertically
 * centred), and one tall rounded photo on the right. The proof sits as
 * three small metric cards under the copy. Kept on the page's white.
 */
import { Image } from "astro:assets";
import { ui, type Lang } from "~/i18n";
// Carlos at the strategy whiteboard, in grey like the Studio photo.
import carlosBoard from "~/assets/images/studio/comandos-session-carlos-board.webp";
import { homeImpact } from "~/data/home-work-i18n";
import { localizedPath } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang].statement;
// Proof: three headline metrics, each a small card linking to its case.
const LOGOS: Record<string, string> = {
  "stori-inversion-plus": "/images/logo-stori.png",
  "mipos-kiosk": "/images/mipos-logo.svg",
  "legalario-e-signature": "/images/logo-legalario.png",
};
const proof = homeImpact[lang].filter((m) => m.slug in LOGOS);
---

<section aria-labelledby="statement-heading" class="statement">
  <div class="container-page statement-grid">
    <div class="statement-copy">
      <h2 id="statement-heading" class="display-serif statement-title">
        {t.line1}<br />
        {t.line2Pre}{t.line2Hl}{t.line2End}
      </h2>
      <p class="statement-sub">{t.p1}</p>
      <p class="statement-sub statement-sub--next">{t.p2}</p>
      <ul class="statement-proof">
        {
          proof.map((m) => (
            <li>
              <a href={localizedPath(`/projects/${m.slug}/`, lang)} class="sp-card">
                <img src={LOGOS[m.slug]} alt={m.brand} class="sp-logo" loading="lazy" decoding="async" />
                <span class="sp-value">{m.value}</span>
                <span class="sp-label">{m.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#work" class="statement-btn">{t.cta}</a>
    </div>
    <figure class="statement-media">
      <Image
        src={carlosBoard}
        alt={t.imageAlt}
        widths={[480, 800, 1086]}
        sizes="(min-width: 900px) 40vw, 100vw"
        loading="lazy"
        decoding="async"
        class="statement-img"
      />
    </figure>
  </div>
</section>

<style>
  .statement {
    padding-block: 5rem 3rem;
    background: var(--color-paper);
  }
  .statement-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .statement {
      padding-block: 4rem;
    }
    .statement-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 7rem);
      min-height: min(100svh - 6rem, 56rem);
    }
  }
  .statement-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Same scale as the next section title (CaseGrid .cg-title). */
  .statement-title {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    color: var(--color-ink);
  }
  .statement-sub {
    margin-top: 1.75rem;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    letter-spacing: -0.012em;
    color: var(--color-ink);
  }
  .statement-sub--next {
    margin-top: 0.9rem;
  }
  .statement-btn {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  .statement-btn:hover {
    background: color-mix(in srgb, var(--color-ink) 82%, var(--color-accent));
  }
  .statement-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  /* One tall rounded card, like a cover. */
  .statement-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-grey);
  }
  @media (min-width: 900px) {
    .statement-media {
      justify-self: end;
      width: min(100%, 36rem, calc((100svh - 10rem) * 0.8));
    }
  }
  .statement-media :global(.statement-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Proof cards: hairline cells, logo, figure, one line. */
  .statement-proof {
    margin-top: 1.75rem;
    width: 100%;
    max-width: 34rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .sp-card {
    container-type: inline-size;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0.9rem 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
    transition: border-color 0.2s ease;
  }
  .sp-card:hover {
    border-color: var(--color-ink);
  }
  .sp-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .sp-logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 1rem;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0);
    opacity: 0.75;
  }
  .sp-value {
    margin-top: 1rem;
    /* Fits "+477%" in its own card down to 320px screens. */
    font-size: min(2.25rem, 30cqi);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }
  .sp-label {
    margin-top: 0.5rem;
    font-size: min(0.8125rem, 12cqi);
    line-height: 1.3;
    color: var(--color-muted);
    overflow-wrap: anywhere;
    hyphens: auto;
  }
</style>
