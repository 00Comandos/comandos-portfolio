---
/*
 * Home: a breathing pause between the logos and the work. Structure after
 * ArchiPro's "Project Portfolio" panel: a full-height row with a large
 * statement, a short paragraph and one button on the left (vertically
 * centred), and one tall rounded card on the right — a short silent loop
 * of real working sessions (crossfade). Kept on the
 * page's white.
 */
import { Image } from "astro:assets";
import { ui, type Lang } from "~/i18n";
// A real working session: the funnel on the whiteboard plus a teammate at
// the laptop (front-facing person out), in grey like the Studio photo.
import whiteboard from "~/assets/images/studio/comandos-whiteboard-funnel-session.webp";
import carlosBoard from "~/assets/images/studio/comandos-session-carlos-board.webp";
import teamSession from "~/assets/images/studio/comandos-session-remote-team.webp";
import emailReview from "~/assets/images/studio/comandos-session-email-review.webp";

type Props = { lang: Lang };
const t = ui[Astro.props.lang].statement;
// A short silent loop of real working moments (crossfade, ~2.6 s each).
const slides = [
  { src: whiteboard, alt: t.imageAlt },
  { src: carlosBoard, alt: t.slideAlts[0] },
  { src: teamSession, alt: t.slideAlts[1] },
  { src: emailReview, alt: t.slideAlts[2] },
];
---

<section aria-labelledby="statement-heading" class="statement">
  <div class="container-page statement-grid">
    <div class="statement-copy">
      <h2 id="statement-heading" class="display-serif statement-title">
        {t.line1}<br />
        {t.line2Pre}{t.line2Hl}{t.line2End}
      </h2>
      <p class="statement-sub">{t.p1}</p>
      <p class="statement-sub statement-sub--next">{t.p2}</p>
      <a href="#studio" class="statement-btn">{t.cta}</a>
    </div>
    <figure class="statement-media" data-slides>
      {
        slides.map((sl, i) => (
          <Image
            src={sl.src}
            alt={sl.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 40vw, 100vw"
            loading="lazy"
            decoding="async"
            class="statement-img"
            data-slide
            data-active={i === 0 ? "" : undefined}
            aria-hidden={i === 0 ? undefined : "true"}
          />
        ))
      }
    </figure>
  </div>
</section>

<script>
  // Crossfade the photos while the card is on screen; reduced motion keeps
  // the first one.
  const HOLD = 2600;
  document.querySelectorAll<HTMLElement>("[data-slides]").forEach((fig) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const imgs = Array.from(fig.querySelectorAll<HTMLElement>("[data-slide]"));
    if (imgs.length < 2) return;
    let i = 0;
    let timer = 0;
    const show = (n: number) => {
      imgs.forEach((im, j) => {
        im.toggleAttribute("data-active", j === n);
        if (j === n) im.removeAttribute("aria-hidden");
        else im.setAttribute("aria-hidden", "true");
      });
    };
    const start = () => {
      if (timer) return;
      timer = window.setInterval(() => show((i = (i + 1) % imgs.length)), HOLD);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.25 }).observe(fig);
  });
</script>

<style>
  .statement {
    padding-block: 5rem 3rem;
    background: var(--color-paper);
  }
  .statement-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .statement {
      padding-block: 4rem;
    }
    .statement-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 7rem);
      min-height: min(100svh - 6rem, 56rem);
    }
  }
  .statement-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Same scale as the next section title (CaseGrid .cg-title). */
  .statement-title {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    color: var(--color-ink);
  }
  .statement-sub {
    margin-top: 1.75rem;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    letter-spacing: -0.012em;
    color: var(--color-ink);
  }
  .statement-sub--next {
    margin-top: 0.9rem;
  }
  .statement-btn {
    margin-top: 2.25rem;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  .statement-btn:hover {
    background: color-mix(in srgb, var(--color-ink) 82%, var(--color-accent));
  }
  .statement-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  /* One tall rounded card, like a cover. */
  .statement-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-grey);
  }
  @media (min-width: 900px) {
    .statement-media {
      justify-self: end;
      width: min(100%, 36rem, calc((100svh - 10rem) * 0.8));
    }
  }
  .statement-media :global(.statement-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  /* First slide: board plus the teammate at the bottom right. */
  .statement-media :global(.statement-img:first-child) {
    object-position: 70% 60%;
  }
  .statement-media :global(.statement-img[data-active]) {
    opacity: 1;
  }
</style>
