---
/*
 * Home: a breathing pause between the logos and the work (Aerolab
 * "Startup instincts. Enterprise experience." pattern) — a two-line
 * statement with one highlighted word, the Comandos mark, and two short
 * paragraphs offset to the right half. Lots of white on purpose.
 */
import logoSvg from "../../../public/images/Logo-Comandos.svg?raw";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang].statement;
// The isotype is the first 38.6 × 35 of the wordmark; crop it by viewBox.
const d = logoSvg.match(/\sd="([^"]+)"/)?.[1] ?? "";
---

<section aria-labelledby="statement-heading" class="statement">
  <div class="container-page statement-grid">
    <h2 id="statement-heading" class="statement-title">
      {t.line1}<br />
      {t.line2Pre}<span class="hl">{t.line2Hl}</span>{t.line2End}
    </h2>
    <svg class="statement-mark" viewBox="0 0 38.6 35" aria-hidden="true">
      <path fill-rule="evenodd" clip-rule="evenodd" d={d} fill="currentColor" />
    </svg>
    <div class="statement-copy">
      <p>{t.p1}</p>
      <p>{t.p2}</p>
    </div>
  </div>
</section>

<style>
  .statement {
    padding-block: 6rem 1rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .statement {
      padding-block: 9.5rem 2rem;
    }
  }
  .statement-grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .statement-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "title ."
        "mark copy";
      row-gap: 3.5rem;
      column-gap: 2rem;
    }
    .statement-title {
      grid-area: title;
    }
    .statement-mark {
      grid-area: mark;
    }
    .statement-copy {
      grid-area: copy;
    }
  }
  .statement-title {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--color-ink);
  }
  .statement-mark {
    width: 2rem;
    height: auto;
    color: var(--color-ink);
  }
  .statement-copy {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
  }
  .statement-copy p {
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
  }
</style>
