---
/*
 * Home: a breathing pause between the logos and the work. Structure after
 * ArchiPro's "Project Portfolio" panel: a full-height row with a large
 * statement, a short paragraph and one button on the left (vertically
 * centred), and one tall rounded photo on the right. The proof sits as
 * three small metric cards under the copy. Kept on the page's white.
 */
import { Image } from "astro:assets";
import { ui, type Lang } from "~/i18n";
// Carlos at the strategy whiteboard, in grey like the Studio photo.
import carlosBoard from "~/assets/images/studio/comandos-session-carlos-board.webp";
import { homeImpact } from "~/data/home-work-i18n";
import { localizedPath } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang].statement;
// Proof: three headline metrics, each a small card linking to its case.
const LOGOS: Record<string, string> = {
  "stori-inversion-plus": "/images/logo-stori.png",
  "mipos-kiosk": "/images/mipos-logo.svg",
  "legalario-e-signature": "/images/logo-legalario.png",
};
// Split "+477%" → "+", "477", "%" so the numeral sets large and thin with
// small superscript signs (same treatment as the case-study Result band).
const split = (v: string) => {
  const m = v.match(/^([^\d]*?)(\d+(?:[.,]\d+)?)(.*)$/);
  return m ? { pre: m[1], num: m[2], unit: m[3] } : { pre: "", num: v, unit: "" };
};
const proof = homeImpact[lang].filter((m) => m.slug in LOGOS).map((m) => ({ ...m, v: split(m.value) }));
---

<section aria-labelledby="statement-heading" class="statement">
  <div class="container-page statement-grid">
    <div class="statement-copy">
      <h2 id="statement-heading" class="display-serif statement-title">
        {t.line1}<br />
        {t.line2Pre}{t.line2Hl}{t.line2End}
      </h2>
      <p class="statement-sub">{t.p1}</p>
      <p class="statement-sub statement-sub--next">{t.p2}</p>
      <ul class="statement-proof">
        {
          proof.map((m) => (
            <li class="sp-cell">
              <a href={localizedPath(`/projects/${m.slug}/`, lang)} class="sp-card">
                <img src={LOGOS[m.slug]} alt={m.brand} class="sp-logo" loading="lazy" decoding="async" />
                <span class="sp-value">
                  <span class="sr-only">{m.value}</span>
                  <span class="sp-value-inner" aria-hidden="true">
                    {m.v.pre && <span class="sp-unit sp-pre">{m.v.pre}</span>}
                    <span class="sp-num">{m.v.num}</span>
                    {m.v.unit && <span class="sp-unit">{m.v.unit}</span>}
                  </span>
                </span>
                <span class="sp-label">{m.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#work" class="statement-btn">{t.cta}</a>
    </div>
    <figure class="statement-media">
      <Image
        src={carlosBoard}
        alt={t.imageAlt}
        widths={[480, 800, 1086]}
        sizes="(min-width: 900px) 40vw, 100vw"
        loading="lazy"
        decoding="async"
        class="statement-img"
      />
    </figure>
  </div>
</section>

<style>
  .statement {
    padding-block: 5rem 3rem;
    background: var(--color-paper);
  }
  .statement-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .statement {
      padding-block: 4rem;
    }
    .statement-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 7rem);
      min-height: min(100svh - 6rem, 56rem);
    }
  }
  .statement-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Same scale as the next section title (CaseGrid .cg-title). */
  .statement-title {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    color: var(--color-ink);
  }
  .statement-sub {
    margin-top: 1.75rem;
    max-width: 30rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    letter-spacing: -0.012em;
    color: var(--color-ink);
  }
  .statement-sub--next {
    margin-top: 0.9rem;
  }
  .statement-btn {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  .statement-btn:hover {
    background: color-mix(in srgb, var(--color-ink) 82%, var(--color-accent));
  }
  .statement-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  /* One tall rounded card, like a cover. */
  .statement-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-grey);
  }
  @media (min-width: 900px) {
    .statement-media {
      justify-self: end;
      width: min(100%, 36rem, calc((100svh - 10rem) * 0.8));
    }
  }
  .statement-media :global(.statement-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Proof band (case-study Result style): black top rule, hairline
     columns, large thin numerals with small superscript signs. */
  .statement-proof {
    margin-top: 1.75rem;
    width: 100%;
    max-width: 36rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
  }
  .sp-cell {
    container-type: inline-size;
    min-width: 0;
    border-left: 1px solid var(--color-border);
  }
  .sp-cell:first-child {
    border-left: 0;
  }
  .sp-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 0.9rem 0.5rem;
    color: var(--color-ink);
  }
  .sp-cell:first-child .sp-card {
    padding-left: 0;
  }
  .sp-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .sp-logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 0.95rem;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0);
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .sp-card:hover .sp-logo {
    opacity: 1;
  }
  .sp-value {
    margin-top: 1.25rem;
    font-size: min(4.25rem, 31cqi);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }
  .sp-value-inner {
    display: flex;
    align-items: flex-start;
  }
  .sp-num {
    font-variant-numeric: tabular-nums;
  }
  .sp-unit {
    font-size: 0.34em;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-top: 0.12em;
    margin-left: 0.06em;
  }
  .sp-pre {
    margin-left: 0;
    margin-right: 0.04em;
  }
  .sp-label {
    margin-top: 1rem;
    font-size: min(0.9375rem, 11cqi);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
  .sp-label::first-letter {
    text-transform: uppercase;
  }
</style>
