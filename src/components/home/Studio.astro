---
import { Image } from "astro:assets";
import { ui, type Lang } from "~/i18n";
// Stock placeholder (Unsplash) until real studio photography exists.
import studioPhoto from "~/assets/images/stock/studio-workshop.jpg";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section id="studio" aria-labelledby="studio-heading" class="studio">
  <div class="container-page">
    <figure class="studio-media">
      <Image
        src={studioPhoto}
        alt={t.studio.imageAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 40vw, 100vw"
        loading="lazy"
        decoding="async"
        class="studio-img"
      />
    </figure>

    <h2 id="studio-heading" class="studio-title">
      {t.studio.title} {t.studio.titleEm}
    </h2>

    <div class="studio-intro">
      <p class="eyebrow">{t.studio.eyebrow}</p>
      <p class="studio-body">{t.studio.body}</p>
    </div>

    <ul class="studio-points">
      {
        t.studio.points.map((p, i) => (
          <li>
            <span class="point-num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .studio {
    padding-block: 5rem;
    background: var(--color-paper);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .studio {
      padding-block: 7.5rem;
    }
  }

  .studio-media {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-grey);
  }
  @media (min-width: 900px) {
    .studio-media {
      width: 36%;
    }
  }
  .studio-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
    /* Monochrome until real studio photography exists. */
    filter: grayscale(1) contrast(1.05);
  }

  .studio-title {
    margin-top: 2.25rem;
    max-width: 15em;
    font-size: clamp(2.25rem, 4.4vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.04;
    color: var(--color-ink);
  }

  .studio-intro {
    margin-top: 2.5rem;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .studio-intro {
      grid-template-columns: 1fr 2fr;
      gap: 2rem;
      align-items: baseline;
    }
  }
  .studio-body {
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .studio-points {
    margin-top: 4rem;
    display: grid;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .studio-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .studio-points li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 0 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .studio-points li {
      padding: 1.5rem 2rem 0.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--color-border);
    }
    .studio-points h3 {
      margin-top: 1.75rem;
    }
    .studio-points li:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
  .point-num {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .studio-points h3 {
    margin-top: 0.75rem;
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .studio-points p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 24rem;
  }
</style>
