---
import { Image } from "astro:assets";
import { ui, type Lang } from "~/i18n";
// Stock placeholder (Unsplash) until real studio photography exists.
import studioPhoto from "~/assets/images/stock/studio-workshop.jpg";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section id="studio" aria-labelledby="studio-heading" class="studio">
  <div class="container-page studio-grid">
    <figure class="studio-media">
      <Image
        src={studioPhoto}
        alt={t.studio.imageAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1024px) 560px, 100vw"
        loading="lazy"
        decoding="async"
        class="studio-img"
      />
    </figure>

    <div class="studio-copy">
      <p class="eyebrow">{t.studio.eyebrow}</p>
      <h2 id="studio-heading" class="display-serif studio-title">
        {t.studio.title}<br /><em>{t.studio.titleEm}</em>
      </h2>
      <p class="studio-body">{t.studio.body}</p>

      <ul class="studio-points">
        {
          t.studio.points.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .studio {
    padding-block: 5rem;
    background: var(--color-paper-soft);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .studio {
      padding-block: 7.5rem;
    }
  }
  .studio-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .studio-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
  .studio-media {
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  @media (max-width: 1023px) {
    .studio-media {
      aspect-ratio: 3 / 2;
    }
  }
  .studio-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
  }
  .studio-title {
    margin-top: 0.85rem;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .studio-body {
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 34rem;
  }
  .studio-points {
    margin-top: 2.25rem;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }
  .studio-points li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    display: grid;
    gap: 0.35rem;
  }
  @media (min-width: 640px) {
    .studio-points li {
      grid-template-columns: 14rem 1fr;
      gap: 1.5rem;
    }
  }
  .studio-points h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .studio-points p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
</style>
