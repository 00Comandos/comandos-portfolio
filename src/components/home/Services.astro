---
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section id="services" aria-labelledby="services-heading" class="services">
  <div class="container-page">
    <div class="services-head">
      <h2 id="services-heading" class="services-title">
        {t.services.title} {t.services.titleEm}
      </h2>
      <span class="services-rule" aria-hidden="true"></span>
    </div>

    <p class="services-sub">{t.services.sub}</p>

    <ol class="services-grid">
      {
        t.services.items.map((s, i) => (
          <li class="service" id={`service-${s.id}`}>
            <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-body">{s.body}</p>
            <ul class="service-tags">
              {s.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="services-foot">
      <a href={t.links.discovery} class="btn-invert">{t.services.cta}</a>
    </div>
  </div>
</section>

<style>
  .services {
    background: #000;
    color: #fff;
    padding-block: 5rem 3.5rem;
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .services {
      padding-block: 7.5rem 4rem;
    }
  }

  /* Headline + hairline running out to the right edge (Riotters). */
  .services-head {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }
  .services-title {
    font-size: clamp(2rem, 4.4vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.04;
    max-width: 52rem;
    color: #fff;
  }
  .services-rule {
    display: none;
    flex: 1;
    min-width: 6rem;
    height: 1px;
    background: rgb(255 255 255 / 0.35);
  }
  @media (min-width: 900px) {
    .services-rule {
      display: block;
    }
  }

  .services-eyebrow {
    margin-bottom: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted-soft);
  }
  .services-sub {
    margin-top: 1.75rem;
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-muted-soft);
  }

  .services-grid {
    margin-top: 3rem;
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.25);
  }
  @media (min-width: 640px) {
    .services-grid {
      margin-top: 4.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .services-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 0 2rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
  }
  @media (min-width: 640px) {
    .service-title {
      margin-top: 2.5rem;
    }
    .service {
      padding: 1.75rem 1.75rem 2.25rem;
      border-left: 1px solid rgb(255 255 255 / 0.25);
    }
    .service:nth-child(2n + 1) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (min-width: 1100px) {
    .service {
      border-bottom: 0;
    }
    .service:nth-child(2n + 1) {
      border-left: 1px solid rgb(255 255 255 / 0.25);
      padding-left: 1.75rem;
    }
    .service:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }

  .service-num {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .service-title {
    margin-top: 1rem;
    font-size: clamp(1.375rem, 1.8vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
  }
  .service-body {
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted-soft);
  }
  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin-top: 0.5rem;
  }
  .service-tags li {
    position: relative;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .service-tags li + li::before {
    content: "";
    position: absolute;
    left: -0.55rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: var(--color-muted);
    transform: translateY(-50%);
  }

  .services-foot {
    margin-top: 3rem;
  }

  /* Inverted Riotters pill for black backgrounds. */
  .btn-invert {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.15rem 0.5rem 1rem;
    border-radius: 9999px;
    background: #fff;
    color: var(--color-ink);
    border: 1px solid #fff;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .btn-invert::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: currentColor;
    transition: background-color 0.2s ease;
  }
  .btn-invert:hover {
    background: transparent;
    color: #fff;
  }
  .btn-invert:hover::before {
    background: var(--color-accent);
  }
  .btn-invert:focus-visible {
    outline-color: #fff;
  }
</style>
