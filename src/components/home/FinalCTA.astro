---
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section aria-labelledby="final-cta-heading" class="final-cta">
  <div class="container-page">
    <div class="final-card">
      <h2 id="final-cta-heading" class="display-serif final-title">
        {t.finalCta.title}<br /><em>{t.finalCta.titleEm}</em>
      </h2>
      <p class="final-sub">{t.finalCta.sub}</p>
      <div class="final-actions">
        <a href={t.links.discovery} class="btn-primary final-primary">
          {t.finalCta.primary}
          <span class="arrow"><ArrowIcon /></span>
        </a>
        <a href={t.links.contact} class="final-secondary">
          {t.finalCta.secondary}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: 2rem 5rem;
    background: var(--color-paper-soft);
  }
  @media (min-width: 768px) {
    .final-cta {
      padding-block: 2rem 7rem;
    }
  }
  .final-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 3.5rem 1.75rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .final-card {
      padding: 6rem 3rem;
    }
  }
  /* Soft accent glow — the only place the pink goes big. */
  .final-card::before {
    content: "";
    position: absolute;
    width: 36rem;
    height: 36rem;
    left: 50%;
    bottom: -26rem;
    transform: translateX(-50%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 55%, transparent) 0%,
      transparent 65%
    );
    pointer-events: none;
  }
  .final-title {
    position: relative;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }
  .final-sub {
    position: relative;
    margin: 1.5rem auto 0;
    max-width: 32rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.72);
  }
  .final-actions {
    position: relative;
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2rem;
  }
  .final-cta :global(.final-primary) {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .final-secondary {
    font-size: 0.95rem;
    font-weight: 500;
    color: #fff;
    padding-bottom: 3px;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
    transition: border-color 0.2s ease;
  }
  .final-secondary:hover {
    border-bottom-color: #fff;
  }
</style>
