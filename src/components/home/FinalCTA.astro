---
// Closing section on every marketing page: the contact form itself, inline
// (Tubik), framed by the contact page's promise + bullets (Karta). Same
// form, same API — visitors convert without changing page.
import ContactForm from "~/components/contact/ContactForm.astro";
import { ui, type Lang } from "~/i18n";
import { contactCopy } from "~/i18n/contact";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const c = contactCopy[lang];
const EMAIL = "c@comandos.me";
---

<section id="contact" aria-labelledby="final-cta-heading" class="final-cta">
  <div class="container-page final-grid">
    <div class="final-copy">
      <p class="eyebrow">{c.meta.breadcrumb}</p>
      <h2 id="final-cta-heading" class="final-title">
        {t.finalCta.title} <span class="hl">{t.finalCta.titleEm}</span>
      </h2>
      <p class="final-sub">{t.finalCta.sub}</p>

      <ul class="final-bullets">
        {
          c.bullets.map((b) => (
            <li>
              <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M2 2l8 8M10 3.5V10H3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
              {b}
            </li>
          ))
        }
      </ul>

      <p class="final-direct">
        <span class="final-direct-label mono">{c.direct.label}</span>
        <a href={`mailto:${EMAIL}`} class="final-link">{EMAIL}</a>
        <button
          type="button"
          class="final-copy-btn"
          data-final-copy={EMAIL}
          data-label={c.direct.copy}
          data-done={c.direct.copied}
        >
          {c.direct.copy}
        </button>
        <span class="sr-only" aria-live="polite" data-final-copy-status></span>
      </p>
    </div>

    <div class="final-form">
      <ContactForm lang={lang} />
    </div>
  </div>
</section>

<script>
  function initFinalCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-final-copy]").forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = "1";
      const status = btn.parentElement?.querySelector<HTMLElement>("[data-final-copy-status]");
      let timer: number | undefined;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.finalCopy ?? "");
        } catch {
          return;
        }
        btn.textContent = btn.dataset.done ?? "";
        if (status) status.textContent = btn.dataset.done ?? "";
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = btn.dataset.label ?? "";
          if (status) status.textContent = "";
        }, 1800);
      });
    });
  }
  initFinalCopy();
  document.addEventListener("astro:page-load", initFinalCopy);
</script>

<style>
  .final-cta {
    padding-block: 5rem;
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .final-cta {
      padding-block: 7rem 8rem;
    }
  }

  .final-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .final-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 0;
    }
    .final-copy {
      padding-right: 3.5rem;
    }
    .final-form {
      padding-left: 3.5rem;
      border-left: 1px solid var(--color-border);
    }
  }

  .final-title {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.08;
    color: var(--color-ink);
    max-width: 12em;
  }
  /* Short pill ("Let's talk.") never splits, even on 320px phones. */
  .final-title .hl {
    white-space: nowrap;
  }
  .final-sub {
    margin-top: 1.5rem;
    max-width: 28rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .final-bullets {
    margin-top: 2rem;
    display: grid;
    gap: 0.6rem;
  }
  .final-bullets li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .final-bullets svg {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .final-direct {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    font-size: 0.9375rem;
  }
  .final-direct-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .final-link {
    position: relative;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 1px;
  }
  /* Invisible 44px hit area around the small inline email link. */
  .final-link::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.25rem;
  }
  .final-link:hover {
    border-bottom-color: var(--color-accent);
  }
  .final-copy-btn {
    background: none;
    border: 0;
    padding: 0.75rem 0.25rem;
    margin: -0.75rem 0;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-muted);
    cursor: pointer;
  }
  .final-copy-btn:hover {
    color: var(--color-ink);
  }
</style>
