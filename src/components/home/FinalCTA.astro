---
// Closing section on every marketing page: the contact form itself, inline
// (Tubik), framed by the contact page's promise + bullets (Karta). Same
// form, same API — visitors convert without changing page.
import ContactForm from "~/components/contact/ContactForm.astro";
import { ui, type Lang } from "~/i18n";
import { contactCopy } from "~/i18n/contact";

// Dark by default: the section runs straight into the black footer as one
// closing block (and the header turns black over it). `tone="light"` keeps
// the old paper version.
type Props = { lang: Lang; tone?: "light" | "dark" };
const { lang, tone = "dark" } = Astro.props;
const t = ui[lang];
const c = contactCopy[lang];
const EMAIL = "c@comandos.me";
---

<section id="contact" aria-labelledby="final-cta-heading" class:list={["final-cta", { "final-cta--dark": tone === "dark" }]} data-dark-zone={tone === "dark" ? "" : undefined}>
  <div class="container-page final-grid">
    <div class="final-copy">
      <h2 id="final-cta-heading" class="final-title">
        {t.finalCta.title} <span class="hl">{t.finalCta.titleEm}</span>
      </h2>
      <p class="final-sub">{t.finalCta.sub}</p>

      <ul class="final-bullets">
        {
          c.bullets.map((b) => (
            <li>
              <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M2 2l8 8M10 3.5V10H3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
              {b}
            </li>
          ))
        }
      </ul>

      <p class="final-direct">
        <span class="final-direct-label mono">{c.direct.label}</span>
        <a href={`mailto:${EMAIL}`} class="final-link">{EMAIL}</a>
        <button
          type="button"
          class="final-copy-btn"
          data-final-copy={EMAIL}
          data-label={c.direct.copy}
          data-done={c.direct.copied}
        >
          {c.direct.copy}
        </button>
        <span class="sr-only" aria-live="polite" data-final-copy-status></span>
      </p>
    </div>

    <div class="final-form">
      <ContactForm lang={lang} theme={tone} />
    </div>
  </div>
</section>

<script>
  function initFinalCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-final-copy]").forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = "1";
      const status = btn.parentElement?.querySelector<HTMLElement>("[data-final-copy-status]");
      let timer: number | undefined;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.finalCopy ?? "");
        } catch {
          return;
        }
        btn.textContent = btn.dataset.done ?? "";
        if (status) status.textContent = btn.dataset.done ?? "";
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = btn.dataset.label ?? "";
          if (status) status.textContent = "";
        }, 1800);
      });
    });
  }
  initFinalCopy();
  document.addEventListener("astro:page-load", initFinalCopy);
</script>

<style>
  .final-cta {
    padding-block: 5rem;
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .final-cta {
      padding-block: 7rem 8rem;
    }
  }

  /* Dark tone: swap the palette tokens locally so the form, chips, inputs
     and buttons all invert without touching ContactForm's own styles.
     No bottom edge — the footer continues the same black. */
  .final-cta--dark {
    --color-ink: #ffffff;
    --color-ink-soft: #d6d6d6;
    --color-paper: #060606;
    --color-paper-soft: #111111;
    --color-grey: #1c1c1c;
    --color-border: rgb(255 255 255 / 0.16);
    --color-muted: #8c8c8c;
    --color-muted-soft: #6a6a6a;
    color-scheme: dark;
    background: #060606;
    color: #ffffff;
    border-top: 0;
    padding-bottom: 0;
  }
  /* One hairline is all that separates the form from the footer columns. */
  .final-cta--dark .final-grid {
    padding-bottom: 4.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .final-cta--dark {
      padding-bottom: 0;
    }
    .final-cta--dark .final-grid {
      padding-bottom: 6rem;
    }
  }
  .final-cta--dark :global(:focus-visible) {
    outline-color: #ffffff;
  }

  .final-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .final-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 0;
    }
    .final-copy {
      padding-right: 3.5rem;
    }
    .final-form {
      padding-left: 3.5rem;
      border-left: 1px solid var(--color-border);
    }
  }

  .final-title {
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.08;
    color: var(--color-ink);
    max-width: 12em;
    text-wrap: balance;
  }
  /* Short pill ("Let's talk.") never splits, even on 320px phones. */
  .final-title .hl {
    white-space: nowrap;
  }
  .final-sub {
    margin-top: 1.5rem;
    max-width: 28rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .final-bullets {
    margin-top: 2rem;
    display: grid;
    gap: 0.6rem;
  }
  .final-bullets li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .final-bullets svg {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .final-direct {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    font-size: 0.9375rem;
  }
  .final-direct-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .final-link {
    position: relative;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 1px;
  }
  /* Invisible 44px hit area around the small inline email link. */
  .final-link::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.25rem;
  }
  .final-link:hover {
    border-bottom-color: var(--color-accent);
  }
  .final-copy-btn {
    background: none;
    border: 0;
    padding: 0.75rem 0.25rem;
    margin: -0.75rem 0;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-muted);
    cursor: pointer;
  }
  .final-copy-btn:hover {
    color: var(--color-ink);
  }
  /* Phones: the sub already promises the reply time; the bullets and the
     email block only lengthen the way to the form. */
  /* (Last, so it beats the display rules above.) */
  @media (max-width: 767px) {
    .final-bullets,
    .final-direct {
      display: none;
    }
  }
</style>
