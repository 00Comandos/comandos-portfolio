---
// Home B: two audience paths right before the inline form. Picking one
// pre-ticks the matching project types in the form below and scrolls to
// it; without JS the link opens /contact/ with the preset.
import { localizedPath, type Lang } from "~/i18n";
import { homeB } from "~/i18n/home-b";

type Props = { lang: Lang };
const { lang } = Astro.props;
const c = homeB[lang].paths;
---

<section aria-labelledby="paths-heading" class="paths">
  <div class="container-page">
    <div class="paths-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="paths-heading" class="paths-title">{c.title}</h2>
      <p class="paths-sub">{c.sub}</p>
    </div>
    <ul class="paths-list">
      {
        c.items.map((p, i) => (
          <li class="path">
            <a
              class="path-link"
              href={`${localizedPath("/contact/", lang)}?type=${p.preset}`}
              data-path-types={JSON.stringify(p.types)}
            >
              <span class="path-label mono">
                <span class="path-num">{String(i + 1).padStart(2, "0")}</span> {p.label}
              </span>
              <span class="path-title">{p.title}</span>
              <span class="path-body">{p.body}</span>
              <span class="path-points">
                {p.points.map((pt) => (
                  <span class="path-point">{pt}</span>
                ))}
              </span>
              <span class="path-cta">
                {p.cta}
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-path-types]").forEach((a) =>
    a.addEventListener("click", (e) => {
      const form = document.querySelector<HTMLElement>("#contact form");
      if (!form) return; // no inline form: follow the /contact/?type= link
      e.preventDefault();
      const types: string[] = JSON.parse(a.dataset.pathTypes ?? "[]");
      form.querySelectorAll<HTMLInputElement>('input[name="projectType"]').forEach((box) => {
        const want = types.includes(box.value);
        if (box.checked !== want) {
          box.checked = want;
          box.dispatchEvent(new Event("change", { bubbles: true }));
        }
      });
      document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => form.querySelector<HTMLInputElement>("#name")?.focus({ preventScroll: true }), 700);
    }),
  );
</script>

<style>
  .paths {
    padding-block: 5rem;
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .paths {
      padding-block: 7.5rem;
    }
  }
  .paths-head {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
  .paths-head .eyebrow {
    color: var(--color-muted);
  }
  .paths-title {
    font-size: clamp(2.25rem, 4.4vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.04;
    text-wrap: balance;
  }
  .paths-sub {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 34rem;
  }
  .paths-list {
    margin-top: 3rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .paths-list {
      margin-top: 4rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.125rem;
    }
  }
  .path-link {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  @media (min-width: 768px) {
    .path-link {
      padding: 2.25rem 2.25rem 2rem;
    }
  }
  .path-link:hover {
    border-color: var(--color-ink);
  }
  .path-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .path-label {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .path-num {
    color: var(--color-ink);
  }
  .path-title {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 2.6vw, 2.375rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .path-body {
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .path-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .path-point {
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
  }
  .path-cta {
    margin-top: auto;
    padding-top: 1.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .path-cta svg {
    width: 0.8rem;
    height: 0.8rem;
    transition: transform 0.2s ease;
  }
  .path-link:hover .path-cta svg {
    transform: translateX(3px);
  }
  .path-link:hover .path-cta {
    color: var(--color-ink);
  }
  .path-cta::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--color-accent);
  }
</style>
