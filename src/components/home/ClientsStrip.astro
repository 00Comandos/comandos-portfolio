---
import { clients } from "~/data/clients";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section aria-label={t.clients.label} class="clients">
  <div class="container-page">
    <div class="clients-head">
      <p class="eyebrow">{t.clients.label}</p>
      <p class="clients-note">{t.clients.title}</p>
    </div>

    <ul class="clients-grid">
      {
        clients.map((c) => {
          const img = (
            <img
              src={c.logo}
              alt={c.name}
              loading="lazy"
              decoding="async"
              class={`clients-logo ${c.maxHeightClass ?? ""}`}
            />
          );
          return (
            <li class="clients-cell">
              {c.website ? (
                <a
                  href={c.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="clients-link"
                >
                  {img}
                </a>
              ) : (
                img
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .clients {
    padding-block: 4rem 4.5rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .clients {
      padding-block: 7rem 9rem;
    }
  }

  .clients-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .clients-head {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 4.25rem;
    }
  }
  .clients-note {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--color-muted);
    max-width: 40ch;
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 2.5rem;
    column-gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .clients-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  .clients-cell {
    display: flex;
    align-items: center;
    height: 2.25rem;
  }
  .clients-link {
    display: inline-flex;
    align-items: center;
    height: 100%;
    transition: opacity 0.2s ease;
  }
  .clients-link:hover {
    opacity: 0.55;
  }
  .clients-logo {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 1.375rem;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0);
  }
  @media (min-width: 768px) {
    .clients-logo {
      max-height: 1.625rem;
    }
  }
</style>
