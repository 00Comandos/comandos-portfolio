---
import { clients as baseClients, type Client } from "~/data/clients";
import { ui, type Lang } from "~/i18n";

// `more` (home B): adds the two clients with the most published cases —
// 8 logos: one row on wide screens, 4 × 2 on tablets, 2 × 4 on phones.
type Props = { lang: Lang; more?: boolean };
const { more = false } = Astro.props;
const t = ui[Astro.props.lang];
const EXTRA: Client[] = [
  { name: "Legalario", logo: "/images/logo-legalario.png" },
  { name: "mipOS", logo: "/images/mipos-logo.svg" },
];
const clients = more ? [...baseClients.slice(0, 3), EXTRA[0], baseClients[3], EXTRA[1], ...baseClients.slice(4)] : baseClients;
---

<section aria-label={t.clients.label} class="clients">
  <div class="container-page">
    <div class="clients-head">
      <p class="eyebrow">{t.clients.label}</p>
      <p class="clients-note">{t.clients.title}</p>
    </div>

    <ul class:list={["clients-grid", { "clients-grid--8": more }]}>
      {
        clients.map((c) => {
          const img = (
            <img
              src={c.logo}
              alt={c.name}
              loading="lazy"
              decoding="async"
              class={`clients-logo ${c.maxHeightClass ?? ""}`}
            />
          );
          return (
            <li class="clients-cell">
              {c.website ? (
                <a
                  href={c.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="clients-link"
                >
                  {img}
                </a>
              ) : (
                img
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .clients {
    padding-block: 4rem 4.5rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .clients {
      padding-block: 7rem 9rem;
    }
  }

  /* Label and note sit side by side, joined by a small dot. */
  .clients-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .clients-head {
      margin-bottom: 4.25rem;
    }
  }
  .clients-head .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .clients-head .eyebrow::after {
    content: none;
  }
  @media (min-width: 768px) {
    .clients-head .eyebrow::after {
      content: "";
    }
  }
  .clients-head .eyebrow::after {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: var(--color-muted-soft);
  }
  .clients-note {
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--color-muted);
  }

  .clients-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 2.5rem;
    column-gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .clients-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  /* Eight logos: 2 × 4 → 4 × 2 → one row. */
  .clients-grid--8 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .clients-grid--8 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .clients-grid--8 {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
  .clients-cell {
    display: flex;
    align-items: center;
    height: 2.25rem;
  }
  .clients-link {
    display: inline-flex;
    align-items: center;
    height: 100%;
    transition: opacity 0.2s ease;
  }
  .clients-link:hover {
    opacity: 0.55;
  }
  .clients-logo {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 1.375rem;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0);
  }
  @media (min-width: 768px) {
    .clients-logo {
      max-height: 1.625rem;
    }
  }
</style>
