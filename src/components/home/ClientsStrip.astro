---
import { clients } from "~/data/clients";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
---

<section aria-label={t.clients.label} class="clients">
  <div class="container-page">
    <ul class="clients-grid">
      {
        clients.map((c) => {
          const img = (
            <img
              src={c.logo}
              alt={c.name}
              loading="lazy"
              decoding="async"
              class={`clients-logo ${c.maxHeightClass ?? ""}`}
            />
          );
          return (
            <li class="clients-cell">
              {c.website ? (
                <a
                  href={c.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="clients-link"
                >
                  {img}
                </a>
              ) : (
                img
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Logos only (the section keeps its aria-label): a band framed by the
     hero's bottom hairline and a matching full-width one below. */
  .clients {
    padding-block: 1.75rem;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .clients {
      padding-block: 2.25rem;
    }
  }

  .clients-grid {
    display: grid;
    /* Seven logos: 2 columns → 4 → one row. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: 2.5rem;
    column-gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .clients-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (min-width: 1280px) {
    .clients-grid {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }
  .clients-cell {
    display: flex;
    align-items: center;
    height: 2.25rem;
  }
  .clients-link {
    display: inline-flex;
    align-items: center;
    height: 100%;
    transition: opacity 0.2s ease;
  }
  .clients-link:hover {
    opacity: 0.55;
  }
  .clients-logo {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 1.375rem;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0);
  }
  @media (min-width: 768px) {
    .clients-logo {
      max-height: 1.625rem;
    }
  }
</style>
