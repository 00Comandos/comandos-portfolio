---
import { Image } from "astro:assets";
import { projects } from "~/data/projects";
import { homeBeforeAfter } from "~/data/home-before-after";
import { HOME_CASE_SLUGS } from "~/data/home-work-i18n";
import { homeWorkCopy } from "~/data/home-work-i18n";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];

// Riotters-style asymmetric grid. Order is editorial (not `project.order`):
// small+large, large+small, full-width, small+large.
const slugs = HOME_CASE_SLUGS;
const sizes = ["s", "l", "l", "s", "f", "s", "l"] as const;
const sizesAttr = {
  s: "(min-width: 768px) 33vw, 100vw",
  l: "(min-width: 768px) 66vw, 100vw",
  f: "100vw",
};

const tiles = slugs.flatMap((slug, i) => {
  const p = projects.find((x) => x.slug === slug);
  if (!p) return [];
  const ba = homeBeforeAfter.find((x) => x.slug === slug);
  const copy = homeWorkCopy[lang][slug];
  const impact =
    lang === "es" ? (copy?.impact ?? ba?.impact ?? p.impact) : (ba?.impact ?? p.impact);
  return [
    {
      slug,
      size: sizes[i],
      name: ba?.brand ?? p.brand,
      alt: p.title,
      image: p.image,
      impact,
      tags: copy?.tags ?? [],
    },
  ];
});
---

<section id="work" aria-labelledby="work-heading" class="case-grid">
  <div class="container-page">
    <div class="cg-head">
      <div class="cg-head-copy">
        <p class="eyebrow">{t.work.eyebrow}</p>
        <h2 id="work-heading" class="display-serif cg-title">
          {t.work.title} <em>{t.work.titleEm}</em>
        </h2>
      </div>
      <a href="/projects/" class="btn-outline cg-all">{t.work.all}</a>
    </div>

    <ul class="cg-list">
      {
        tiles.map((tile, i) => (
          <li class={`cg-tile cg-${tile.size}`}>
            <a href={`/projects/${tile.slug}/`} class="cg-link">
              <span class="cg-media">
                <Image
                  src={tile.image}
                  alt={tile.alt}
                  widths={tile.size === "s" ? [480, 720, 960] : [720, 1080, 1440, 1920]}
                  sizes={sizesAttr[tile.size]}
                  loading={i < 2 ? "eager" : "lazy"}
                  class="cg-img"
                />
              </span>
              <span class="cg-meta">
                <span class="cg-name">{tile.name}</span>
                <span class="cg-impact">{tile.impact}</span>
                {tile.tags.length > 0 && (
                  <span class="cg-tags">
                    {tile.tags.map((tag) => (
                      <span class="cg-tag">{tag}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .case-grid {
    padding-block: 4.5rem 5rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .case-grid {
      padding-block: 7.5rem 8rem;
    }
  }

  .cg-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .cg-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 4.5rem;
    }
  }
  .cg-head-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cg-title {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    max-width: 16ch;
  }
  .cg-all {
    flex-shrink: 0;
  }

  /* Grid: 3 columns, small = 1 col, large = 2 cols, full = 3 cols. */
  .cg-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 3rem;
  }
  @media (min-width: 768px) {
    .cg-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.125rem;
      row-gap: 4.5rem;
      align-items: start;
    }
    .cg-s {
      grid-column: span 1;
    }
    .cg-l {
      grid-column: span 2;
    }
    .cg-f {
      grid-column: 1 / -1;
    }
  }

  .cg-link {
    display: block;
    color: var(--color-ink);
  }
  .cg-media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-grey);
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 768px) {
    .cg-s .cg-media,
    .cg-l .cg-media {
      aspect-ratio: 16 / 9;
    }
    .cg-f .cg-media {
      aspect-ratio: 2 / 1;
    }
  }
  .cg-media :global(.cg-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cg-link:hover :global(.cg-img) {
    transform: scale(1.04);
  }

  .cg-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .cg-name {
    flex-basis: 100%;
    font-size: clamp(1.375rem, 1.8vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .cg-impact {
    font-size: 0.875rem;
    color: var(--color-muted);
    letter-spacing: -0.01em;
  }
  .cg-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .cg-tag {
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }
  .cg-name::after {
    content: "";
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.5rem;
    vertical-align: middle;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .cg-link:hover .cg-name::after {
    opacity: 1;
    transform: none;
  }
</style>
