---
import { Image } from "astro:assets";
import { projects } from "~/data/projects";
import { homeBeforeAfter } from "~/data/home-before-after";
import { HOME_CASE_SLUGS } from "~/data/home-work-i18n";
import { homeWorkCopy } from "~/data/home-work-i18n";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];

// Riotters-style asymmetric grid. Order is editorial (not `project.order`):
// small+large, large+small, full-width, small+large.
const slugs = HOME_CASE_SLUGS;
const sizes = ["s", "l", "l", "s", "f", "s", "l"] as const;
const sizesAttr = {
  s: "(min-width: 768px) 33vw, 100vw",
  l: "(min-width: 768px) 66vw, 100vw",
  f: "100vw",
};

// Hover previews (Tubik-style "quick view") for cases that have footage.
// `end` loops only the first seconds (Karta: hide the card turning to its back).
const previews: Record<string, { src: string; end?: number }> = {
  "stori-inversion-plus": { src: "/videos/stori-inversion-plus-confident-investor-after-desktop.mp4" },
  "karta-card": { src: "/videos/karta-card-black-card-reveal-after.mp4", end: 2.3 },
};

const tiles = slugs.flatMap((slug, i) => {
  const p = projects.find((x) => x.slug === slug);
  if (!p) return [];
  const ba = homeBeforeAfter.find((x) => x.slug === slug);
  const copy = homeWorkCopy[lang][slug];
  const impact =
    lang === "es" ? (copy?.impact ?? ba?.impact ?? p.impact) : (ba?.impact ?? p.impact);
  return [
    {
      slug,
      size: sizes[i],
      name: ba?.brand ?? p.brand,
      alt: p.title,
      image: p.image,
      impact,
      tags: copy?.tags ?? [],
      preview: previews[slug],
    },
  ];
});
---

<section id="work" aria-labelledby="work-heading" class="case-grid" data-case-grid>
  <div class="container-page">
    <div class="cg-head">
      <div class="cg-head-copy">
        <h2 id="work-heading" class="display-serif cg-title">
          {t.work.title} {t.work.titleEm}
        </h2>
      </div>
      <a href="/projects/" class="btn-outline cg-all">{t.work.all}</a>
    </div>

    <ul class="cg-list">
      {
        tiles.map((tile, i) => (
          <li class={`cg-tile cg-${tile.size}`}>
            <a href={`/projects/${tile.slug}/`} class="cg-link">
              <span class="cg-media">
                <Image
                  src={tile.image}
                  alt={tile.alt}
                  widths={tile.size === "s" ? [480, 720, 960] : [720, 1080, 1440, 1920]}
                  sizes={sizesAttr[tile.size]}
                  loading="lazy"
                  class="cg-img"
                />
                {tile.preview && (
                  <>
                    <video
                      class="cg-video"
                      data-src={tile.preview.src}
                      data-end={tile.preview.end}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                    />
                  </>
                )}
              </span>
              <span class="cg-meta">
                <span class="cg-name">{tile.name}</span>
                <span class="cg-impact">{tile.impact}</span>
                {tile.tags.length > 0 && (
                  <span class="cg-tags">
                    {tile.tags.map((tag) => (
                      <span class="cg-tag">{tag}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="cg-cursor mono" aria-hidden="true">{t.work.viewCase}</span>
</section>

<script>
  import { loopUntil } from "~/lib/clip-end";
  /*
   * Desktop-only hover, after Aerolab: a "View case" disc pinned exactly to
   * the pointer (no easing lag) that fades in and vanishes at once on exit;
   * cases with footage swap the still for a muted preview playing beneath
   * it. No zoom. Touch devices get none of it.
   */
  function initCaseGrid() {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    document.querySelectorAll<HTMLElement>("[data-case-grid]").forEach((grid) => {
      if (grid.dataset.ready || !fine.matches) return;
      grid.dataset.ready = "1";
      grid.setAttribute("data-cursor", "");
      const cursor = grid.querySelector<HTMLElement>(".cg-cursor");
      let x = 0, y = 0, raf = 0;
      let over: HTMLElement | null = null;
      const paint = () => {
        raf = 0;
        if (cursor) cursor.style.translate = `${x}px ${y}px`;
      };
      const move = (e: PointerEvent) => {
        x = e.clientX;
        y = e.clientY;
        if (!raf) raf = requestAnimationFrame(paint);
      };

      const links = Array.from(grid.querySelectorAll<HTMLElement>(".cg-link"));
      const leave = (link: HTMLElement) => {
        if (over === link) over = null;
        if (!over) cursor?.classList.remove("is-on");
        const media = link.querySelector<HTMLElement>(".cg-media");
        const video = media?.querySelector<HTMLVideoElement>(".cg-video");
        media?.classList.remove("is-playing");
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
      };

      links.forEach((link) => {
        const media = link.querySelector<HTMLElement>(".cg-media");
        const video = media?.querySelector<HTMLVideoElement>(".cg-video");
        if (video?.dataset.end) loopUntil(video, Number(video.dataset.end));
        link.addEventListener("pointerenter", (e) => {
          over = link;
          move(e);
          paint();
          cursor?.classList.add("is-on");
          if (video && media && !reduced.matches) {
            if (!video.src && video.dataset.src) video.src = video.dataset.src;
            video
              .play()
              .then(() => {
                if (over === link) media.classList.add("is-playing");
              })
              .catch(() => {});
          }
        });
        link.addEventListener("pointermove", move);
        link.addEventListener("pointerleave", () => leave(link));
      });

      // Wheel-scrolling moves the card out from under a still pointer
      // without a pointerleave: drop the hover once it no longer matches.
      window.addEventListener(
        "scroll",
        () => {
          if (over && !over.matches(":hover")) leave(over);
        },
        { passive: true },
      );
    });
  }
  initCaseGrid();
  document.addEventListener("astro:page-load", initCaseGrid);
</script>

<style>
  .case-grid {
    padding-block: 4.5rem 5rem;
    background: var(--color-paper);
    /* Hero "See the work" jumps here — clear the sticky header. */
    scroll-margin-top: 5.5rem;
  }
  @media (min-width: 768px) {
    .case-grid {
      padding-block: 7.5rem 8rem;
    }
  }

  .cg-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .cg-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 4.5rem;
    }
  }
  .cg-head-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cg-title {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    max-width: 16ch;
  }
  .cg-all {
    flex-shrink: 0;
  }

  /* Grid: 3 columns, small = 1 col, large = 2 cols, full = 3 cols. */
  .cg-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 3rem;
  }
  @media (min-width: 768px) {
    .cg-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.125rem;
      row-gap: 4.5rem;
      align-items: start;
    }
    .cg-s {
      grid-column: span 1;
    }
    .cg-l {
      grid-column: span 2;
    }
    .cg-f {
      grid-column: 1 / -1;
    }
  }

  .cg-link {
    display: block;
    color: var(--color-ink);
  }
  .cg-media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-grey);
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 768px) {
    .cg-s .cg-media,
    .cg-l .cg-media {
      aspect-ratio: 16 / 9;
    }
    .cg-f .cg-media {
      aspect-ratio: 2 / 1;
    }
  }
  .cg-media :global(.cg-img) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.15s ease-in-out;
  }
  /* The preview plays beneath the still; the still steps aside. */
  .cg-media.is-playing :global(.cg-img) {
    opacity: 0;
  }

  .cg-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .cg-name {
    flex-basis: 100%;
    font-size: clamp(1.375rem, 1.8vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .cg-impact {
    font-size: 0.875rem;
    color: var(--color-muted);
    letter-spacing: -0.01em;
  }
  .cg-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .cg-tag {
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }
  .cg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* "View case" disc (desktop, fine pointer only): pinned to the pointer,
     fades in, gone the instant the pointer leaves the card. */
  .cg-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    display: none;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    margin: -2.75rem 0 0 -2.75rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    pointer-events: none;
    opacity: 0;
  }
  [data-cursor] .cg-cursor {
    display: grid;
  }
  [data-cursor] .cg-link {
    cursor: none;
  }
  .cg-cursor.is-on {
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .cg-name::after {
    content: "";
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.5rem;
    vertical-align: middle;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .cg-link:hover .cg-name::after {
    opacity: 1;
    transform: none;
  }
</style>
