---
/*
 * Home B: "Design measured in business metrics" as a pinned showcase
 * (ArchiPro "Project Portfolio" pattern). Desktop: a full-screen dark
 * stage pins while scrolling; each step swaps the whole item — big figure,
 * line, "Read the case" on the left, one tall cover on the right — with a
 * 01 —— / 04 counter whose rule fills with scroll.
 * Phones, reduced motion and no-JS: the items stack in flow.
 */
import { Image } from "astro:assets";
import { homeImpact } from "~/data/home-work-i18n";
import { projects } from "~/data/projects";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const LOGOS: Record<string, string> = {
  "stori-inversion-plus": "/images/logo-stori.png",
  "mipos-kiosk": "/images/mipos-logo.svg",
  "legalario-e-signature": "/images/logo-legalario.png",
  rebajatuscuentas: "/images/rebajatuscuentas-logo.svg",
};
const items = homeImpact[lang].map((s) => ({
  ...s,
  image: projects.find((p) => p.slug === s.slug)?.image,
  logo: LOGOS[s.slug],
}));
const pad = (v: number) => String(v).padStart(2, "0");
---

<section aria-labelledby="impact-heading" class="isc" data-isc data-dark-zone style={`--n: ${items.length};`}>
  <div class="isc-stage">
    <h2 id="impact-heading" class="isc-eyebrow mono">
      {t.impact.title} {t.impact.titleEm}
    </h2>

    <ol class="isc-items">
      {
        items.map((it, i) => (
          <li class="isc-item" data-item={i} data-active={i === 0 ? "" : undefined}>
            <div class="isc-copy">
              {it.logo ? <img src={it.logo} alt={it.brand} class="isc-logo" loading="lazy" decoding="async" /> : <p>{it.brand}</p>}
              <p class="isc-value">{it.value}</p>
              <p class="isc-label">{it.label}</p>
              <a href={`/projects/${it.slug}/`} class="isc-btn">
                {t.impact.readCase}
              </a>
            </div>
            <div class="isc-cover">
              {it.image && (
                <Image
                  src={it.image}
                  alt=""
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 900px) 34vw, 100vw"
                  loading="lazy"
                  class="isc-img"
                />
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <p class="isc-count" aria-hidden="true">
      <span data-isc-count>01</span>
      <span class="isc-rule"><span data-isc-fill /></span>
      <span>/ {pad(items.length)}</span>
    </p>
  </div>
</section>

<script>
  const PIN = "(min-width: 900px) and (prefers-reduced-motion: no-preference)";
  document.querySelectorAll<HTMLElement>("[data-isc]").forEach((sec) => {
    const items = Array.from(sec.querySelectorAll<HTMLElement>("[data-item]"));
    const count = sec.querySelector<HTMLElement>("[data-isc-count]");
    const fill = sec.querySelector<HTMLElement>("[data-isc-fill]");
    const stage = sec.querySelector<HTMLElement>(".isc-stage")!;
    const mq = window.matchMedia(PIN);
    const n = items.length;
    let active = 0;
    let raf = 0;

    const set = (i: number) => {
      if (i === active) return;
      active = i;
      items.forEach((it, j) => {
        it.toggleAttribute("data-active", j === i);
        it.toggleAttribute("data-past", j < i);
      });
      if (count) count.textContent = String(i + 1).padStart(2, "0");
    };
    const paint = () => {
      raf = 0;
      if (!mq.matches) return;
      const r = sec.getBoundingClientRect();
      const travel = r.height - stage.offsetHeight;
      const p = travel > 0 ? Math.min(Math.max(-r.top / travel, 0), 0.9999) : 0;
      fill?.style.setProperty("--p", String(p));
      set(Math.floor(p * n));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(paint);
    };
    const apply = () => {
      sec.toggleAttribute("data-pinned", mq.matches);
      paint();
    };
    mq.addEventListener("change", apply);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    apply();
  });
</script>

<style>
  .isc {
    --isc-bg: #151515;
    background: var(--isc-bg);
    color: var(--color-paper);
  }

  /* ---------- Default (phones, reduced motion, no JS): stacked ---------- */
  .isc-stage {
    padding: 4.5rem 1.25rem;
  }
  .isc-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }
  .isc-items {
    margin-top: 2rem;
    display: grid;
    gap: 3.5rem;
  }
  .isc-item {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.5rem;
  }
  .isc-logo {
    display: block;
    width: auto;
    max-width: 9rem;
    height: 1.625rem;
    object-fit: contain;
    object-position: left center;
    filter: brightness(0) invert(1);
  }
  .isc-value {
    margin-top: 1.25rem;
    font-size: clamp(4.5rem, 18vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .isc-label {
    margin-top: 1rem;
    max-width: 24ch;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: rgb(255 255 255 / 0.85);
  }
  .isc-btn {
    margin-top: 1.75rem;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 9999px;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }
  .isc-btn:hover {
    background: var(--color-accent);
  }
  .isc-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .isc-copy {
    display: flex;
    flex-direction: column;
  }
  /* Phones: a shorter crop keeps the four stacked items scannable. */
  .isc-cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.06);
  }
  .isc-cover :global(.isc-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .isc-count {
    display: none;
  }

  /* ---------- Pinned showcase (desktop + motion OK) ---------- */
  @media (min-width: 900px) {
    .isc[data-pinned] {
      height: calc(var(--n) * 100svh);
    }
    .isc[data-pinned] .isc-stage {
      position: sticky;
      top: 0;
      height: 100svh;
      padding: 6rem clamp(1.5rem, 3vw, 2.5rem) 2.5rem;
      overflow: hidden;
    }
    .isc[data-pinned] .isc-items {
      position: absolute;
      inset: 0;
      margin: 0;
      display: block;
    }
    .isc[data-pinned] .isc-item {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
      padding: 6rem clamp(1.5rem, 3vw, 2.5rem) 5rem;
      pointer-events: none;
    }
    .isc[data-pinned] .isc-item[data-active] {
      pointer-events: auto;
    }
    .isc[data-pinned] .isc-value {
      font-size: clamp(6rem, 11vw, 11rem);
      margin-top: 1.75rem;
    }
    .isc[data-pinned] .isc-label {
      font-size: clamp(1.25rem, 1.6vw, 1.625rem);
      max-width: 26ch;
    }
    .isc[data-pinned] .isc-btn {
      margin-top: 2.5rem;
    }
    .isc[data-pinned] .isc-cover {
      aspect-ratio: 4 / 5;
      justify-self: center;
      width: min(100%, 36rem, calc((100svh - 13rem) * 0.8));
      max-height: calc(100svh - 13rem);
    }

    /* Swap: copy fades and rises in; the cover slides up from below and
       the previous one drifts up and away. */
    .isc[data-pinned] .isc-copy > * {
      opacity: 0;
      transform: translateY(1.25rem);
      transition:
        opacity 0.45s ease,
        transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .isc[data-pinned] .isc-item[data-active] .isc-copy > * {
      opacity: 1;
      transform: none;
    }
    .isc[data-pinned] .isc-item[data-active] .isc-copy > :nth-child(2) {
      transition-delay: 0.05s;
    }
    .isc[data-pinned] .isc-item[data-active] .isc-copy > :nth-child(3) {
      transition-delay: 0.1s;
    }
    .isc[data-pinned] .isc-item[data-active] .isc-copy > :nth-child(4) {
      transition-delay: 0.15s;
    }
    .isc[data-pinned] .isc-cover {
      opacity: 0;
      transform: translateY(12%);
      transition:
        opacity 0.5s ease,
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .isc[data-pinned] .isc-item[data-past] .isc-cover {
      transform: translateY(-12%);
    }
    .isc[data-pinned] .isc-item[data-active] .isc-cover {
      opacity: 1;
      transform: none;
    }

    .isc[data-pinned] .isc-count {
      position: absolute;
      left: clamp(1.5rem, 3vw, 2.5rem);
      bottom: 2.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      width: min(22rem, 30vw);
      font-size: 1rem;
      font-variant-numeric: tabular-nums;
    }
    .isc-rule {
      position: relative;
      flex: 1;
      height: 1px;
      background: rgb(255 255 255 / 0.2);
    }
    .isc-rule > span {
      position: absolute;
      inset: 0;
      background: var(--color-paper);
      transform: scaleX(var(--p, 0));
      transform-origin: left;
    }
  }
</style>
