---
import { getImage } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/home/Hero.astro";
import ClientsStrip from "~/components/home/ClientsStrip.astro";
import CaseGrid from "~/components/home/CaseGrid.astro";
import { HOME_CASE_SLUGS } from "~/data/home-work-i18n";
import Method from "~/components/home/Method.astro";
import Testimonials from "~/components/home/Testimonials.astro";
import Studio from "~/components/home/Studio.astro";
import FinalCTA from "~/components/home/FinalCTA.astro";
import HomeFaq from "~/components/home/HomeFaq.astro";
import Statement from "~/components/home/Statement.astro";
import { homeFaq } from "~/i18n/home-faq";
import { site } from "~/lib/site";
import { ui, type Lang } from "~/i18n";
import { homeBeforeAfter } from "~/data/home-before-after";
import { projects } from "~/data/projects";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const homeUrl = lang === "es" ? `${site.url}/es/` : `${site.url}/`;

// Resolve every showcased project's after-image to a stable WebP URL so
// Google can index it directly from the home ItemList.
const listItems = await Promise.all(
  HOME_CASE_SLUGS.map((slug) => homeBeforeAfter.find((it) => it.slug === slug)!)
    .map(async (it, i) => {
    const project = projects.find((p) => p.slug === it.slug);
    const variant = await getImage({
      src: it.after,
      width: 1200,
      format: "webp",
    });
    return {
      "@type": "ListItem" as const,
      position: i + 1,
      url: `${site.url}/projects/${it.slug}/`,
      item: {
        "@type": "CreativeWork" as const,
        name: project?.title ?? `${it.brand} — ${it.tagline}`,
        url: `${site.url}/projects/${it.slug}/`,
        description: it.tagline,
        about: it.brand,
        image: new URL(variant.src, site.url).toString(),
        creator: { "@id": `${site.url}/#person` },
      },
    };
  }),
);

const homeOg = await getImage({
  src: homeBeforeAfter[0].after,
  width: 1200,
  format: "webp",
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: homeUrl,
    inLanguage: lang,
    description: t.meta.homeDescription,
    publisher: { "@id": `${site.url}/#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: site.person.name,
    alternateName: site.person.alternateName,
    jobTitle: site.person.jobTitle,
    url: `${site.url}/`,
    worksFor: { "@id": `${site.url}/#organization` },
    sameAs: [site.social.linkedin, site.social.x],
    knowsAbout: [
      "Product design",
      "Product strategy",
      "UX research",
      "Design systems",
      "FinTech product design",
      "SaaS product design",
      "AI product design",
      "LATAM product design",
    ],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Mexico City",
      addressCountry: "MX",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "ProfessionalService"],
    "@id": `${site.url}/#organization`,
    name: site.name,
    url: `${site.url}/`,
    image: new URL("/og-default.png", site.url).toString(),
    address: {
      "@type": "PostalAddress",
      addressLocality: "Mexico City",
      addressCountry: "MX",
    },
    areaServed: ["MX", "LATAM"],
    founder: { "@id": `${site.url}/#person` },
    logo: new URL("/images/Logo-Comandos.svg", site.url).toString(),
    sameAs: [site.social.linkedin, site.social.x],
    description: site.description,
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "c@comandos.me",
      areaServed: ["MX", "LATAM"],
      availableLanguage: ["en", "es"],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Before / After Comandos — featured product design case studies",
    description:
      "Curated product-design transformations across FinTech, SaaS, IoT, PropTech and FoodTech in LATAM — each links to the full case study.",
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    numberOfItems: listItems.length,
    itemListElement: listItems,
  },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq[lang].items.map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: it.a },
  })),
};
---

<BaseLayout
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  alternates={{ en: "/", es: "/es/" }}
  image={homeOg.src}
  imageAlt={`${homeBeforeAfter[0].brand} — ${homeBeforeAfter[0].tagline}. Product design case study by Carlos Comandos.`}
  jsonLd={[...jsonLd, faqLd]}
>
  {/* LCP: the hero poster is a CSS background + <video poster>, which the
       preload scanner can't discover early. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/videos/hero-poster.jpg"
    fetchpriority="high"
  />
  <Hero lang={lang} />
  <ClientsStrip lang={lang} />
  <Statement lang={lang} />
  <CaseGrid lang={lang} />
  <Method lang={lang} />
  <Testimonials lang={lang} />
  <Studio lang={lang} />
  <HomeFaq lang={lang} />
  <FinalCTA lang={lang} />
</BaseLayout>
