---
import { Image } from "astro:assets";
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import { ui, type Lang } from "~/i18n";
import uxAudit from "~/assets/images/methodology/comandos-north-face-growth-UXAudit.svg";
import strategy from "~/assets/images/methodology/comandos-product-strategy.svg";
import mvp from "~/assets/images/methodology/comandos-product-mvp.svg";
import testing from "~/assets/images/methodology/comandos-testing-and-experimentation.svg";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
const art = [uxAudit, strategy, mvp, testing];
---

<section id="method" aria-labelledby="method-heading" class="method">
  <div class="container-page">
    <div class="method-head">
      <p class="eyebrow">{t.method.eyebrow}</p>
      <h2 id="method-heading" class="display-serif method-title">
        {t.method.title}<br /><em>{t.method.titleEm}</em>
      </h2>
      <p class="method-sub">{t.method.sub}</p>
    </div>

    <ol class="method-steps">
      {
        t.method.steps.map((step, i) => (
          <li class="method-step">
            <div class="method-art">
              <Image src={art[i]} alt="" loading="lazy" class="method-img" />
            </div>
            <span class="method-num">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="method-step-title">{step.title}</h3>
            <p class="method-step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <a href="/north-face-growth/" class="btn-outline method-cta">
      {t.method.cta}
      <ArrowIcon />
    </a>
  </div>
</section>

<style>
  .method {
    padding-block: 5rem;
    background: var(--color-paper);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 768px) {
    .method {
      padding-block: 7.5rem;
    }
  }
  .method-head {
    max-width: 44rem;
    margin-bottom: 3.5rem;
  }
  .method-title {
    margin-top: 0.85rem;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .method-sub {
    margin-top: 1.25rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 34rem;
  }

  .method-steps {
    display: grid;
    gap: 2.5rem;
    counter-reset: step;
  }
  @media (min-width: 640px) {
    .method-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
  }
  @media (min-width: 1024px) {
    .method-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .method-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ink);
  }
  .method-art {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background: var(--color-paper-warm);
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }
  .method-img {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }
  .method-num {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.06em;
  }
  .method-step-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .method-step-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .method-cta {
    margin-top: 3rem;
  }
</style>
