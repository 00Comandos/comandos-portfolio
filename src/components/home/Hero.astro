---
import ArrowIcon from "~/components/ui/ArrowIcon.astro";

const VIDEO_DESKTOP = "/videos/hero-desktop.mp4";
const VIDEO_MOBILE = "/videos/hero-mobile.mp4";
const VIDEO_POSTER = "/videos/hero-poster.jpg";
const VIDEO_POSTER_MOBILE = "/videos/hero-poster-mobile.jpg";

// Reel rounds per track — `until` is the second each round ends. The brand
// chip syncs to the playing video via timeupdate. Update when the reel
// composition changes.
const ROUNDS = {
  desktop: [
    { until: 12.54, label: "Credit Card", logo: "/images/logo-karta.png", href: "/projects/karta-card/", brand: "Karta" },
    { until: 19.6, label: "Inversión+", logo: "/images/logo-stori.png", href: "/projects/stori-inversion-plus/", brand: "Stori" },
    { until: 28.64, label: "Dark Kitchen", logo: "/images/mipos-logo.svg", href: "/projects/mipos-dark-kitchen/", brand: "mipOS" },
    { until: 36.71, label: "TruConnect", logo: "/images/Truora-Logo.svg", href: "/projects/truora-truconnect/", brand: "Truora" },
  ],
  mobile: [
    { until: 12.08, label: "Credit Card", logo: "/images/logo-karta.png", href: "/projects/karta-card/", brand: "Karta" },
    { until: 20.13, label: "Inversión+", logo: "/images/logo-stori.png", href: "/projects/stori-inversion-plus/", brand: "Stori" },
    { until: 29.17, label: "Dark Kitchen", logo: "/images/mipos-logo.svg", href: "/projects/mipos-dark-kitchen/", brand: "mipOS" },
    { until: 36.21, label: "TruConnect", logo: "/images/Truora-Logo.svg", href: "/projects/truora-truconnect/", brand: "Truora" },
  ],
};
---

<section class="hero" data-hero-overlap>
  <div class="hero-frame">
    <div class="hero-media">
      <video
        class="hero-video"
        poster={VIDEO_POSTER}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src={VIDEO_MOBILE} media="(max-width: 767px)" />
        <source src={VIDEO_DESKTOP} />
      </video>
      <script define:vars={{ mobilePoster: VIDEO_POSTER_MOBILE }}>
        // The poster attribute can't respond to media queries — swap in the
        // portrait first-frame on phones so poster and reel match.
        if (window.matchMedia("(max-width: 767px)").matches) {
          document.querySelector(".hero-video")?.setAttribute("poster", mobilePoster);
        }
      </script>

      <button
        class="hero-pause"
        id="heroPause"
        type="button"
        aria-label="Pause video"
        aria-pressed="false"
      >
        <svg class="icon-pause" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <rect x="3" y="2" width="3.5" height="12" rx="1" />
          <rect x="9.5" y="2" width="3.5" height="12" rx="1" />
        </svg>
        <svg class="icon-play" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M4.5 2.7a1 1 0 0 1 1.53-.85l8.1 5.3a1 1 0 0 1 0 1.7l-8.1 5.3a1 1 0 0 1-1.53-.85V2.7Z" />
        </svg>
      </button>
      <script>
        const pauseBtn = document.getElementById("heroPause");
        const heroVideo = document.querySelector<HTMLVideoElement>(".hero-video");
        if (pauseBtn && heroVideo) {
          pauseBtn.addEventListener("click", () => {
            const paused = heroVideo.paused;
            if (paused) heroVideo.play().catch(() => {});
            else heroVideo.pause();
            pauseBtn.setAttribute("aria-pressed", String(!paused));
            pauseBtn.setAttribute(
              "aria-label",
              paused ? "Pause video" : "Play video",
            );
          });
        }
      </script>

      <a class="hero-brand" id="heroBrand" href="/projects/">
        <img id="heroBrandLogo" src="" alt="" height="14" />
        <span id="heroBrandLabel"></span>
      </a>
      <script define:vars={{ rounds: ROUNDS }}>
        const video = document.querySelector(".hero-video");
        const chip = document.getElementById("heroBrand");
        const logo = document.getElementById("heroBrandLogo");
        const label = document.getElementById("heroBrandLabel");
        if (video && chip && logo && label) {
          let current = null;
          const update = () => {
            const track = (video.currentSrc || "").includes("hero-mobile")
              ? rounds.mobile
              : rounds.desktop;
            const t = video.currentTime;
            const round = track.find((r) => t < r.until) ?? track[track.length - 1];
            if (round && round !== current) {
              current = round;
              chip.classList.add("is-swapping");
              setTimeout(() => {
                chip.href = round.href;
                logo.src = round.logo;
                logo.alt = round.brand;
                label.textContent = round.label;
                chip.classList.remove("is-swapping");
              }, 150);
            }
          };
          video.addEventListener("timeupdate", update);
          video.addEventListener("loadedmetadata", update);
          update();
        }
      </script>
      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <h1 class="hero-headline">
          We turn product chaos <br class="hidden md:block" />
          into <em>measurable&nbsp;growth.</em>
        </h1>

        <p class="hero-sub">
          Product design for FinTech and SaaS founders shipping from Mexico
          City to the world. User research, product strategy, design systems,
          and growth — backed by data and experimentation.
        </p>

        <div class="hero-cta">
          <a href="/contact" class="btn-primary">
            Start a project
            <span class="arrow"><ArrowIcon /></span>
          </a>
          <a href="#before-after" class="hero-scroll">See the work</a>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-paper-soft);
  }

  /* Full-bleed on every viewport: the reel slides under the transparent
     header so the first screen is 100% video, Tesla-style. */
  .hero-frame {
    padding: 0;
    /* Header is 5rem tall plus a 1px border on mobile — pull past both. */
    margin-top: calc(-5rem - 1px);
  }
  @media (min-width: 768px) {
    .hero-frame {
      margin-top: -5rem;
    }
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility scrims: strong at the bottom-left where the copy sits,
     soft at the top so the inverted header stays readable over light
     footage. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.32) 0%, transparent 16%),
      linear-gradient(
        to top,
        rgb(0 0 0 / 0.62) 0%,
        rgb(0 0 0 / 0.28) 45%,
        rgb(0 0 0 / 0.12) 100%
      );
  }

  /* Same grid as .container-page (logo/body): the card is inset by the
     frame padding, so the inline padding here is container-page's minus
     that inset — copy lines up with the logo at every width. */
  .hero-content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    /* Extra bottom room on mobile so the pause + brand cluster gets its
       own row under the CTAs. */
    padding: 2rem 1.25rem 6.5rem;
  }
  /* Frame padding is 0 on desktop, so the content mirrors .container-page
     exactly (max-width 1200 + 2rem inline padding) to stay on the grid. */
  @media (min-width: 768px) {
    .hero-content {
      max-width: 1200px;
      padding: 3rem 2rem 3.5rem;
    }
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(2.625rem, 6.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: #fff;
    max-width: 22ch;
  }
  .hero-headline em {
    font-style: italic;
    font-family: var(--font-serif);
    color: #fff;
  }

  .hero-sub {
    margin-top: 1.75rem;
    max-width: 38rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
  }
  @media (min-width: 768px) {
    .hero-sub {
      font-size: 1.125rem;
    }
  }

  .hero-cta {
    margin-top: 2.25rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  /* Inverted button over the dark video, mirroring the reference */
  .hero .hero-cta :global(.btn-primary) {
    background-color: #fff;
    color: var(--color-ink);
  }
  .hero .hero-cta :global(.btn-primary:hover) {
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.55);
  }

  .hero-scroll {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .hero-scroll:hover {
    border-bottom-color: #fff;
  }

  /* Pause/play — reference style: translucent dark square, white icon.
     Right edge rides the container-page grid so it lines up with the
     burger; bottom lines up with the "Start a project" row. */
  .hero-pause {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 8px;
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }
  .hero-pause:hover {
    background: rgb(0 0 0 / 0.55);
  }
  .hero-pause .icon-play {
    display: none;
  }
  .hero-pause[aria-pressed="true"] .icon-pause {
    display: none;
  }
  .hero-pause[aria-pressed="true"] .icon-play {
    display: block;
  }
  @media (min-width: 768px) {
    .hero-pause {
      right: max(calc((100% - 1200px) / 2 + 2rem), 2rem);
      bottom: 3.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-pause {
      display: none;
    }
  }

  /* Brand chip — which client round is playing, links to its case study.
     No pill: white logo + label straight over the scrim, sitting on the
     same row as the "Start a project" CTA, left of the pause control. */
  .hero-brand {
    position: absolute;
    right: calc(1.25rem + 48px + 14px);
    bottom: 1.25rem;
    z-index: 2;
    height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: #fff;
    opacity: 1;
    transition: opacity 0.15s ease;
  }
  .hero-brand:hover {
    opacity: 0.8;
  }
  .hero-brand.is-swapping {
    opacity: 0;
  }
  .hero-brand img {
    display: block;
    height: 15px;
    width: auto;
    /* Client logos ship dark — force them white over the reel. */
    filter: brightness(0) invert(1);
  }
  @media (min-width: 768px) {
    .hero-brand {
      right: calc(max(calc((100% - 1200px) / 2 + 2rem), 2rem) + 48px + 16px);
      bottom: 3.5rem;
      font-size: 0.85rem;
    }
    .hero-brand img {
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-media {
      background: #111;
    }
    .hero-brand {
      display: none;
    }
  }
</style>
