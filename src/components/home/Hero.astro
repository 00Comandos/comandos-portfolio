---
import ArrowIcon from "~/components/ui/ArrowIcon.astro";

const VIDEO_DESKTOP = "/videos/hero-desktop.mp4";
const VIDEO_MOBILE = "/videos/hero-mobile.mp4";
const VIDEO_POSTER = "/videos/hero-poster.jpg";
const VIDEO_POSTER_MOBILE = "/videos/hero-poster-mobile.jpg";

// Reel rounds per track — `until` is the second each round ends. The brand
// chip syncs to the playing video via timeupdate. Update when the reel
// composition changes.
const ROUNDS = {
  desktop: [
    { until: 12.54, label: "Credit Card", logo: "/images/logo-karta.png", href: "/projects/karta-card/", brand: "Karta" },
    { until: 19.6, label: "Inversión+", logo: "/images/logo-stori.png", href: "/projects/stori-inversion-plus/", brand: "Stori" },
    { until: 28.64, label: "Dark Kitchen", logo: "/images/mipos-logo.svg", href: "/projects/mipos-dark-kitchen/", brand: "mipOS" },
    { until: 36.71, label: "TruConnect", logo: "/images/Truora-Logo.svg", href: "/projects/truora-truconnect/", brand: "Truora" },
  ],
  mobile: [
    { until: 12.08, label: "Credit Card", logo: "/images/logo-karta.png", href: "/projects/karta-card/", brand: "Karta" },
    { until: 20.13, label: "Inversión+", logo: "/images/logo-stori.png", href: "/projects/stori-inversion-plus/", brand: "Stori" },
    { until: 29.17, label: "Dark Kitchen", logo: "/images/mipos-logo.svg", href: "/projects/mipos-dark-kitchen/", brand: "mipOS" },
    { until: 36.21, label: "TruConnect", logo: "/images/Truora-Logo.svg", href: "/projects/truora-truconnect/", brand: "Truora" },
  ],
};
---

<section class="hero">
  <div class="hero-frame">
    <div class="hero-media">
      <video
        class="hero-video"
        poster={VIDEO_POSTER}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src={VIDEO_MOBILE} media="(max-width: 767px)" />
        <source src={VIDEO_DESKTOP} />
      </video>
      <script define:vars={{ mobilePoster: VIDEO_POSTER_MOBILE }}>
        // The poster attribute can't respond to media queries — swap in the
        // portrait first-frame on phones so poster and reel match.
        if (window.matchMedia("(max-width: 767px)").matches) {
          document.querySelector(".hero-video")?.setAttribute("poster", mobilePoster);
        }
      </script>

      <a class="hero-brand" id="heroBrand" href="/projects/">
        <img id="heroBrandLogo" src="" alt="" height="14" />
        <span id="heroBrandLabel"></span>
      </a>
      <script define:vars={{ rounds: ROUNDS }}>
        const video = document.querySelector(".hero-video");
        const chip = document.getElementById("heroBrand");
        const logo = document.getElementById("heroBrandLogo");
        const label = document.getElementById("heroBrandLabel");
        if (video && chip && logo && label) {
          let current = null;
          const update = () => {
            const track = (video.currentSrc || "").includes("hero-mobile")
              ? rounds.mobile
              : rounds.desktop;
            const t = video.currentTime;
            const round = track.find((r) => t < r.until) ?? track[track.length - 1];
            if (round && round !== current) {
              current = round;
              chip.classList.add("is-swapping");
              setTimeout(() => {
                chip.href = round.href;
                logo.src = round.logo;
                logo.alt = round.brand;
                label.textContent = round.label;
                chip.classList.remove("is-swapping");
              }, 150);
            }
          };
          video.addEventListener("timeupdate", update);
          video.addEventListener("loadedmetadata", update);
          update();
        }
      </script>
      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <h1 class="hero-headline">
          We turn product chaos <br class="hidden md:block" />
          into <em>measurable&nbsp;growth.</em>
        </h1>

        <p class="hero-sub">
          Product design for FinTech and SaaS founders shipping from Mexico
          City to the world. User research, product strategy, design systems,
          and growth — backed by data and experimentation.
        </p>

        <div class="hero-cta">
          <a href="/contact" class="btn-primary">
            Start a project
            <span class="arrow"><ArrowIcon /></span>
          </a>
          <a href="#before-after" class="hero-scroll">See the work</a>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-paper-soft);
  }

  .hero-frame {
    padding: 0.5rem 0.75rem 0;
  }
  @media (min-width: 768px) {
    .hero-frame {
      padding: 0 1rem;
    }
  }

  /* Reference proportion: card ≈ 74% of the viewport height so the next
     section (clients strip) peeks above the fold. */
  .hero-media {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    min-height: calc(74svh + 115px);
    display: flex;
    align-items: flex-end;
  }
  @media (min-width: 768px) {
    .hero-media {
      min-height: calc(74svh + 115px);
      border-radius: 20px;
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legibility scrim: stronger at the bottom-left where the copy sits */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgb(0 0 0 / 0.62) 0%,
        rgb(0 0 0 / 0.28) 45%,
        rgb(0 0 0 / 0.12) 100%
      );
  }

  /* Same grid as .container-page (logo/body): the card is inset by the
     frame padding, so the inline padding here is container-page's minus
     that inset — copy lines up with the logo at every width. */
  .hero-content {
    position: relative;
    width: 100%;
    max-width: calc(1200px - 2rem);
    margin-inline: auto;
    padding: 2rem 0.5rem 2.5rem;
  }
  @media (min-width: 768px) {
    .hero-content {
      padding: 3rem 1rem 3.5rem;
    }
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: normal;
    font-size: clamp(2.375rem, 6.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: #fff;
    max-width: 22ch;
  }
  .hero-headline em {
    font-style: italic;
    font-family: var(--font-serif);
    color: #fff;
  }

  .hero-sub {
    margin-top: 1.75rem;
    max-width: 38rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
  }
  @media (min-width: 768px) {
    .hero-sub {
      font-size: 1.125rem;
    }
  }

  .hero-cta {
    margin-top: 2.25rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  /* Inverted button over the dark video, mirroring the reference */
  .hero .hero-cta :global(.btn-primary) {
    background-color: #fff;
    color: var(--color-ink);
  }
  .hero .hero-cta :global(.btn-primary:hover) {
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.55);
  }

  .hero-scroll {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .hero-scroll:hover {
    border-bottom-color: #fff;
  }

  /* Brand chip — which client round is playing, links to its case study */
  .hero-brand {
    position: absolute;
    right: 1rem;
    top: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.88);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ink);
    opacity: 1;
    transition: opacity 0.15s ease, transform 0.2s ease;
  }
  .hero-brand:hover {
    transform: translateY(-1px);
  }
  .hero-brand.is-swapping {
    opacity: 0;
  }
  .hero-brand img {
    display: block;
    height: 14px;
    width: auto;
  }
  @media (min-width: 768px) {
    .hero-brand {
      top: auto;
      bottom: 1.5rem;
      right: 1.5rem;
      font-size: 0.82rem;
      padding: 0.5rem 1rem;
    }
    .hero-brand img {
      height: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-media {
      background: #111;
    }
    .hero-brand {
      display: none;
    }
  }
</style>
