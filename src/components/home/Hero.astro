---
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];

const VIDEO_DESKTOP = "/videos/hero-desktop.mp4";
const VIDEO_MOBILE = "/videos/hero-mobile.mp4";
const VIDEO_POSTER = "/videos/hero-poster.jpg";
const VIDEO_POSTER_MOBILE = "/videos/hero-poster-mobile.jpg";

// Reel rounds per track — `until` is the second each round ends. The brand
// chip syncs to the playing video via timeupdate. Update when the reel
// composition changes.
const ROUNDS = {
  desktop: [
    { until: 12.54, label: "Credit Card", logo: "/images/logo-karta.png", href: "/projects/karta-card/", brand: "Karta" },
    { until: 19.6, label: "Inversión+", logo: "/images/logo-stori.png", href: "/projects/stori-inversion-plus/", brand: "Stori" },
    { until: 28.64, label: "Dark Kitchen", logo: "/images/mipos-logo.svg", href: "/projects/mipos-dark-kitchen/", brand: "mipOS" },
    { until: 36.71, label: "TruConnect", logo: "/images/Truora-Logo.svg", href: "/projects/truora-truconnect/", brand: "Truora" },
  ],
  mobile: [
    { until: 12.08, label: "Credit Card", logo: "/images/logo-karta.png", href: "/projects/karta-card/", brand: "Karta" },
    { until: 20.13, label: "Inversión+", logo: "/images/logo-stori.png", href: "/projects/stori-inversion-plus/", brand: "Stori" },
    { until: 29.17, label: "Dark Kitchen", logo: "/images/mipos-logo.svg", href: "/projects/mipos-dark-kitchen/", brand: "mipOS" },
    { until: 36.21, label: "TruConnect", logo: "/images/Truora-Logo.svg", href: "/projects/truora-truconnect/", brand: "Truora" },
  ],
};
---

<section class="hero">
  <div class="container-page hero-top">
    <h1 class="hero-headline">
      {t.hero.line1}<br />
      {t.hero.line2}
    </h1>
  </div>

  <div class="hero-grid">
    <div class="hero-left">
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-left-foot">
        <a href={t.links.discovery} class="hero-link">
          <span class="hero-dot" aria-hidden="true"></span>
          {t.hero.cta}
        </a>
        <a href="#work" class="hero-link hero-link-muted">{t.hero.secondary}</a>
      </div>
    </div>

    <div class="hero-media" style={`background-image: url(${VIDEO_POSTER})`}>
      <video
        class="hero-video"
        poster={VIDEO_POSTER}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      >
        <source src={VIDEO_MOBILE} media="(max-width: 767px)" />
        <source src={VIDEO_DESKTOP} />
      </video>
      <script define:vars={{ mobilePoster: VIDEO_POSTER_MOBILE }}>
        if (window.matchMedia("(max-width: 767px)").matches) {
          document.querySelector(".hero-video")?.setAttribute("poster", mobilePoster);
        }
      </script>

      <div class="hero-media-bar">
        <a class="hero-brand" id="heroBrand" href="/projects/">
          <img id="heroBrandLogo" src="" alt="" height="14" />
          <span id="heroBrandLabel"></span>
        </a>
        <button
          class="hero-pause"
          id="heroPause"
          type="button"
          aria-label={t.hero.pause}
          aria-pressed="false"
          data-label-pause={t.hero.pause}
          data-label-play={t.hero.play}
        >
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <rect x="3" y="2" width="3.5" height="12" rx="1" />
            <rect x="9.5" y="2" width="3.5" height="12" rx="1" />
          </svg>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M4.5 2.7a1 1 0 0 1 1.53-.85l8.1 5.3a1 1 0 0 1 0 1.7l-8.1 5.3a1 1 0 0 1-1.53-.85V2.7Z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const pauseBtn = document.getElementById("heroPause");
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero-video");
  if (pauseBtn && heroVideo) {
    pauseBtn.addEventListener("click", () => {
      const paused = heroVideo.paused;
      if (paused) heroVideo.play().catch(() => {});
      else heroVideo.pause();
      pauseBtn.setAttribute("aria-pressed", String(!paused));
      pauseBtn.setAttribute(
        "aria-label",
        (paused ? pauseBtn.dataset.labelPause : pauseBtn.dataset.labelPlay) ?? "",
      );
    });
  }
</script>
<script define:vars={{ rounds: ROUNDS }}>
  const video = document.querySelector(".hero-video");
  const chip = document.getElementById("heroBrand");
  const logo = document.getElementById("heroBrandLogo");
  const label = document.getElementById("heroBrandLabel");
  if (video && chip && logo && label) {
    let current = null;
    const update = () => {
      const track = (video.currentSrc || "").includes("hero-mobile")
        ? rounds.mobile
        : rounds.desktop;
      const t = video.currentTime;
      const round = track.find((r) => t < r.until) ?? track[track.length - 1];
      if (round && round !== current) {
        current = round;
        chip.classList.add("is-swapping");
        setTimeout(() => {
          chip.href = round.href;
          logo.src = round.logo;
          logo.alt = round.brand;
          label.textContent = round.label;
          chip.classList.remove("is-swapping");
        }, 150);
      }
    };
    video.addEventListener("timeupdate", update);
    video.addEventListener("loadedmetadata", update);
    update();
  }
</script>

<style>
  .hero {
    background: var(--color-paper);
  }

  /* Headline sits in the right 61% column, bottom-aligned above the
     hairline grid — Riotters' asymmetric Swiss layout. */
  .hero-top {
    display: grid;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 1024px) {
    .hero-top {
      grid-template-columns: 39fr 61fr;
      min-height: calc(50svh - 5.5rem);
      align-items: end;
      padding-top: 4rem;
      padding-bottom: 1.75rem;
    }
    .hero-headline {
      grid-column: 2;
    }
  }
  .hero-headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.75rem, 4.6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-ink);
  }

  .hero-grid {
    display: grid;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 39fr 61fr;
      min-height: calc(50svh + 0.5rem);
    }
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem 1.25rem 0;
  }
  @media (min-width: 768px) {
    .hero-left {
      padding: 2.75rem 2.375rem 0;
    }
  }
  @media (min-width: 1024px) {
    .hero-left {
      border-right: 1px solid var(--color-border);
      /* Left edge follows the container grid on very wide screens. */
      padding-left: max(2.375rem, calc((100vw - 1440px) / 2 + 2.375rem));
    }
  }
  .hero-sub {
    font-size: clamp(1.25rem, 1.65vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 30rem;
  }
  .hero-left-foot {
    margin-top: 2.5rem;
    margin-inline: -1.25rem;
    padding: 1.4rem 1.25rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
  }
  @media (min-width: 768px) {
    .hero-left-foot {
      margin-inline: -2.375rem;
      padding: 1.6rem 2.375rem;
    }
  }
  @media (min-width: 1024px) {
    .hero-left-foot {
      margin-left: calc(-1 * max(2.375rem, calc((100vw - 1440px) / 2 + 2.375rem)));
      padding-left: max(2.375rem, calc((100vw - 1440px) / 2 + 2.375rem));
    }
  }
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .hero-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-link-muted {
    color: var(--color-muted);
  }
  .hero-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: var(--color-ink);
    transition: background-color 0.2s ease;
  }
  .hero-link:hover .hero-dot {
    background: var(--color-accent);
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    min-height: 62vw;
    background-color: var(--color-grey);
    background-size: cover;
    background-position: center;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .hero-media {
      min-height: 0;
      border-top: none;
    }
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media-bar {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    z-index: 2;
  }
  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.85rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: opacity 0.15s ease;
  }
  .hero-brand.is-swapping {
    opacity: 0;
  }
  .hero-brand img {
    display: block;
    height: 13px;
    width: auto;
    filter: brightness(0);
  }
  .hero-pause {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-ink);
    cursor: pointer;
  }
  .hero-pause .icon-play {
    display: none;
  }
  .hero-pause[aria-pressed="true"] .icon-pause {
    display: none;
  }
  .hero-pause[aria-pressed="true"] .icon-play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video,
    .hero-pause,
    .hero-brand {
      display: none;
    }
  }
</style>
