---
import { Image } from "astro:assets";
import { testimonials } from "~/data/testimonials";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const t = ui[Astro.props.lang];
// Quotes stay verbatim in their original language on both locales.
---

<section aria-labelledby="testimonials-heading" class="testimonials">
  <div class="container-page">
    <div class="testimonials-head">
      <p class="eyebrow">{t.testimonials.eyebrow}</p>
      <h2 id="testimonials-heading" class="display-serif testimonials-title">
        {t.testimonials.title}<br /><em>{t.testimonials.titleEm}</em>
      </h2>
    </div>

    <ul class="testimonials-grid">
      {
        testimonials.map((q) => (
          <li>
            <figure class="quote-card">
              <svg class="quote-mark" width="28" height="22" viewBox="0 0 28 22" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M0 22V13.2C0 5.9 4.1 1.4 11 0l1.3 3.1C8.4 4.4 6.4 7 6.2 10.4H12V22H0Zm16 0V13.2C16 5.9 20.1 1.4 27 0l1 3.1c-3.9 1.3-5.9 3.9-6.1 7.3H28V22H16Z"
                />
              </svg>
              <blockquote class="quote-text" lang="en">{q.quote}</blockquote>
              <figcaption class="quote-author">
                {q.avatar && (
                  <Image
                    src={q.avatar}
                    alt=""
                    width={48}
                    height={48}
                    loading="lazy"
                    class="quote-avatar"
                  />
                )}
                <span>
                  <span class="quote-name">{q.name}</span>
                  <span class="quote-role">{q.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials {
    padding-block: 5rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .testimonials {
      padding-block: 7.5rem;
    }
  }
  .testimonials-head {
    margin-bottom: 3rem;
  }
  .testimonials-title {
    margin-top: 0.85rem;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .testimonials-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .testimonials-grid > li {
    display: flex;
  }

  .quote-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--color-paper-soft);
    border: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .quote-card {
      padding: 2.5rem;
    }
  }
  .quote-mark {
    color: var(--color-accent);
  }
  .quote-text {
    flex: 1;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  @media (min-width: 768px) {
    .quote-text {
      font-size: 1.125rem;
    }
  }
  .quote-author {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .quote-author :global(.quote-avatar) {
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .quote-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .quote-role {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
