---
import { homeImpact } from "~/data/home-work-i18n";
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const stats = homeImpact[lang];
---

<section aria-labelledby="impact-heading" class="impact">
  <div class="container-page">
    <div class="impact-head">
      <p class="eyebrow">{t.impact.eyebrow}</p>
      <h2 id="impact-heading" class="display-serif impact-title">
        {t.impact.title}<br /> <span class="hl">{t.impact.titleEm}</span>
      </h2>
    </div>

    <ul class="impact-grid">
      {
        stats.map((s) => (
          <li>
            <a href={`/projects/${s.slug}/`} class="impact-cell">
              <span class="impact-brand">{s.brand}</span>
              <span class="impact-value">{s.value}</span>
              <span class="impact-label">{s.label}</span>
              <span class="sr-only">— {t.impact.readCase}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .impact {
    padding-block: 0 4.5rem;
    background: var(--color-paper);
  }
  @media (min-width: 768px) {
    .impact {
      padding-block: 0 7rem;
    }
  }

  .impact-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .impact-head {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: baseline;
      margin-bottom: 4rem;
    }
    .impact-title {
      grid-column: 2 / -1;
    }
  }
  .impact-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    max-width: 20ch;
  }

  /* Hairline-separated cells: top rule on the row, vertical rules between. */
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
  }
  @media (min-width: 1024px) {
    .impact-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .impact-grid > li {
    border-bottom: 1px solid var(--color-border);
  }
  .impact-grid > li:nth-child(odd) {
    border-right: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .impact-grid > li {
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
    .impact-grid > li:last-child {
      border-right: none;
    }
  }

  .impact-cell {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem 1rem 1.75rem 0;
    color: var(--color-ink);
  }
  .impact-grid > li:nth-child(even) .impact-cell {
    padding-left: 1rem;
  }
  @media (min-width: 1024px) {
    .impact-cell,
    .impact-grid > li:nth-child(even) .impact-cell {
      padding: 1.25rem 1.5rem 0.5rem;
    }
    .impact-grid > li:first-child .impact-cell {
      padding-left: 0;
    }
  }

  .impact-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }
  .impact-brand::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: currentColor;
    transition: background-color 0.2s ease;
  }
  .impact-value {
    margin-top: 2.5rem;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .impact-label {
    margin-top: 0.85rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
    max-width: 20ch;
  }
  .impact-cell:hover .impact-brand {
    color: var(--color-ink);
  }
  .impact-cell:hover .impact-brand::before {
    background: var(--color-accent);
  }
  @media (max-width: 639px) {
    .impact-value {
      margin-top: 1.75rem;
    }
  }
</style>
