---
import ContentImage from "~/components/case-study/ContentImage.astro";
import type { CaseStudyContent } from "~/data/case-studies/types";

type Props = { content: CaseStudyContent["result"] };
const { content } = Astro.props;

// Impact-band pattern from the home page: heading, black top rule,
// hairline cells with a huge number + label + caption. Icons/illustrations
// are intentionally omitted here for a clean typographic band.
const statCols = content.stats.length === 2 ? "res-cols-2" : "res-cols-3";

// Split "+477%" → prefix "+", number 477, unit "%" so the numeral can be
// set huge and thin with a small superscript unit (Karta "100+"), and so a
// count-up has a clean target. Non-numeric values ("ROKU") stay whole.
const splitValue = (v: string) => {
  const m = v.match(/^([^\d]*?)(\d+(?:[.,]\d+)?)(.*)$/);
  if (!m) return { pre: "", num: v, unit: "", count: null as number | null, decimals: 0 };
  const [, pre, num, unit] = m;
  const decimals = num.includes(".") ? num.split(".")[1].length : 0;
  const count = num.includes(",") ? null : Number(num);
  return { pre, num, unit, count, decimals };
};
const cardCols =
  content.cards && content.cards.length === 2 ? "res-cols-2" : "res-cols-3";
---

<section id="result" class="res">
  <div class="container-page">
    <div class="res-head">
      <h2 class="display-serif res-title">{content.heading}</h2>
    </div>

    <dl class:list={["res-grid", statCols]}>
      {
        content.stats.map((s) => (
          <div class="res-cell">
            {(() => {
              const v = splitValue(s.value);
              return (
                <dt class="res-value">
                  <span class="sr-only">{s.value}</span>
                  <span aria-hidden="true" class="res-value-inner">
                    {v.pre && <span class="res-unit res-pre">{v.pre}</span>}
                    <span
                      class="res-num"
                      data-count={v.count ?? undefined}
                      data-decimals={v.decimals || undefined}
                      style={v.count !== null ? `min-width: ${v.num.length * 0.56}em;` : undefined}
                    >
                      {v.num}
                    </span>
                    {v.unit && <span class="res-unit">{v.unit}</span>}
                  </span>
                </dt>
              );
            })()}
            <dd class="res-text">
              <span class="res-stat-label">{s.label}</span>
              {s.caption && <span class="res-caption">{s.caption}</span>}
            </dd>
            {s.chart && (
              <dd class="res-chart">
                <ContentImage image={s.chart} fit="contain" />
              </dd>
            )}
          </div>
        ))
      }
    </dl>

    {
      content.cards && content.cards.length > 0 && (
        <ul class:list={["res-grid res-cards", cardCols]}>
          {content.cards.map((c) => (
            <li class="res-cell">
              {c.image && (
                <div class="res-chart">
                  <ContentImage image={c.image} fit="contain" />
                </div>
              )}
              <h3 class="res-card-title">{c.heading}</h3>
              {c.body && <p class="res-caption">{c.body}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .res {
    padding-block: 4rem 4.5rem;
  }
  @media (min-width: 768px) {
    .res {
      padding-block: 6rem 7rem;
    }
  }

  .res-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .res-head {
      display: grid;
      grid-template-columns: 39fr 61fr;
      margin-bottom: 4rem;
    }
    .res-title {
      grid-column: 2;
    }
  }
  .res-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    max-width: 20ch;
  }

  .res-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--color-ink);
  }
  @media (min-width: 768px) {
    .res-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .res-cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .res-cards {
    margin-top: 3rem;
    border-top-color: var(--color-border);
  }

  .res-cell {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .res-cell {
      padding: 1.25rem 1.5rem 0.75rem;
      border-bottom: none;
      border-left: 1px solid var(--color-border);
    }
    .res-cell:first-child {
      padding-left: 0;
      border-left: none;
    }
  }

  /* Giant thin numerals (Karta "100+"): one per hairline column, sized to
     the cell so 3–4 glyphs never overflow it. */
  .res-cell {
    container-type: inline-size;
  }
  .res-value {
    font-size: clamp(4.5rem, 34cqi, 12rem);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .res-value-inner {
    display: flex;
    align-items: flex-start;
  }
  .res-num {
    font-variant-numeric: tabular-nums;
  }
  .res-unit {
    font-size: 0.32em;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-top: 0.12em;
    margin-left: 0.08em;
  }
  .res-pre {
    margin-left: 0;
    margin-right: 0.06em;
  }
  .res-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }
  @media (min-width: 768px) {
    .res-text {
      margin-top: 2.5rem;
    }
  }
  .res-stat-label,
  .res-card-title {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .res-stat-label::first-letter {
    text-transform: uppercase;
  }
  .res-caption {
    font-size: 0.9375rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-muted);
    max-width: 32ch;
  }
  .res-card-title + .res-caption {
    margin-top: 0.4rem;
  }
  .res-chart {
    margin-top: 1.5rem;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-paper-soft);
  }
</style>

<script>
  // One-time count-up when the band enters. The final value is in the
  // HTML (no-JS / SEO); skipped under reduced motion or if already on screen.
  const nums = document.querySelectorAll<HTMLElement>("#result .res-num[data-count]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (nums.length && !reduce && "IntersectionObserver" in window) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const dec = Number(el.dataset.decimals || 0);
      const t0 = performance.now();
      const D = 1400;
      const tick = (t: number) => {
        const k = Math.min((t - t0) / D, 1);
        const e = 1 - Math.pow(1 - k, 3);
        el.textContent = (target * e).toFixed(dec);
        if (k < 1) requestAnimationFrame(tick);
        else el.textContent = el.dataset.final!;
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          run(e.target as HTMLElement);
        });
      },
      { threshold: 0.6 },
    );
    nums.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) return;
      el.dataset.final = el.textContent ?? "";
      el.textContent = (0).toFixed(Number(el.dataset.decimals || 0));
      io.observe(el);
    });
  }
</script>
