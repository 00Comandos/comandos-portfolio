---
import ContentImage from "~/components/case-study/ContentImage.astro";
import ContentVideo from "~/components/case-study/ContentVideo.astro";
import SectionChip from "~/components/case-study/SectionChip.astro";
import Divider from "~/components/case-study/Divider.astro";
import Checklist from "~/components/case-study/Checklist.astro";
import ImageGrid from "~/components/case-study/ImageGrid.astro";
import ResponsiveMedia from "~/components/case-study/ResponsiveMedia.astro";
import Scene from "~/components/case-study/Scene.astro";
import BleedVideo from "~/components/case-study/BleedVideo.astro";
import BeforeAfterSlider from "~/components/case-study/BeforeAfterSlider.astro";
import CaptureSequence from "~/components/case-study/CaptureSequence.astro";
import ConciergeChat from "~/components/case-study/ConciergeChat.astro";
import type { CaseStudyContent, WorthBlock } from "~/data/case-studies/types";

type Props = { content: CaseStudyContent["worth"] };
const { content } = Astro.props;
const AFTER_MEDIA_SKIP: string[] = ["image", "video", "image-grid", "responsive-media", "two-col-media", "before-after", "scene", "bleed-video", "compare", "capture-sequence"];

// `bleed-video` blocks break out of the case-study column: split the block
// list into column segments and full-width bands (no 100vw math, so no
// scrollbar-width overflow and no offset from the ≥1200 left padding).
type Segment =
  | { kind: "column"; items: { block: WorthBlock; bi: number }[] }
  | { kind: "bleed"; block: Extract<WorthBlock, { kind: "bleed-video" }> };
const segments: Segment[] = [];
content.blocks.forEach((block, bi) => {
  if (block.kind === "bleed-video") {
    segments.push({ kind: "bleed", block });
    return;
  }
  const last = segments[segments.length - 1];
  if (last && last.kind === "column") last.items.push({ block, bi });
  else segments.push({ kind: "column", items: [{ block, bi }] });
});
const endsWithBleed = segments[segments.length - 1]?.kind === "bleed";
---

<section id="worth" class:list={[!endsWithBleed && "pb-10 md:pb-12"]}>
  {segments.map((seg) => seg.kind === "bleed" ? (
    <div class="worth-bleed">
      <BleedVideo video={seg.block.video} line={seg.block.line} />
    </div>
  ) : (
  <div class="cs-body">
    <div class="worth-blocks space-y-14 md:space-y-16">
      {
        seg.items.map(({ block, bi }) => {
          if (block.kind === "divider") {
            // A divider straight after media is redundant — the image already
            // closes the section.
            const prev = content.blocks[bi - 1];
            if (prev && AFTER_MEDIA_SKIP.includes(prev.kind)) return null;
            return <Divider variant={block.variant ?? "hatched"} />;
          }
          if (block.kind === "chip") {
            return (
              <div data-chip="true">
                <SectionChip variant={block.icon} label={block.label} />
              </div>
            );
          }
          if (block.kind === "intro") {
            return (
              <div>
                {block.label && (
                  <p class="text-[0.9375rem] font-medium tracking-[-0.01em] text-[color:var(--color-muted)]">
                    {block.label}
                  </p>
                )}
                <h3 class="display-serif mt-2 text-[2rem] md:text-[2.375rem]">
                  {block.heading}
                </h3>
                {block.body && (
                  <p class="mt-3 text-[1rem] leading-[1.7] text-[color:var(--color-ink-soft)]">
                    {block.body}
                  </p>
                )}
              </div>
            );
          }
          if (block.kind === "lead-point") {
            const pt = block.point;
            return (
              <div>
                <h3 class="display-serif text-[2rem] md:text-[2.375rem]">
                  {block.heading}
                </h3>
                {block.body && (
                  <p class="mt-3 text-[1rem] leading-[1.7] text-[color:var(--color-ink-soft)]">
                    {block.body}
                  </p>
                )}
                <div class="lead-point mt-10 md:mt-12 border-t border-[color:var(--color-border)] pt-6 md:pt-8">
                  <p class="text-[0.9375rem] font-medium tracking-[-0.01em] text-[color:var(--color-muted)]">
                    {pt.label}
                  </p>
                  <h4 class="mt-2 text-[1.375rem] md:text-[1.625rem] font-medium tracking-[-0.03em] leading-[1.2] text-[color:var(--color-ink)]">
                    {pt.heading}
                  </h4>
                  {pt.lead && (
                    <p class="mt-3 text-[1rem] leading-[1.7] text-[color:var(--color-ink-soft)]">
                      {pt.lead}
                    </p>
                  )}
                  {pt.items && pt.items.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2" role="list">
                      {pt.items.map((t, i) => (
                        <li class="inline-flex items-center gap-2 rounded-[var(--radius-xs)] border border-[color:var(--color-border)] bg-[color:var(--color-paper)] px-3 py-1.5 text-[0.9375rem] leading-[1.3] text-[color:var(--color-ink)]">
                          <span class="mono text-[0.6875rem] text-[color:var(--color-muted)]" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                          {t}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            );
          }
          if (block.kind === "concierge-chat") {
            return (
              <ConciergeChat
                heading={block.heading}
                title={block.title}
                channel={block.channel}
                items={block.items}
              />
            );
          }
          if (block.kind === "text") {
            return (
              <p class="text-[1rem] leading-[1.7] text-[color:var(--color-ink-soft)]">
                {block.text}
              </p>
            );
          }
          if (block.kind === "image") {
            return <ContentImage image={block.image} rounded={block.rounded === true} />;
          }
          if (block.kind === "video") {
            return <ContentVideo video={block.video} rounded={block.rounded === true} />;
          }
          if (block.kind === "checklist") {
            return (
              <div>
                {block.heading && (
                  <p class="mb-3 text-[0.95rem] font-medium">{block.heading}</p>
                )}
                <Checklist items={block.items} />
              </div>
            );
          }
          if (block.kind === "big-heading") {
            return (
              <h3 class="display-serif text-center text-[2.25rem] md:text-[3rem]">
                {block.heading}
              </h3>
            );
          }
          if (block.kind === "image-grid") {
            return <ImageGrid columns={block.columns} images={block.images} />;
          }
          if (block.kind === "responsive-media") {
            return <ResponsiveMedia desktop={block.desktop} mobile={block.mobile} />;
          }
          if (block.kind === "before-after") {
            return (
              <div>
                <div class="flex items-center justify-between mb-3 text-sm">
                  <span class="inline-flex items-center bg-[color:var(--color-paper-soft)] border border-[color:var(--color-border)] rounded-full px-4 py-1.5 font-medium">
                    Before
                  </span>
                  <span class="inline-flex items-center gap-2 bg-[color:var(--color-paper-soft)] border border-[color:var(--color-border)] rounded-full px-4 py-1.5 font-medium">
                    New
                    <span class="hl">{block.impact}</span>
                  </span>
                </div>
                <div class="grid md:grid-cols-2 gap-4 md:gap-6">
                  <ContentImage image={block.before} />
                  <ContentImage image={block.after} />
                </div>
              </div>
            );
          }
          if (block.kind === "compare") {
            return <BeforeAfterSlider before={block.before} after={block.after} label={block.label} />;
          }
          if (block.kind === "capture-sequence") {
            return <CaptureSequence frames={block.frames} />;
          }
          if (block.kind === "scene") {
            return <Scene label={block.label} heading={block.heading} body={block.body} beats={block.beats} />;
          }
          return null;
        })
      }
    </div>
  </div>
  ))}
</section>

<style>
  .worth-bleed {
    margin-top: 3.5rem;
  }
  @media (min-width: 768px) {
    .worth-bleed {
      margin-top: 4rem;
    }
  }
  .worth-bleed + .cs-body {
    margin-top: 3.5rem;
  }
  .worth-blocks > [data-chip] {
    margin-block-end: 0.75rem !important;
  }
</style>
