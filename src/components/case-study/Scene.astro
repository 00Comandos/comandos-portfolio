---
import ContentImage from "~/components/case-study/ContentImage.astro";
import type { SceneBeat } from "~/data/case-studies/types";

type Props = {
  label?: string;
  heading?: string;
  body?: string;
  beats: readonly SceneBeat[];
};
const { label, heading, body, beats } = Astro.props;
const unquote = (s: string) => s.replace(/^[“"]\s*|\s*[”"]$/g, "");
const es = Astro.url.pathname.startsWith("/es/");
const pad = (n: number) => String(n).padStart(2, "0");
---

<!--
  Sticky "scene" (Karta concierge pattern). One DOM, two layouts:
  - ≥900px + motion OK: the wrapper is N × 100svh tall, the stage pins
    under the header and beats crossfade with scroll progress.
  - Otherwise (mobile, reduced motion, no JS): beats stack in flow, each
    with its caption. Nothing is hidden until the script marks it ready.
-->
<div class:list={["scene", { "scene--bare": !heading }]} data-scene style={`--beats: ${beats.length};`}>
  <div class="scene-stage">
    {
      heading && (
        <div class="scene-text">
          {label && <p class="eyebrow scene-label">{label}</p>}
          <h3 class="display-serif scene-title">{heading}</h3>
          {body && <p class="scene-body">{body}</p>}
        </div>
      )
    }
    <ol class="scene-beats">
      {
        beats.map((b, i) => (
          <li class:list={["scene-beat", { "is-quotes": !b.media }]} data-beat={i} data-active={i === 0 ? "" : undefined}>
            <div class="scene-media">
              {!b.media ? (
                <ul class="scene-quotes">
                  {b.quotes?.map((q) => (
                    <li>
                      <q>{unquote(q)}</q>
                    </li>
                  ))}
                </ul>
              ) : b.media.kind === "video" ? (
                <video
                  class="scene-video"
                  poster={b.media.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-scene-video
                  aria-label={b.media.alt}
                >
                  {b.media.mobileSrc && (
                    <source src={b.media.mobileSrc} media="(max-width: 767px)" />
                  )}
                  <source src={b.media.src} />
                </video>
              ) : (
                <ContentImage
                  image={{ ...b.media, caption: undefined }}
                  fit="contain"
                  sizes="(min-width: 1200px) 36vw, (min-width: 900px) 460px, 100vw"
                />
              )}
            </div>
            <div class="scene-cap">
              {b.media && (
                <p class="scene-step">
                  <span class="mono">{b.label}</span>
                  {b.impact && <span class="hl">{b.impact}</span>}
                </p>
              )}
              <p class="scene-cap-text">{b.caption}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="scene-progress" aria-hidden="true">
      <span class="scene-ticks">
        {beats.map((_, i) => <span data-tick={i} data-active={i === 0 ? "" : undefined} />)}
      </span>
      <span class="scene-count mono"><b data-count>01</b> / {pad(beats.length)}</span>
      <span class="scene-hint mono">{es ? "Desliza" : "Scroll"} <span class="scene-hint-arrow">↓</span></span>
    </div>
  </div>
</div>

<style>
  /* ---------- Stacked (default: mobile, reduced motion, no JS) ---------- */
  .scene-label {
    color: var(--color-muted);
  }
  .scene-title {
    margin-top: 0.5rem;
    font-size: 2rem;
  }
  @media (min-width: 768px) {
    .scene-title {
      font-size: 2.375rem;
    }
  }
  .scene-body {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .scene-beats {
    display: grid;
    gap: 2.5rem;
    margin-top: 2rem;
  }
  .scene-media {
    overflow: hidden;
    border-radius: var(--radius-xs);
  }
  .scene-video {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .scene-cap {
    margin-top: 1rem;
  }
  .scene-step {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .scene-step .hl {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    text-transform: none;
    color: var(--color-ink);
  }
  .scene-cap-text {
    margin-top: 0.5rem;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 28ch;
  }
  .scene-progress {
    display: none;
  }

  /* ---------- Quote beats (research): the words are the media ---------- */
  .scene-beat.is-quotes {
    display: flex;
    flex-direction: column-reverse;
    gap: 1.25rem;
  }
  .scene-beat.is-quotes .scene-cap {
    margin-top: 0;
  }
  /* Quote beats carry no step label: the caption itself leads. */
  .scene-beat.is-quotes .scene-cap-text {
    margin-top: 0;
  }
  .scene-quotes {
    border-top: 1px solid var(--color-ink);
  }
  .scene-quotes li {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .scene-quotes q {
    display: block;
    position: relative;
    padding-left: 1.4rem;
    font-size: clamp(1.375rem, 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    quotes: none;
  }
  /* Hanging teal quote mark — the one accent. */
  .scene-quotes q::before {
    content: "“";
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1em;
    line-height: 1.15;
    color: var(--color-accent);
  }

  /* ---------- Pinned stage ---------- */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .scene[data-ready] {
      height: calc(var(--beats) * 100svh);
    }
    .scene[data-ready] .scene-stage {
      position: sticky;
      top: 5.5rem;
      height: calc(100svh - 5.5rem);
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        "text media"
        ". media"
        "cap media";
      column-gap: 2rem;
      /* Below 1200 the floating section-nav pill sits at the bottom. */
      padding-block: 1.5rem 4.5rem;
    }
    .scene[data-ready] .scene-text {
      grid-area: text;
    }
    @media (min-width: 1200px) {
      .scene[data-ready] .scene-stage {
        padding-bottom: 2.5rem;
      }
    }
    .scene[data-ready] .scene-title {
      font-size: clamp(1.625rem, 2.2vw, 2.25rem);
    }
    .scene[data-ready] .scene-body {
      font-size: 0.9375rem;
      color: var(--color-muted);
    }
    .scene[data-ready] .scene-beats,
    .scene[data-ready] .scene-beat {
      display: contents;
    }
    .scene[data-ready] .scene-media {
      grid-area: media;
      min-height: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .scene[data-ready] .scene-media :global(figure),
    .scene[data-ready] .scene-media :global(figure > div),
    .scene[data-ready] .scene-media :global(picture) {
      height: 100%;
      width: 100%;
    }
    .scene[data-ready] .scene-media :global(img),
    .scene[data-ready] .scene-video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .scene[data-ready] .scene-video {
      object-fit: cover;
    }
    /* Quote beats: words top-aligned with the caption, a bit roomier. */
    .scene[data-ready] .is-quotes > .scene-media {
      align-items: flex-start;
      justify-content: stretch;
      padding-top: 0.35rem;
    }
    .scene[data-ready] .scene-quotes {
      width: 100%;
    }
    .scene[data-ready] .scene-quotes li {
      padding-block: 1.5rem;
    }
    /* No heading: the caption (source + what it revealed) leads top-left. */
    .scene--bare[data-ready] .scene-stage {
      grid-template-areas:
        "cap media"
        "prog media";
      grid-template-rows: auto auto;
      align-content: center;
    }
    .scene--bare[data-ready] .scene-stage > .scene-beats,
    .scene--bare[data-ready] .scene-media {
      height: auto;
    }
    .scene--bare[data-ready] .scene-cap {
      align-self: start;
    }
    .scene--bare[data-ready] .scene-progress {
      grid-area: prog;
      align-self: start;
      margin-top: 1.25rem;
    }
    .scene[data-ready] .scene-cap {
      grid-area: cap;
      margin-top: 0;
      padding-bottom: 1.25rem;
    }
    .scene[data-ready] .scene-cap-text {
      font-size: clamp(1.375rem, 2vw, 1.75rem);
    }
    .scene[data-ready] .scene-media,
    .scene[data-ready] .scene-cap {
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.6s ease,
        visibility 0s linear 0.6s;
    }
    .scene[data-ready] .scene-cap {
      transform: translateY(0.5rem);
      transition:
        opacity 0.5s ease,
        transform 0.5s ease,
        visibility 0s linear 0.5s;
    }
    .scene[data-ready] .scene-beat[data-active] > .scene-media,
    .scene[data-ready] .scene-beat[data-active] > .scene-cap {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    /* Progress fills continuously with scroll so the pinned stage never
       feels frozen; a one-time "Scroll ↓" hint leaves after beat 1. */
    .scene[data-ready] .scene-progress {
      grid-area: cap;
      align-self: end;
      display: flex;
      align-items: center;
      gap: 0.875rem;
    }
    .scene-ticks {
      display: flex;
      gap: 0.35rem;
    }
    .scene-ticks span {
      position: relative;
      width: 2rem;
      height: 3px;
      border-radius: 2px;
      overflow: hidden;
      background: var(--color-border);
    }
    .scene-ticks span::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--color-ink);
      transform: scaleX(var(--f, 0));
      transform-origin: left;
    }
    .scene-ticks span[data-active]::after {
      background: var(--color-accent);
    }
    .scene-count {
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      color: var(--color-muted);
    }
    .scene-count b {
      font-weight: 400;
      color: var(--color-ink);
    }
    .scene-hint {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-muted);
      transition: opacity 0.4s ease;
    }
    .scene-hint-arrow {
      display: inline-block;
      animation: scene-nudge 1.6s ease-in-out infinite;
    }
    .scene[data-hinted] .scene-hint {
      opacity: 0;
    }
    @keyframes scene-nudge {
      0%,
      100% {
        transform: translateY(-1px);
      }
      50% {
        transform: translateY(3px);
      }
    }
  }
</style>

<script>
  const PIN = "(min-width: 900px) and (prefers-reduced-motion: no-preference)";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-scene]").forEach((scene) => {
    const beats = Array.from(scene.querySelectorAll<HTMLElement>(".scene-beat"));
    const ticks = Array.from(scene.querySelectorAll<HTMLElement>("[data-tick]"));
    const stage = scene.querySelector<HTMLElement>(".scene-stage")!;
    const count = scene.querySelector<HTMLElement>("[data-count]");
    const mq = window.matchMedia(PIN);
    let active = 0;
    let inView = false;
    let raf = 0;

    const syncVideos = () => {
      beats.forEach((b, i) => {
        const v = b.querySelector<HTMLVideoElement>("video");
        if (!v) return;
        const pinned = mq.matches;
        const shouldPlay =
          !reduce.matches && inView && (pinned ? i === active : b.dataset.visible === "1");
        if (shouldPlay) v.play().catch(() => {});
        else v.pause();
      });
    };

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      beats.forEach((b, j) => b.toggleAttribute("data-active", j === i));
      ticks.forEach((t, j) => t.toggleAttribute("data-active", j === i));
      if (count) count.textContent = String(i + 1).padStart(2, "0");
      if (i > 0) scene.setAttribute("data-hinted", "");
      syncVideos();
    };

    const update = () => {
      raf = 0;
      if (!mq.matches) return;
      const rect = scene.getBoundingClientRect();
      const travel = rect.height - stage.offsetHeight;
      const p = travel > 0 ? Math.min(Math.max(-rect.top / travel, 0), 0.9999) : 0;
      const n = beats.length;
      ticks.forEach((t, j) => t.style.setProperty("--f", String(Math.min(Math.max(p * n - j, 0), 1))));
      setActive(Math.floor(p * n));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    const apply = () => {
      scene.toggleAttribute("data-ready", mq.matches);
      if (mq.matches) update();
      syncVideos();
    };
    mq.addEventListener("change", apply);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });

    // Scene visibility (pinned mode) + per-beat visibility (stacked mode).
    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        syncVideos();
      },
      { rootMargin: "100px 0px" },
    ).observe(scene);
    const beatIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          (e.target as HTMLElement).dataset.visible = e.isIntersecting ? "1" : "0";
        });
        syncVideos();
      },
      { threshold: 0.25 },
    );
    beats.forEach((b) => beatIO.observe(b));

    apply();
  });
</script>
