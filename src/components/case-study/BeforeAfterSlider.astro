---
/*
 * Before / after compare. The two screens are stacked on one canvas; a real
 * range input drives a single `--pos` custom property that clips the "new"
 * layer (clip-path, so no reflow and nothing can widen the page). The handle
 * is a hairline with a small knob. On first entering the viewport the handle
 * does one short peek sweep; skipped under prefers-reduced-motion.
 * Without JS the stage shows the 50/50 split.
 */
import { Image } from "astro:assets";
import type { ContentImage } from "~/data/case-studies/types";

type Img = Extract<ContentImage, { kind: "image" }>;
type Props = {
  before: Img;
  after: Img;
  /** What is being compared — used in the handle's accessible name. */
  label?: string;
};
const { before, after, label } = Astro.props;
const name = label ? `Compare before and new: ${label}` : "Compare before and new";
const ratio = `${before.image.width} / ${before.image.height}`;
const widths = [480, 760, before.image.width].filter((w, i, a) => w <= before.image.width && a.indexOf(w) === i);
const sizes = "(min-width: 768px) 36rem, 92vw";
---

<figure class="ba not-prose" data-ba style={`--pos: 50%;`}>
  <div class="ba-stage" style={`aspect-ratio: ${ratio};`}>
    <Image
      class="ba-img"
      src={before.image}
      alt={before.alt}
      widths={widths}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
    <div class="ba-after">
      <Image
        class="ba-img"
        src={after.image}
        alt={after.alt}
        widths={widths}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
    </div>

    <span class="ba-tag ba-tag--before mono" aria-hidden="true">Before</span>
    <span class="ba-tag ba-tag--after mono" aria-hidden="true">New</span>

    <span class="ba-handle" aria-hidden="true">
      <span class="ba-knob">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.25">
          <path d="M6 4 2 8l4 4M10 4l4 4-4 4" />
        </svg>
      </span>
    </span>

    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label={name}
      aria-valuetext="50% before, 50% new"
      data-ba-range
    />
  </div>
  <figcaption class="ba-hint mono">Drag to compare</figcaption>
</figure>

<style>
  .ba {
    margin-inline: auto;
    width: 100%;
    max-width: 36rem;
  }
  .ba-stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: var(--color-paper-soft);
  }
  .ba-stage :global(.ba-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
  .ba-after {
    position: absolute;
    inset: 0;
    /* Opaque so the transparent "new" PNG hides the before layer beneath. */
    background: var(--color-paper-soft);
    clip-path: inset(0 0 0 var(--pos));
  }

  .ba-tag {
    position: absolute;
    top: 0.75rem;
    z-index: 2;
    padding: 0.2rem 0.45rem;
    font-size: 0.6875rem;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    pointer-events: none;
  }
  .ba-tag--before {
    left: 0.75rem;
    color: var(--color-muted);
  }
  .ba-tag--after {
    right: 0.75rem;
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 2;
    width: 1px;
    background: var(--color-ink);
    transform: translateX(-0.5px);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    transform: translate(-50%, -50%);
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
  }

  /* The real control: a transparent range over the whole stage. */
  .ba-range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }
  /* Hairline-thin thumb so pointer x maps 1:1 to the value. */
  .ba-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 1px;
    height: 100%;
  }
  .ba-range::-moz-range-thumb {
    width: 1px;
    height: 100%;
    border: 0;
  }
  .ba-stage:has(.ba-range:focus-visible) .ba-knob {
    outline: 1px solid var(--color-accent);
    outline-offset: 2px;
  }
  .ba-stage:has(.ba-range:focus-visible) .ba-handle {
    background: var(--color-accent);
  }

  .ba-hint {
    margin-top: 0.625rem;
    font-size: 0.6875rem;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-ba]").forEach((root) => {
    const range = root.querySelector<HTMLInputElement>("[data-ba-range]");
    if (!range) return;
    const set = (v: number) => {
      root.style.setProperty("--pos", `${v}%`);
      const r = Math.round(v);
      range.setAttribute("aria-valuetext", `${r}% before, ${100 - r}% new`);
    };
    let touched = false;
    let raf = 0;
    const stop = () => {
      touched = true;
      cancelAnimationFrame(raf);
    };
    range.addEventListener("input", () => {
      stop();
      set(Number(range.value));
    });
    range.addEventListener("pointerdown", stop);
    range.addEventListener("keydown", stop);

    if (reduce || !("IntersectionObserver" in window)) return;

    // One-time peek: 50 → 64 → 36 → 50, eased, ~1.5s.
    const keys = [50, 64, 36, 50];
    const SEG = 500;
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const peek = () => {
      const t0 = performance.now();
      const step = (now: number) => {
        if (touched) return;
        const t = (now - t0) / SEG;
        const i = Math.min(Math.floor(t), keys.length - 2);
        const local = Math.min(t - i, 1);
        const v = keys[i] + (keys[i + 1] - keys[i]) * ease(local);
        set(v);
        range.value = String(Math.round(v));
        if (t < keys.length - 1) raf = requestAnimationFrame(step);
        else {
          set(50);
          range.value = "50";
        }
      };
      raf = requestAnimationFrame(step);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          if (!touched) setTimeout(peek, 250);
        }
      },
      { threshold: 0.6 },
    );
    io.observe(root);
  });
</script>
