---
type ChipVariant =
  | "challenge"
  | "adventure"
  | "worth"
  | "result"
  | "seeing-mountain"
  | "making-top"
  | "nps"
  | "interview"
  | "signature";

type Props = {
  variant: ChipVariant;
  label: string;
  tone?: "light" | "dark";
};

const { variant, label, tone = "light" } = Astro.props;

// Monochrome chips (riotters language): ink disc on paper, paper disc on
// dark bands. Only the glyph distinguishes variants — no per-section colors.
const glyphs: Record<ChipVariant, string> = {
  challenge: "!",
  adventure: "✦",
  worth: "✓",
  result: "★",
  "seeing-mountain": "⛰",
  "making-top": "▲",
  nps: "⚡",
  interview: "👤",
  signature: "✎",
};

const glyph = glyphs[variant];
const dark = tone === "dark";
const discBg = dark ? "var(--color-paper)" : "var(--color-ink)";
const discFg = dark ? "var(--color-ink)" : "var(--color-paper)";
const textColor = dark ? "var(--color-paper)" : "var(--color-ink)";
---

<div class="flex items-center gap-3">
  <span
    aria-hidden="true"
    class="h-7 w-7 rounded-full flex items-center justify-center text-[0.8rem] font-medium"
    style={`background-color: ${discBg}; color: ${discFg};`}
  >
    {glyph}
  </span>
  <span class="text-[0.9375rem] font-medium" style={`color: ${textColor};`}>
    {label}
  </span>
</div>
