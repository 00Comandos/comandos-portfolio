---
import type { ChecklistItem } from "~/data/case-studies/types";

type Props = { items: readonly ChecklistItem[] };
const { items } = Astro.props;

// Items carrying quotes (`sub`) are research sources — rendered as columns
// with the users' own words as chat bubbles (Karta concierge pattern).
// Everything else stays a clean hairline list.
const isResearch = items.length > 0 && items.every((i) => i.sub && i.sub.length > 0);

type Icon = "chat" | "user" | "shield" | "dot";
const iconFor = (label: string): Icon => {
  if (/nps|call|support|soporte/i.test(label)) return "chat";
  if (/interview|entrevista|user|usuario/i.test(label)) return "user";
  if (/confiden|trust|survey|encuesta|segur/i.test(label)) return "shield";
  return "dot";
};
// A leading body-less item followed by detailed ones acts as the list title
// (e.g. "First Insights").
const hasTitle = !isResearch && items.length > 1 && !items[0].body && items.slice(1).some((i) => i.body);
const listTitle = hasTitle ? items[0].label : null;
const rows = hasTitle ? items.slice(1) : items;
// "10/10 users" style rows → people pictogram (one figure per person).
const RATIO = /^(\d+)\s*\/\s*(\d+)\s*(.*)$/;
const ratios = !isResearch
  ? rows.map((r) => {
      const m = r.label.match(RATIO);
      return m && +m[2] <= 20 ? { n: +m[1], d: +m[2], text: [m[3], r.body].filter(Boolean).join(" ") } : null;
    })
  : [];
const isRatio = ratios.length > 0 && ratios.every(Boolean);

// Research themes: every tagged quote converges into one insight.
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const themes: { name: string; count: number; sources: string[] }[] = [];
if (isResearch) {
  items.forEach((it) =>
    it.tags?.forEach((tag) => {
      let th = themes.find((x) => x.name === tag);
      if (!th) themes.push((th = { name: tag, count: 0, sources: [] }));
      th.count++;
      if (!th.sources.includes(it.label)) th.sources.push(it.label);
    }),
  );
}
const mentions = (n: number) => `${n} ${n === 1 ? "mention" : "mentions"}`;
const unquote = (s: string) => s.replace(/^[“"]\s*|\s*[”"]$/g, "");
const trimColon = (s: string) => s.replace(/:\s*$/, ".");
---

{
  isResearch ? (
    <div class="research-wrap not-prose" data-research>
      <ul class="research">
        {items.map((item, c) => {
          const icon = iconFor(item.label);
          return (
            <li class="research-col" style={`--c: ${c};`}>
              <p class="research-title mono">
                <span class="research-icon" aria-hidden="true">
                  {icon === "chat" && (
                    <svg viewBox="0 0 20 20"><path d="M3 4.5h14v9H8l-4 3v-3H3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                  )}
                  {icon === "user" && (
                    <svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M3.5 17c.8-3.4 3.4-5 6.5-5s5.7 1.6 6.5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                  )}
                  {icon === "shield" && (
                    <svg viewBox="0 0 20 20"><path d="M10 2.5l6 2.3v4.6c0 4-2.6 6.7-6 8.1-3.4-1.4-6-4.1-6-8.1V4.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                  )}
                  {icon === "dot" && <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="3" fill="currentColor" /></svg>}
                </span>
                {item.label}
              </p>
              {item.body && <p class="research-body">{trimColon(item.body)}</p>}
              <ul class="research-quotes">
                {item.sub!.map((q, qi) => {
                  const tag = item.tags?.[qi];
                  return (
                    <li class="q-item" style={`--i: ${qi};`} data-t={tag ? slug(tag) : undefined}>
                      <span class="typing" aria-hidden="true"><i /><i /><i /></span>
                      <q class="bubble">{unquote(q)}</q>
                      {tag && <span class="q-tag mono">{tag}</span>}
                    </li>
                  );
                })}
                {item.answer && (
                  <li class="research-answer q-item" style={`--i: ${item.sub!.length};`}>
                    <span class="sr-only">Our answer: </span>
                    <span class="bubble bubble-out">{item.answer}</span>
                  </li>
                )}
              </ul>
            </li>
          );
        })}
      </ul>
      {themes.length > 0 && (
        <div class="converge">
          <svg class="converge-lines" viewBox="0 0 300 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M50 0 V12 Q50 22 60 22 H240 Q250 22 250 12 V0 M150 0 V40" />
          </svg>
          <ul class="themes">
            {themes.map((th) => (
              <li>
                <button type="button" class="theme" data-theme={slug(th.name)}>
                  <span class="theme-name">{th.name}</span>
                  <span class="theme-meta mono">
                    {mentions(th.count)} · {th.sources.join(" · ")}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  ) : isRatio ? (
    <div class="ratio not-prose" data-ratio>
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="ratio-list">
        {ratios.map((r) => (
          <li class="ratio-row">
            <p class="ratio-num" aria-hidden="true">
              <span>{r!.n}</span>/{r!.d}
            </p>
            <span class="ratio-people" aria-hidden="true">
              {Array.from({ length: r!.d }, (_, k) => (
                <svg viewBox="0 0 12 20" class:list={["person", { "is-on": k < r!.n }]} style={`--k: ${k};`}>
                  <circle cx="6" cy="4" r="3" />
                  <path d="M1 19v-6.5C1 9.5 3.2 8 6 8s5 1.5 5 4.5V19z" />
                </svg>
              ))}
            </span>
            <p class="ratio-text">
              <span class="sr-only">{r!.n} of {r!.d} </span>
              {r!.text}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="not-prose">
    {listTitle && <p class="checklist-title">{listTitle}</p>}
    <ul class="checklist">
      {rows.map((item) => (
        <li>
          <span class="check" aria-hidden="true">
            <svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </span>
          <span>
            <span class="check-label">{item.label}</span>
            {item.body && <span class="check-body">{" "}{item.body}</span>}
          </span>
        </li>
      ))}
    </ul>
    </div>
  )
}

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          (e.target as HTMLElement).setAttribute("data-in", "");
        });
      },
      { threshold: 0.25 },
    );
    document.querySelectorAll<HTMLElement>("[data-research], [data-ratio]").forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.85) return;
      el.setAttribute("data-armed", "");
      io.observe(el);
    });
  }
  // Theme ↔ quotes: hovering/focusing a theme lights up the quotes behind it.
  document.querySelectorAll<HTMLElement>("[data-research]").forEach((wrap) => {
    const set = (t: string | null) => {
      wrap.toggleAttribute("data-focus", !!t);
      wrap.querySelectorAll<HTMLElement>(".q-item").forEach((q) => q.classList.toggle("is-focus", !!t && q.dataset.t === t));
      wrap.querySelectorAll<HTMLElement>(".theme").forEach((b) => b.classList.toggle("is-focus", b.dataset.theme === t));
    };
    wrap.querySelectorAll<HTMLButtonElement>(".theme").forEach((b) => {
      const on = () => set(b.dataset.theme ?? null);
      b.addEventListener("mouseenter", on);
      b.addEventListener("focus", on);
      b.addEventListener("mouseleave", () => set(null));
      b.addEventListener("blur", () => set(null));
    });
  });
</script>

<style>
  /* ---------- Research: voices → themes (dark panel) ---------- */
  .research-wrap {
    --r-line: rgb(255 255 255 / 0.14);
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  @media (min-width: 768px) {
    .research-wrap {
      padding: 2.5rem;
    }
  }
  .research {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .research {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .research-col {
    display: flex;
    flex-direction: column;
    padding: 0 1rem 1.25rem;
    border: 1px solid var(--r-line);
    border-radius: var(--radius-xs);
    background: #0f0f0f;
  }
  .research-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline: -1rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--r-line);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .research-icon {
    display: inline-grid;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
  }
  .research-icon svg {
    width: 100%;
    height: 100%;
  }
  .research-body {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.62);
  }
  .research-quotes {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .q-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    max-width: 100%;
    transition: opacity 0.25s ease;
  }
  .q-item:nth-child(2) {
    margin-left: 0.75rem;
  }
  .q-item:nth-child(3) {
    margin-left: 1.5rem;
  }
  .bubble {
    display: inline-block;
    max-width: 100%;
    padding: 0.6rem 0.85rem;
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: #1c1c1c;
    border: 1px solid var(--r-line);
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-paper);
    quotes: "“" "”";
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease;
  }
  .q-tag {
    padding-left: 0.85rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .research-answer {
    align-self: flex-end;
    max-width: 90%;
  }
  .research-quotes .bubble-out {
    border-radius: 1rem 1rem 0.25rem 1rem;
    background: var(--color-paper);
    border-color: var(--color-paper);
    color: var(--color-ink);
  }
  /* Theme focus: the quotes behind the hovered theme light up. */
  .research-wrap[data-focus] .q-item:not(.is-focus) {
    opacity: 0.25;
  }
  .q-item.is-focus .bubble {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, #1c1c1c);
  }

  /* Typing dots, only visible during the armed reveal. */
  .typing {
    display: none;
    gap: 3px;
    padding: 0.7rem 0.85rem;
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: #1c1c1c;
    border: 1px solid var(--r-line);
  }
  .typing i {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.6);
    animation: r-dot 0.9s ease-in-out infinite;
  }
  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes r-dot {
    50% {
      opacity: 0.25;
      transform: translateY(-2px);
    }
  }

  /* Sequential reveal once armed: typing… then the message (+ its tag).
     Final state without JS, under reduced motion, or if already on screen. */
  .research-wrap[data-armed] .q-item {
    --at: calc(var(--c, 0) * 0.35s + var(--i, 0) * 1.1s + 0.2s);
  }
  .research-wrap[data-armed] .typing {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    opacity: 0;
  }
  .research-wrap[data-armed] .bubble,
  .research-wrap[data-armed] .q-tag {
    opacity: 0;
    transform: translateY(0.4rem);
  }
  .research-wrap[data-armed] .converge {
    opacity: 0;
  }
  .research-wrap[data-armed][data-in] .typing {
    animation: r-typing 0.75s ease both;
    animation-delay: var(--at);
  }
  .research-wrap[data-armed][data-in] .bubble,
  .research-wrap[data-armed][data-in] .q-tag {
    animation: r-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--at) + 0.7s);
  }
  .research-wrap[data-armed][data-in] .q-tag {
    animation-delay: calc(var(--at) + 0.95s);
  }
  .research-wrap[data-armed][data-in] .converge {
    animation: r-fade 0.8s ease both;
    animation-delay: 3.6s;
  }
  @keyframes r-typing {
    0% {
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes r-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes r-fade {
    to {
      opacity: 1;
    }
  }

  /* Convergence: the tagged quotes fold into a few themes. */
  .converge {
    margin-top: 1.5rem;
  }
  .converge-lines {
    display: none;
  }
  @media (min-width: 900px) {
    .converge {
      margin-top: 0;
    }
    .converge-lines {
      display: block;
      width: 100%;
      height: 2.5rem;
      overflow: visible;
    }
    .converge-lines path {
      fill: none;
      stroke: rgb(255 255 255 / 0.3);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }
  }
  .themes {
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.3);
  }
  @media (min-width: 640px) {
    .themes {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
    }
  }
  .theme {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 0;
    border: 0;
    border-bottom: 1px solid var(--r-line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: default;
  }
  @media (min-width: 640px) {
    .themes li + li .theme {
      padding-left: 1.25rem;
      border-left: 1px solid var(--r-line);
    }
    .theme {
      border-bottom: 0;
    }
  }
  .theme-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .theme-name::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-accent);
    transition: transform 0.25s ease;
  }
  .theme.is-focus .theme-name::before {
    transform: scale(1.6);
  }
  .theme-meta {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }
  .theme:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ---------- Ratio pictogram ("8/10 users …") ---------- */
  .ratio-list {
    border-top: 1px solid var(--color-ink);
  }
  .ratio-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "num text"
      "people people";
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .ratio-row {
      grid-template-columns: 7.5rem auto minmax(0, 1fr);
      grid-template-areas: "num people text";
      gap: 2rem;
      padding-block: 1.5rem;
    }
  }
  .ratio-num {
    grid-area: num;
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ratio-num span {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-ink);
  }
  .ratio-people {
    grid-area: people;
    display: flex;
    gap: 0.3rem;
  }
  .person {
    width: 0.85rem;
    height: 1.4rem;
    fill: transparent;
    stroke: var(--color-muted-soft);
    stroke-width: 1;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
    transition-delay: calc(var(--k) * 70ms);
  }
  @media (min-width: 900px) {
    .person {
      width: 1rem;
      height: 1.65rem;
    }
  }
  .person.is-on {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }
  .ratio[data-armed]:not([data-in]) .person.is-on {
    fill: transparent;
    stroke: var(--color-muted-soft);
  }
  .ratio-text {
    grid-area: text;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-ink);
    max-width: 30ch;
  }

  /* ---------- Plain list ---------- */
  .checklist-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .checklist {
    max-width: 42rem;
    border-top: 1px solid var(--color-border);
  }
  .checklist li {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .check {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .check svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .check-label {
    font-weight: 500;
    color: var(--color-ink);
  }
  .check-body {
    color: var(--color-muted);
  }
</style>
