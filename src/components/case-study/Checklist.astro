---
import type { ChecklistItem } from "~/data/case-studies/types";

type Props = { items: readonly ChecklistItem[] };
const { items } = Astro.props;

// Items carrying quotes (`sub`) are research sources — rendered as columns
// with the users' own words set as plain pull quotes on a hairline grid.
// Everything else stays a clean hairline list.
const isResearch = items.length > 0 && items.every((i) => i.sub && i.sub.length > 0);

// A leading body-less item followed by detailed ones acts as the list title
// (e.g. "First Insights").
const hasTitle = !isResearch && items.length > 1 && !items[0].body && items.slice(1).some((i) => i.body);
const listTitle = hasTitle ? items[0].label : null;
const rows = hasTitle ? items.slice(1) : items;
// "10/10 users" style rows → people pictogram (one figure per person).
const RATIO = /^(\d+)\s*\/\s*(\d+)\s*(.*)$/;
const ratios = !isResearch
  ? rows.map((r) => {
      const m = r.label.match(RATIO);
      return m && +m[2] <= 20 ? { n: +m[1], d: +m[2], text: [m[3], r.body].filter(Boolean).join(" ") } : null;
    })
  : [];
const isRatio = ratios.length > 0 && ratios.every(Boolean);

const unquote = (s: string) => s.replace(/^[“"]\s*|\s*[”"]$/g, "");
const trimColon = (s: string) => s.replace(/:\s*$/, ".");
---

{
  isResearch ? (
    <ol class="research not-prose" data-research>
      {items.map((item, c) => (
        <li class="research-col" style={`--c: ${c};`}>
          <span class="research-num mono">{String(c + 1).padStart(2, "0")}</span>
          <h4 class="research-title">{item.label}</h4>
          {item.body && <p class="research-body">{trimColon(item.body)}</p>}
          <ul class="research-quotes">
            {item.sub!.map((q, qi) => (
              <li style={`--i: ${qi};`}>
                <q>{unquote(q)}</q>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  ) : isRatio ? (
    <div class="ratio not-prose" data-ratio>
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="ratio-list">
        {ratios.map((r) => (
          <li class="ratio-row">
            <p class="ratio-num" aria-hidden="true">
              <span>{r!.n}</span>/{r!.d}
            </p>
            <span class="ratio-people" aria-hidden="true">
              {Array.from({ length: r!.d }, (_, k) => (
                <svg viewBox="0 0 12 20" class:list={["person", { "is-on": k < r!.n }]} style={`--k: ${k};`}>
                  <circle cx="6" cy="4" r="3" />
                  <path d="M1 19v-6.5C1 9.5 3.2 8 6 8s5 1.5 5 4.5V19z" />
                </svg>
              ))}
            </span>
            <p class="ratio-text">
              <span class="sr-only">{r!.n} of {r!.d} </span>
              {r!.text}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="not-prose">
    {listTitle && <p class="checklist-title">{listTitle}</p>}
    <ul class="checklist">
      {rows.map((item) => (
        <li>
          <span class="check" aria-hidden="true">
            <svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </span>
          <span>
            <span class="check-label">{item.label}</span>
            {item.body && <span class="check-body">{" "}{item.body}</span>}
          </span>
        </li>
      ))}
    </ul>
    </div>
  )
}

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          (e.target as HTMLElement).setAttribute("data-in", "");
        });
      },
      { threshold: 0.25 },
    );
    document.querySelectorAll<HTMLElement>("[data-research], [data-ratio]").forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.85) return;
      el.setAttribute("data-armed", "");
      io.observe(el);
    });
  }
</script>

<style>
  /* ---------- Research sources: hairline grid + pull quotes ---------- */
  .research {
    display: grid;
    border-top: 1px solid var(--color-ink);
  }
  @media (min-width: 900px) {
    .research {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .research-col {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .research-col {
      padding: 1.5rem 1.5rem 0.5rem;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
    .research-col:first-child {
      padding-left: 0;
    }
    .research-col:last-child {
      border-right: 0;
      padding-right: 0;
    }
  }
  .research-num {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .research-title {
    margin-top: 1rem;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-ink);
  }
  .research-body {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 30ch;
  }
  .research-quotes {
    margin-top: 1.75rem;
  }
  .research-quotes li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--color-border);
  }
  .research-quotes q {
    display: block;
    position: relative;
    padding-left: 1.1rem;
    font-size: 1.0625rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    quotes: none;
  }
  /* Hanging teal quote mark — the one accent in the block. */
  .research-quotes q::before {
    content: "“";
    position: absolute;
    left: 0;
    top: -0.05em;
    font-size: 1.5em;
    line-height: 1;
    color: var(--color-accent);
  }
  /* Quiet reveal: quotes fade up in order, column by column. */
  .research[data-armed] .research-quotes li {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--c, 0) * 160ms + var(--i, 0) * 120ms + 100ms);
  }
  .research[data-armed][data-in] .research-quotes li {
    opacity: 1;
    transform: none;
  }

  /* ---------- Ratio pictogram ("8/10 users …") ---------- */
  .ratio-list {
    border-top: 1px solid var(--color-ink);
  }
  .ratio-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "num text"
      "people people";
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .ratio-row {
      grid-template-columns: 7.5rem auto minmax(0, 1fr);
      grid-template-areas: "num people text";
      gap: 2rem;
      padding-block: 1.5rem;
    }
  }
  .ratio-num {
    grid-area: num;
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ratio-num span {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-ink);
  }
  .ratio-people {
    grid-area: people;
    display: flex;
    gap: 0.3rem;
  }
  .person {
    width: 0.85rem;
    height: 1.4rem;
    fill: transparent;
    stroke: var(--color-muted-soft);
    stroke-width: 1;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
    transition-delay: calc(var(--k) * 70ms);
  }
  @media (min-width: 900px) {
    .person {
      width: 1rem;
      height: 1.65rem;
    }
  }
  .person.is-on {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }
  .ratio[data-armed]:not([data-in]) .person.is-on {
    fill: transparent;
    stroke: var(--color-muted-soft);
  }
  .ratio-text {
    grid-area: text;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-ink);
    max-width: 30ch;
  }

  /* ---------- Plain list ---------- */
  .checklist-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .checklist {
    max-width: 42rem;
    border-top: 1px solid var(--color-border);
  }
  .checklist li {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .check {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .check svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .check-label {
    font-weight: 500;
    color: var(--color-ink);
  }
  .check-body {
    color: var(--color-muted);
  }
</style>
