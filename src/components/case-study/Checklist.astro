---
import type { ChecklistItem } from "~/data/case-studies/types";
import Scene from "~/components/case-study/Scene.astro";

type Props = { items: readonly ChecklistItem[] };
const { items } = Astro.props;

// Items carrying quotes (`sub`) are research sources — rendered
// as a pinned scroll scene (same pattern as the iterations block): one beat
// per source, the users' own words set large.
// Everything else stays a clean hairline list.
const isResearch = items.length > 0 && items.every((i) => i.sub && i.sub.length > 0);

// A leading body-less item followed by detailed ones acts as the list title
// (e.g. "First Insights").
const hasTitle = !isResearch && items.length > 1 && !items[0].body && items.slice(1).some((i) => i.body);
const listTitle = hasTitle ? items[0].label : null;
const rows = hasTitle ? items.slice(1) : items;
// "10/10 users" style rows → people pictogram (one figure per person).
const RATIO = /^(\d+)\s*\/\s*(\d+)\s*(.*)$/;
const ratios = !isResearch
  ? rows.map((r) => {
      const m = r.label.match(RATIO);
      if (!m || +m[2] > 20) return null;
      const text = m[3].replace(/:\s*$/, "");
      // Lowercase body = the same sentence continues ("users" + "completed…").
      const joins = !!r.body && /^[a-z]/.test(r.body);
      return { n: +m[1], d: +m[2], text: joins ? `${text} ${r.body}` : text, body: joins ? undefined : r.body };
    })
  : [];
const isRatio = ratios.length > 0 && ratios.every(Boolean);

// "69% less pages:" / "-37% support tickets:" lists → metric rows: the
// figure set large and thin, the rest of the label + body beside it.
const METRIC = /^([+\-−]?\d[\d.,]*\s*(?:%|x|×)?)\s*(.*?)\s*:?\s*$/;
const metrics =
  !isResearch && !isRatio
    ? rows.map((r) => {
        const m = r.label.match(METRIC);
        return m ? { fig: m[1].replace(/\s+/g, ""), label: m[2], body: r.body } : null;
      })
    : [];
const isMetric = metrics.length > 1 && metrics.every(Boolean);

const trimColon = (s: string) => s.replace(/:\s*$/, ".");
---

{
  isResearch ? (
    <div class="not-prose">
      <Scene
        beats={items.map((item) => ({
          label: item.label,
          caption: item.body ? trimColon(item.body) : "",
          quotes: item.sub,
        }))}
      />
    </div>
  ) : isRatio ? (
    <div class="ratio not-prose" data-ratio>
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="ratio-list">
        {ratios.map((r) => (
          <li class="ratio-row">
            <p class="ratio-num" aria-hidden="true">
              <span>{r!.n}</span>/{r!.d}
            </p>
            <span class="ratio-people" aria-hidden="true">
              {Array.from({ length: r!.d }, (_, k) => (
                <svg viewBox="0 0 12 20" class:list={["person", { "is-on": k < r!.n }]} style={`--k: ${k};`}>
                  <circle cx="6" cy="4" r="3" />
                  <path d="M1 19v-6.5C1 9.5 3.2 8 6 8s5 1.5 5 4.5V19z" />
                </svg>
              ))}
            </span>
            <p class="ratio-text">
              <span class="metric-label">
                <span class="sr-only">{r!.n} of {r!.d} </span>
                {r!.text}
              </span>
              {r!.body && <span class="metric-body">{r!.body}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : isMetric ? (
    <div class="metric not-prose">
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="ratio-list">
        {metrics.map((m) => (
          <li class="metric-row">
            <p class="metric-fig">{m!.fig}</p>
            <p class="metric-text">
              {m!.label && <span class="metric-label">{m!.label}</span>}
              {m!.body && <span class="metric-body">{m!.body}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="not-prose">
    {listTitle && <p class="checklist-title">{listTitle}</p>}
    <ul class="checklist">
      {rows.map((item) => (
        <li>
          <span class="check" aria-hidden="true">
            <svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </span>
          <span>
            <span class="check-label">{item.label}</span>
            {item.body && <span class="check-body">{" "}{item.body}</span>}
          </span>
        </li>
      ))}
    </ul>
    </div>
  )
}

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          (e.target as HTMLElement).setAttribute("data-in", "");
        });
      },
      { threshold: 0.25 },
    );
    document.querySelectorAll<HTMLElement>("[data-ratio]").forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.85) return;
      el.setAttribute("data-armed", "");
      io.observe(el);
    });
  }
</script>

<style>
  /* ---------- Ratio pictogram ("8/10 users …") ---------- */
  .ratio-list {
    border-top: 1px solid var(--color-ink);
  }
  .ratio-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "num text"
      "people people";
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .ratio-row {
      grid-template-columns: 7.5rem auto minmax(0, 1fr);
      grid-template-areas: "num people text";
      gap: 2rem;
      padding-block: 1.5rem;
    }
  }
  .ratio-num {
    grid-area: num;
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ratio-num span {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-ink);
  }
  .ratio-people {
    grid-area: people;
    display: flex;
    gap: 0.3rem;
  }
  .person {
    width: 0.85rem;
    height: 1.4rem;
    fill: transparent;
    stroke: var(--color-muted-soft);
    stroke-width: 1;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
    transition-delay: calc(var(--k) * 70ms);
  }
  @media (min-width: 900px) {
    .person {
      width: 1rem;
      height: 1.65rem;
    }
  }
  .person.is-on {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }
  .ratio[data-armed]:not([data-in]) .person.is-on {
    fill: transparent;
    stroke: var(--color-muted-soft);
  }
  .ratio-text {
    grid-area: text;
    display: grid;
    gap: 0.35rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-ink);
    max-width: 38rem;
  }

  /* ---------- Metric rows ("69% less pages") ---------- */
  .metric-row {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .metric-row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
      padding-block: 1.5rem;
    }
  }
  .metric-fig {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .metric-text {
    display: grid;
    gap: 0.35rem;
    max-width: 38rem;
  }
  .metric-label {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .metric-label::first-letter {
    text-transform: uppercase;
  }
  .metric-body {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* ---------- Plain list ---------- */
  .checklist-title {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .checklist {
    max-width: 42rem;
    border-top: 1px solid var(--color-border);
  }
  .checklist li {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .check {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    border-radius: 9999px;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .check svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .check-label {
    font-weight: 500;
    color: var(--color-ink);
  }
  .check-body {
    color: var(--color-muted);
  }
</style>
