---
import type { ChecklistItem } from "~/data/case-studies/types";
import Scene from "~/components/case-study/Scene.astro";
import PillarArt from "~/components/case-study/PillarArt.astro";

type Props = { items: readonly ChecklistItem[]; layout?: "cards" | "rings" | "chart" | "quotes" };
const { items, layout } = Astro.props;

// Items carrying quotes (`sub`) are research sources — rendered
// as a pinned scroll scene (same pattern as the iterations block): one beat
// per source, the users' own words set large.
// Everything else stays a clean hairline list.
const isResearch = items.length > 0 && items.every((i) => i.sub && i.sub.length > 0);

// A leading body-less item followed by detailed ones acts as the list title
// (e.g. "First Insights").
const hasTitle = !isResearch && items.length > 1 && !items[0].body && items.slice(1).some((i) => i.body);
// …unless that leading line is itself a result ("+20 pilots in less than
// 3 weeks.") — then it becomes the headline figure above the pillars.
const LEAD = /^([+\-−]?\d[\d.,]*\s*(?:%|x|×|k)?)\s+(.+)$/;
const leadMatch = hasTitle ? items[0].label.match(LEAD) : null;
const lead = leadMatch ? { fig: leadMatch[1].replace(/\s+/g, ""), text: leadMatch[2] } : null;
const listTitle = hasTitle && !lead ? items[0].label : null;
const rows = hasTitle ? items.slice(1) : items;
// "10/10 users" style rows → people pictogram (one figure per person).
const RATIO = /^(\d+)\s*\/\s*(\d+)\s*(.*)$/;
const ratios = !isResearch
  ? rows.map((r) => {
      const m = r.label.match(RATIO);
      if (!m || +m[2] > 20) return null;
      const text = m[3].replace(/:\s*$/, "");
      // Lowercase body = the same sentence continues ("users" + "completed…").
      const joins = !!r.body && /^[a-z]/.test(r.body);
      return { n: +m[1], d: +m[2], text: joins ? `${text} ${r.body}` : text, body: joins ? undefined : r.body };
    })
  : [];
const isRatio = ratios.length > 0 && ratios.every(Boolean);
// Chart layout: sorted by value, "users …" prefix dropped from the row name.
const chart = isRatio
  ? ratios
      .map((r) => ({
        n: r!.n,
        d: r!.d,
        pct: Math.round((r!.n / r!.d) * 100),
        val: `${r!.n}/${r!.d}`,
        heroMain: String(r!.n),
        heroSub: `/${r!.d}`,
        heroText: r!.text.replace(/^users\s+/i, "").replace(/^./, (c) => c.toUpperCase()),
        name: r!.text.replace(/^users\s+/i, "").replace(/^./, (c) => c.toUpperCase()),
        body: r!.body,
      }))
      .sort((a, b) => b.pct - a.pct)
  : [];
const sameD = isRatio && chart.every((r) => r.d === chart[0]?.d);

// "69% less pages:" / "-37% support tickets:" lists → metric rows: the
// figure set large and thin, the rest of the label + body beside it.
const METRIC = /^([+\-−]?\d[\d.,]*\s*(?:%|x|×)?)\s*(.*?)\s*:?\s*$/;
const metrics =
  !isResearch && !isRatio
    ? rows.map((r) => {
        const m = r.label.match(METRIC);
        if (!m) return null;
        // Lowercase body continues the label's sentence ("of users" + "indicated…").
        const joins = !!r.body && /^[a-z]/.test(r.body);
        const label = m[2].replace(/:\s*$/, "");
        return { fig: m[1].replace(/\s+/g, ""), label: joins ? `${label} ${r.body}` : label, body: joins ? undefined : r.body };
      })
    : [];
const isMetric = metrics.length > 1 && metrics.every(Boolean);
// Percent metrics can feed the chart too ("57% of users …").
if (layout === "chart" && !isRatio && isMetric && metrics.every((m) => m!.fig.endsWith("%"))) {
  metrics
    .map((m) => {
      const pct = parseFloat(m!.fig.replace(/[^\d.]/g, ""));
      return {
        n: pct,
        d: 100,
        pct,
        val: m!.fig,
        heroMain: m!.fig.replace("%", ""),
        heroSub: "%",
        heroText: m!.label.replace(/^./, (c) => c.toLowerCase()),
        name: m!.label.replace(/^of users\s+/i, "").replace(/^./, (c) => c.toUpperCase()),
        body: m!.body,
      };
    })
    .sort((a, b) => b.pct - a.pct)
    .forEach((r) => chart.push(r));
}
const isChart = layout === "chart" && chart.length > 0;
// Quotes: every item is a user's words — label + body read as one quote.
const quotes = items.map((i) => (i.body ? `${i.label.replace(/:\s*$/, "")} ${i.body}` : i.label));

// Label + body lists (2–4 items: "Activation: How do we…") → pillars: a
// hairline grid with mono numbers, the label as title, the body beneath.
// Bodies that are questions are set larger — they are the point.
const isPillars =
  !isResearch && !isRatio && !isMetric && rows.length >= 2 && rows.length <= 4 && rows.every((r) => r.body);
const stripColon = (s: string) => s.replace(/\s*:\s*$/, "");
// Same rule as above: a lowercase body is the rest of the label's sentence.
const pillars = rows.map((r) =>
  r.body && /^[a-z]/.test(r.body)
    ? { title: `${stripColon(r.label)} ${r.body}`, body: undefined, art: r.art }
    : { title: stripColon(r.label), body: r.body, art: r.art },
);
// Questions get the large setting only when every body is one.
const allQuestions = pillars.every((p) => !p.body || /\?\s*$/.test(p.body)) && pillars.some((p) => p.body);
const trimColon = (s: string) => s.replace(/:\s*$/, ".");
---

{
  isResearch ? (
    <div class="not-prose">
      <Scene
        beats={items.map((item) => ({
          label: item.label,
          caption: item.body ? trimColon(item.body) : "",
          quotes: item.sub,
        }))}
      />
    </div>
  ) : layout === "quotes" && !isResearch ? (
    <ul class="qt not-prose">
      {quotes.map((q) => (
        <li>
          <q>{q.replace(/^[“"]|[”"]$/g, "")}</q>
        </li>
      ))}
    </ul>
  ) : isChart ? (
    <div class="ratio ratio--chart not-prose" data-ratio>
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <div class="ch">
        {sameD && <p class="ch-head mono">n = {chart[0].d}</p>}
        <ul class="ch-rows">
          {chart.map((r, i) => (
            <li class="ch-row" style={`--pct: ${r.pct}; --i: ${i};`}>
              <p class="ch-top">
                <span class="ch-label">{r.name}</span>
                <span class="ch-val">
                  {r.val}
                  {r.val !== `${r.pct}%` && <span class="sr-only"> ({r.pct}%)</span>}
                </span>
              </p>
              <span class="ch-track" aria-hidden="true">
                <span class="ch-bar" />
                <span class="ch-knob" />
              </span>
              {r.body && <p class="ch-body">{r.body}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : isRatio && layout === "rings" ? (
    <div class="ratio ratio--rings not-prose" data-ratio>
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="rings">
        {ratios.map((r, i) => (
          <li class="ring-col" style={`--i: ${i};`}>
            <svg class="rg-svg" viewBox="0 0 120 120" aria-hidden="true">
              {Array.from({ length: r!.d }, (_, k) => (
                <circle
                  class:list={["rg-seg", { "is-on": k < r!.n }]}
                  cx="60"
                  cy="60"
                  r="52"
                  pathLength="100"
                  style={`--seg: ${100 / r!.d - 3}; --off: ${-(k * 100) / r!.d - 1.5}; --k: ${k};`}
                />
              ))}
              <text class="rg-n" x="60" y="68" text-anchor="middle">
                {r!.n}
                <tspan class="rg-d">/{r!.d}</tspan>
              </text>
            </svg>
            <p class="ratio-text">
              <span class="metric-label">
                <span class="sr-only">{r!.n} of {r!.d}{" "}</span>
                {r!.text}
              </span>
              {r!.body && <span class="metric-body">{r!.body}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : isRatio ? (
    <div class:list={["ratio not-prose", { "ratio--cards": layout === "cards" }]} data-ratio>
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="ratio-list">
        {ratios.map((r) => (
          <li class="ratio-row">
            <p class="ratio-num" aria-hidden="true">
              <span>{r!.n}</span>/{r!.d}
            </p>
            <span class="ratio-people" aria-hidden="true">
              {Array.from({ length: r!.d }, (_, k) => (
                <svg viewBox="0 0 12 20" class:list={["person", { "is-on": k < r!.n }]} style={`--k: ${k};`}>
                  <circle cx="6" cy="4" r="3" />
                  <path d="M1 19v-6.5C1 9.5 3.2 8 6 8s5 1.5 5 4.5V19z" />
                </svg>
              ))}
            </span>
            <p class="ratio-text">
              <span class="metric-label">
                <span class="sr-only">{r!.n} of {r!.d}{" "}</span>
                {r!.text}
              </span>
              {r!.body && <span class="metric-body">{r!.body}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : isMetric ? (
    <div class="metric not-prose">
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      <ul class="ratio-list">
        {metrics.map((m) => (
          <li class="metric-row">
            <p class="metric-fig">{m!.fig}</p>
            <p class="metric-text">
              {m!.label && <span class="metric-label">{m!.label}</span>}
              {m!.body && <span class="metric-body">{m!.body}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : isPillars ? (
    <div class="pillars not-prose">
      {listTitle && <p class="checklist-title">{listTitle}</p>}
      {lead && (
        <p class="pillars-lead">
          <span class="metric-fig">{lead.fig}</span>
          <span class="pillars-lead-text">{lead.text}</span>
        </p>
      )}
      <ol class:list={["pillars-grid", `n-${rows.length}`]}>
        {pillars.map((pl, i) => (
          <li class="pillar">
            {pl.art && <PillarArt kind={pl.art} />}
            <span class="pillar-num mono">{String(i + 1).padStart(2, "0")}</span>
            <h4 class="pillar-title">{pl.title}</h4>
            {pl.body && <p class:list={["pillar-body", { "is-question": allQuestions }]}>{pl.body}</p>}
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="not-prose">
    {listTitle && <p class="checklist-title">{listTitle}</p>}
    <ul class="checklist">
      {rows.map((item) => (
        <li>
          <span class="check" aria-hidden="true">
            <svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </span>
          <span>
            <span class="check-label">{item.label}</span>
            {item.body && <span class="check-body">{" "}{item.body}</span>}
          </span>
        </li>
      ))}
    </ul>
    </div>
  )
}

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          (e.target as HTMLElement).setAttribute("data-in", "");
        });
      },
      { threshold: 0.25 },
    );
    document.querySelectorAll<HTMLElement>("[data-ratio]").forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.85) return;
      el.setAttribute("data-armed", "");
      io.observe(el);
    });
  }
</script>

<style>
  /* ---------- Ratio pictogram ("8/10 users …") ---------- */
  .ratio-list {
    border-top: 1px solid var(--color-ink);
  }
  .ratio-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "num text"
      "people people";
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .ratio-row {
      grid-template-columns: 7.5rem auto minmax(0, 1fr);
      grid-template-areas: "num people text";
      gap: 2rem;
      padding-block: 1.5rem;
    }
  }
  .ratio-num {
    grid-area: num;
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: -0.03em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ratio-num span {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-ink);
  }
  .ratio-people {
    grid-area: people;
    display: flex;
    gap: 0.3rem;
  }
  .person {
    width: 0.85rem;
    height: 1.4rem;
    fill: transparent;
    stroke: var(--color-muted-soft);
    stroke-width: 1;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
    transition-delay: calc(var(--k) * 70ms);
  }
  @media (min-width: 900px) {
    .person {
      width: 1rem;
      height: 1.65rem;
    }
  }
  .person.is-on {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }
  .ratio[data-armed]:not([data-in]) .person.is-on {
    fill: transparent;
    stroke: var(--color-muted-soft);
  }
  .ratio-text {
    grid-area: text;
    display: grid;
    gap: 0.35rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-ink);
    max-width: 38rem;
  }

  /* Cards: side-by-side stat cards (number, sentence, 2×5 people). */
  .ratio--cards .ratio-list {
    display: grid;
    gap: 1rem;
    border-top: 0;
  }
  @media (min-width: 640px) {
    .ratio--cards .ratio-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ratio--cards .ratio-row {
    grid-template-columns: 1fr;
    grid-template-areas: "num" "text" "people";
    align-content: start;
    gap: 1.25rem;
    padding: 1.75rem;
    border: 0;
    border-radius: var(--radius-xs);
    background: var(--color-paper-soft);
  }
  @media (min-width: 900px) {
    .ratio--cards .ratio-row {
      grid-template-columns: 1fr;
      grid-template-areas: "num" "text" "people";
      padding: 2.25rem;
    }
  }
  .ratio--cards .ratio-num span {
    font-size: clamp(3rem, 5vw, 4.5rem);
  }
  .ratio--cards .ratio-text {
    max-width: 22ch;
  }
  .ratio--cards .metric-label {
    font-size: 1.375rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .ratio--cards .ratio-people {
    display: grid;
    grid-template-columns: repeat(5, max-content);
    gap: 0.6rem 0.9rem;
    margin-top: 0.5rem;
  }
  .ratio--cards .person {
    width: 1.1rem;
    height: 1.8rem;
  }

  /* Quotes: users' own words as pull quotes on hairlines. */
  .qt {
    border-top: 1px solid var(--color-ink);
  }
  .qt li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .qt li:last-child {
    border-bottom: 0;
  }
  .qt q {
    display: block;
    position: relative;
    padding-left: 1.4rem;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    quotes: none;
  }
  .qt q::before {
    content: "“";
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.2;
    color: var(--color-accent);
  }

  /* Chart: compact widget card (Karta "limit control" / Ramp) — label and
     value on one line, a hairline track with a thin fill and a small knob,
     the "why" underneath. Sorted by value. */
  .ch {
    max-width: 40rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background: var(--color-paper);
  }
  .ch-head {
    padding-block: 0.85rem 0.35rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .ch-row {
    padding-block: 1.1rem 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .ch-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .ch-label {
    font-size: 0.9375rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .ch-val {
    flex-shrink: 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  .ch-track {
    position: relative;
    display: block;
    height: 2px;
    margin-top: 0.85rem;
    background: var(--color-border);
  }
  .ch-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: calc(var(--pct) * 1%);
    background: var(--color-ink);
    transform-origin: left;
  }
  .ch-knob {
    position: absolute;
    top: 50%;
    left: calc(var(--pct) * 1%);
    width: 0.9rem;
    height: 0.55rem;
    border: 1px solid var(--color-ink);
    border-radius: 9999px;
    background: var(--color-paper);
    transform: translate(-50%, -50%);
  }
  .ch-row:first-child .ch-knob {
    background: var(--color-accent);
  }
  .ch-bar,
  .ch-knob {
    transition:
      transform 1s cubic-bezier(0.22, 1, 0.36, 1),
      left 1s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 120ms);
  }
  .ratio--chart[data-armed]:not([data-in]) .ch-bar {
    transform: scaleX(0);
  }
  .ratio--chart[data-armed]:not([data-in]) .ch-knob {
    left: 0;
  }
  .ch-body {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* Rings: a column per stat — progress ring with the fraction inside,
     one tick per person on the ring, the sentence underneath. */
  .rings {
    display: grid;
    gap: 2.25rem;
    border-top: 1px solid var(--color-ink);
    padding-top: 2rem;
  }
  @media (min-width: 640px) {
    .rings {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
      gap: 2rem;
    }
  }
  .ring-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .rg-svg {
    flex-shrink: 0;
    width: 8.5rem;
    height: 8.5rem;
    overflow: visible;
  }
  /* Phones: ring beside the sentence to keep the block short. */
  @media (max-width: 639px) {
    .ring-col {
      flex-direction: row;
      align-items: center;
    }
    .rg-svg {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
  /* One arc per person, small gaps between them. */
  .rg-seg {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 7;
    stroke-dasharray: var(--seg) 100;
    stroke-dashoffset: var(--off);
    transform: rotate(-90deg);
    transform-origin: 60px 60px;
    transition: stroke 0.4s ease;
    transition-delay: calc(var(--i, 0) * 150ms + var(--k) * 90ms);
  }
  .rg-seg.is-on {
    stroke: var(--color-ink);
  }
  .rg-n {
    font-size: 36px;
    font-weight: 300;
    letter-spacing: -0.04em;
    fill: var(--color-ink);
  }
  .rg-d {
    font-size: 15px;
    fill: var(--color-muted);
  }
  .ratio--rings[data-armed]:not([data-in]) .rg-seg.is-on {
    stroke: var(--color-border);
  }
  .ratio--rings .ratio-text {
    max-width: 28ch;
  }

  /* ---------- Metric rows ("69% less pages") ---------- */
  .metric-row {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .metric-row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
      padding-block: 1.5rem;
    }
  }
  .metric-fig {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .metric-text {
    display: grid;
    gap: 0.35rem;
    max-width: 38rem;
  }
  .metric-label {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .metric-label::first-letter {
    text-transform: uppercase;
  }
  .metric-body {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* ---------- Pillars (label + body lists) ---------- */
  .pillars-lead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 1.75rem;
  }
  .pillars-lead-text {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .pillars-grid {
    display: grid;
    border-top: 1px solid var(--color-ink);
  }
  @media (min-width: 640px) {
    .pillars-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pillars-grid.n-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .pillar {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 0 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .pillar {
