---
/*
 * "Testing the entire product" mark (Legalario): a phone frame running a
 * face scan — corner brackets lock on, mesh points light up, a teal scan
 * line sweeps — beside a column of test runs ticking off one by one.
 * Same line vocabulary as the site's drawings: 1px ink, one teal accent.
 * Plays once in view; final state without JS / under reduced motion.
 */
const mesh = [
  [44, 40], [56, 40], [50, 48], [42, 54], [58, 54], [50, 60], [46, 66], [54, 66], [50, 34],
];
const runs = [0, 1, 2, 3];
---

<div class="fs" data-facescan aria-hidden="true">
  <svg viewBox="0 0 200 120" fill="none">
    <!-- Phone -->
    <rect class="fs-line" x="18" y="6" width="64" height="108" rx="9" pathLength="1" />
    <path class="fs-faint" d="M42 12h16" />
    <!-- Face -->
    <ellipse class="fs-line" cx="50" cy="52" rx="15" ry="19" pathLength="1" />
    <path class="fs-faint" d="M38 78c3-5 7-7 12-7s9 2 12 7" />
    <!-- Brackets -->
    <g class="fs-brackets">
      <path d="M30 30v-6h6M70 30v-6h-6M30 76v6h6M70 76v6h-6" />
    </g>
    <!-- Mesh -->
    {mesh.map(([x, y], i) => <circle class="fs-dot" cx={x} cy={y} r="1.3" style={`--i:${i}`} />)}
    <!-- Scan -->
    <line class="fs-scan" x1="28" y1="30" x2="72" y2="30" />

    <!-- Test runs -->
    {
      runs.map((r) => (
        <g class="fs-run" style={`--r:${r}`}>
          <rect class="fs-row" x="100" y={14 + r * 24} width="84" height="16" rx="3" />
          <path class="fs-bar" d={`M108 ${22 + r * 24}h${r === 3 ? 44 : 52 - r * 6}`} />
          <circle class:list={["fs-tick-bg", { "is-acc": r === 3 }]} cx="174" cy={22 + r * 24} r="5" />
          <path class="fs-tick" d={`M171.6 ${22 + r * 24}l1.8 1.8 3.2-3.6`} />
        </g>
      ))
    }
  </svg>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-facescan]").forEach((el) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
    el.setAttribute("data-armed", "");
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        el.setAttribute("data-play", "");
        io.disconnect();
      },
      { threshold: 0.5 },
    );
    io.observe(el);
  });
</script>

<style>
  .fs {
    width: 13rem;
    max-width: 100%;
  }
  .fs svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .fs path,
  .fs rect,
  .fs ellipse,
  .fs line,
  .fs circle {
    vector-effect: non-scaling-stroke;
  }
  .fs-line {
    stroke: var(--color-ink);
    stroke-width: 1;
  }
  .fs-faint {
    stroke: var(--color-muted-soft);
    stroke-width: 1;
    stroke-linecap: round;
  }
  .fs-brackets path {
    stroke: var(--color-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fs-dot {
    fill: var(--color-ink);
  }
  .fs-scan {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0;
  }
  .fs-row {
    stroke: var(--color-border);
    fill: var(--color-paper);
  }
  .fs-bar {
    stroke: var(--color-muted-soft);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .fs-tick-bg {
    fill: var(--color-ink);
  }
  .fs-tick-bg.is-acc {
    fill: var(--color-accent);
  }
  .fs-tick {
    stroke: var(--color-paper);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fs-run:last-child .fs-tick {
    stroke: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .fs[data-armed] .fs-line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .fs[data-armed] .fs-brackets {
      opacity: 0;
      transform: scale(1.25);
      transform-origin: 50px 53px;
    }
    .fs[data-armed] .fs-dot,
    .fs[data-armed] .fs-run {
      opacity: 0;
    }
    .fs[data-armed] .fs-run {
      transform: translateX(-6px);
    }
    .fs[data-play] .fs-line {
      animation: fs-draw 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .fs[data-play] .fs-brackets {
      animation: fs-lock 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;
    }
    .fs[data-play] .fs-dot {
      animation: fs-in 0.3s ease forwards;
      animation-delay: calc(1.1s + var(--i) * 0.08s);
    }
    .fs[data-play] .fs-scan {
      animation: fs-sweep 2.6s ease-in-out 1.6s infinite;
    }
    .fs[data-play] .fs-run {
      animation: fs-run 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(1.4s + var(--r) * 0.35s);
    }
  }
  @keyframes fs-draw {
    99% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 0;
      stroke-dasharray: none;
    }
  }
  @keyframes fs-lock {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fs-in {
    to {
      opacity: 1;
    }
  }
  @keyframes fs-run {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes fs-sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    12% {
      opacity: 1;
    }
    50% {
      opacity: 1;
      transform: translateY(46px);
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
</style>
