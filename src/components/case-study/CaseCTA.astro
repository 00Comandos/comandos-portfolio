---
type Props = { brand: string };
const { brand } = Astro.props;
// `.hl` pills are 1–2 words; longer brand names stay plain text.
const pill = brand.trim().split(/\s+/).length <= 2;
---

<!-- Quiet partnership close (Karta "Partnership" row): hairline-bordered,
     generic for every case via the project's brand name. -->
<section class="cta-case" aria-labelledby="cta-case-heading">
  <div class="container-page">
    <div class="cta-case-row">
      <p class="eyebrow cta-case-label">Work with us</p>
      <div class="cta-case-copy">
        <h2 id="cta-case-heading" class="cta-case-title">
          Grow like {pill ? <span class="hl">{brand}</span> : brand}
        </h2>
        <p class="cta-case-body">A 30-minute call. Your product, our process.</p>
      </div>
      <a href="/contact/?type=discovery" class="btn-primary cta-case-btn">Book a discovery call</a>
    </div>
  </div>
</section>

<style>
  /* Full-width hairline on top; RelatedCases' own top rule closes it. */
  .cta-case {
    border-top: 1px solid var(--color-border);
  }
  .cta-case-row {
    display: grid;
    gap: 1rem;
    padding-block: 2.25rem 2.5rem;
  }
  .cta-case-label {
    color: var(--color-muted);
  }
  .cta-case-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .cta-case-body {
    margin-top: 0.4rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .cta-case-btn {
    justify-self: start;
    margin-top: 0.5rem;
  }
  @media (min-width: 900px) {
    .cta-case-row {
      grid-template-columns: minmax(0, 39fr) minmax(0, 61fr) auto;
      align-items: center;
      column-gap: 2rem;
      padding-block: 2.75rem;
    }
    .cta-case-label {
      align-self: start;
      padding-top: 0.6rem;
    }
    .cta-case-btn {
      margin-top: 0;
      justify-self: end;
    }
  }
</style>
