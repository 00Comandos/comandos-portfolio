---
import type { ContentVideo } from "~/data/case-studies/types";

type Props = { video: ContentVideo; line: string };
const { video, line } = Astro.props;
---

<!-- Edge-to-edge video moment. Rendered outside `.cs-body` (Worth splits
     its blocks around it) so it spans the viewport without 100vw math. -->
<figure class="bleed" data-bleed>
  <video
    class="bleed-video"
    poster={video.poster}
    muted
    loop
    playsinline
    preload="none"
    data-bleed-video
    aria-label={video.alt}
  >
    {video.mobileSrc && <source src={video.mobileSrc} media="(max-width: 767px)" />}
    <source src={video.src} />
  </video>
  <figcaption class="bleed-line">{line}</figcaption>
</figure>

<style>
  .bleed {
    position: relative;
    width: 100%;
    height: min(100svh, 125vw);
    max-height: 40rem;
    overflow: hidden;
    background: var(--color-ink);
  }
  @media (min-width: 768px) {
    .bleed {
      height: min(100svh, 62vw);
      max-height: none;
    }
  }
  .bleed-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bleed::after {
    content: "";
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(to top, rgb(6 6 6 / 0.62), rgb(6 6 6 / 0));
    pointer-events: none;
  }
  .bleed-line {
    position: absolute;
    z-index: 1;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.5rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-paper);
  }
  @media (min-width: 768px) {
    .bleed-line {
      left: 2.375rem;
      bottom: 2.5rem;
    }
  }
</style>

<script>
  // Play only while the band is on screen; poster only under reduced motion.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const vids = document.querySelectorAll<HTMLVideoElement>("video[data-bleed-video]");
  if (vids.length && !reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.15 },
    );
    vids.forEach((v) => io.observe(v));
  }
</script>
