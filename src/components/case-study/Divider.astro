---
/* Plain 1px hairline. `variant` is accepted for backwards compatibility
   with content data ("hatched" | "line") but always renders the hairline. */
type Props = {
  tone?: "dark" | "light";
  variant?: "hatched" | "line";
};
const { tone = "light" } = Astro.props;

const lineColor = tone === "dark" ? "rgba(255,255,255,0.2)" : "var(--color-border)";
---

<hr
  class="my-10 md:my-14 border-0 h-px w-full"
  aria-hidden="true"
  style={`background-color: ${lineColor};`}
/>
