---
import { caseChrome } from "~/i18n/case-chrome";
import { getLang, localizedPath } from "~/i18n";
import { Image } from "astro:assets";
import type { Project } from "~/data/projects";
import { homeWorkCopy } from "~/data/home-work-i18n";
import { splitCaseTitle } from "~/lib/case-title";

type Props = { cases: readonly Project[] };
const { cases } = Astro.props;
const lang = getLang(Astro.url);
const c = caseChrome[lang];

// Same tile language as the home CaseGrid. Title is the cleaned case name
// (not the brand) so sibling cases from one client stay distinguishable.
const tiles = cases.map((c) => ({
  slug: c.slug,
  name: splitCaseTitle(c.title).name,
  alt: c.title,
  image: c.image,
  impact: c.impact,
  tags: (homeWorkCopy[lang] ?? homeWorkCopy.en)[c.slug]?.tags ?? [],
}));
---

<section aria-labelledby="related-heading" class="rc">
  <div class="container-page">
    <div class="rc-head">
      <h2 id="related-heading" class="display-serif rc-title">
        {c.related}
      </h2>
      <a href={c.projectsHref} class="btn-outline rc-all">{c.allProjects}</a>
    </div>

    <ul class="rc-list">
      {
        tiles.map((t) => (
          <li>
            <a href={`${c.projectsHref}${t.slug}/`} class="rc-link">
              <span class="rc-media">
                <Image
                  src={t.image}
                  alt={t.alt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="rc-img"
                />
              </span>
              <span class="rc-meta">
                <span class="rc-name">{t.name}</span>
                <span class="rc-impact">{t.impact}</span>
                {t.tags.length > 0 && (
                  <span class="rc-tags">
                    {t.tags.map((tag) => (
                      <span class="rc-tag">{tag}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rc {
    padding-block: 4rem 4.5rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .rc {
      padding-block: 6rem 7rem;
    }
  }

  .rc-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .rc-head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 3.5rem;
    }
  }
  .rc-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    max-width: 16ch;
  }
  .rc-all {
    flex-shrink: 0;
  }

  .rc-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 3rem;
  }
  @media (min-width: 768px) {
    .rc-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.125rem;
      align-items: start;
    }
  }

  .rc-link {
    display: block;
    color: var(--color-ink);
  }
  .rc-media {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-grey);
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 768px) {
    .rc-media {
      aspect-ratio: 16 / 9;
    }
  }
  .rc-media :global(.rc-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rc-link:hover :global(.rc-img) {
    transform: scale(1.04);
  }

  .rc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .rc-name {
    flex-basis: 100%;
    font-size: clamp(1.375rem, 1.8vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .rc-impact {
    font-size: 0.875rem;
    color: var(--color-muted);
    letter-spacing: -0.01em;
  }
  .rc-tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .rc-tag {
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
  }
  .rc-name::after {
    content: "";
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.5rem;
    vertical-align: middle;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .rc-link:hover .rc-name::after {
    opacity: 1;
    transform: none;
  }
</style>
