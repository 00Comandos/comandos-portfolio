---
import { widthAtHeight } from "~/lib/public-image-size";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ContentImage from "~/components/case-study/ContentImage.astro";
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import type { CaseStudyContent } from "~/data/case-studies/types";
import { splitCaseTitle } from "~/lib/case-title";
import { caseChrome } from "~/i18n/case-chrome";
import { getLang } from "~/i18n";

type Props = {
  content: CaseStudyContent;
  fallbackImage: ImageMetadata;
  /** Full SEO title — used for alt text; the H1 shows a cleaner split. */
  title: string;
  brand: string;
  description: string;
  impact: string;
  timeline: string;
};

const { content, fallbackImage, title, brand, description, impact, timeline } =
  Astro.props;

const c = caseChrome[getLang(Astro.url)];
const { name, tagline } = splitCaseTitle(title);
const introParagraphs = content.hero.intro.split(/\n\n+/);

// Hairline meta table — only cells backed by real data.
const meta = [
  { label: c.client, value: brand },
  { label: c.industry, value: content.kicker },
  { label: c.timeline, value: timeline },
  { label: c.impact, value: impact },
].filter((m) => m.value && m.value.trim().length > 0);

// Full-bleed hero: edge to edge at every width — unless the case opts into a
// contained hero on a colour band (`hero.backdrop`).
const backdrop = content.hero.backdrop;
const heroSizes = backdrop ? "(min-width: 1024px) 860px, 100vw" : "100vw";
const heroWidths = [640, 960, 1280, 1600, 1920, 2560];
// Logo width at its display height (prevents layout shift).
const logoWidth =
  content.brandLogo?.kind === "public"
    ? await widthAtHeight(content.brandLogo.src, content.brandLogo.height ?? 28)
    : undefined;
---

<section class="csh">
  <div class="container-page csh-top">
    <div class="csh-left">
      <a href={c.projectsHref} class="btn-link csh-back">
        <span class="rotate-180 inline-block"><ArrowIcon /></span>
        {c.allProjects}
      </a>
      {
        content.brandLogo?.kind === "public" ? (
          <img
            src={content.brandLogo.src}
            alt={content.brandLogo.alt}
            height={content.brandLogo.height ?? 28}
            width={logoWidth}
            style={`height: ${content.brandLogo.height ?? 28}px; width: auto;`}
            class="csh-logo"
            loading="eager"
            decoding="async"
          />
        ) : (
          <p class="csh-brand">{brand}</p>
        )
      }
    </div>

    <div class="csh-right">
      <h1 class="csh-title">
        {name}
        {tagline && (
          <>
            {" "}
            <span class="csh-tag">
              <span class="hl">{tagline}</span>
            </span>
          </>
        )}
      </h1>
      <p class="csh-desc">{description}</p>
    </div>
  </div>

  <div class="container-page">
    <dl class="csh-meta">
      {
        meta.map((m) => (
          <div class="csh-cell">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div
    class:list={["csh-media", backdrop && "csh-media--band", backdrop?.align === "end" && "csh-media--end", backdrop?.fade && "csh-media--fade", backdrop?.card && "csh-media--card"]}
    style={backdrop
      ? `--csh-band: ${backdrop.color}; --csh-band-until: ${backdrop.until ?? 100}%;`
      : undefined}
  >
    {
      content.hero.mobileStack && content.hero.mobileStack.length > 0 ? (
        <>
          <div class="hidden md:block csh-frame">
            {content.hero.image ? (
              <ContentImage
                image={content.hero.image}
                priority
                sizes={heroSizes}
                widths={heroWidths}
              />
            ) : (
              <Image
                src={fallbackImage}
                alt={title}
                widths={heroWidths}
                sizes={heroSizes}
                loading="eager"
                decoding="async"
                class="w-full h-auto object-cover aspect-[16/9]"
              />
            )}
          </div>
          <div class="md:hidden space-y-4">
            {content.hero.mobileStack.map((img) => (
              <div class="csh-frame">
                <ContentImage image={img} priority sizes="100vw" />
              </div>
            ))}
          </div>
        </>
      ) : content.hero.video ? (
        <div class="csh-frame">
          <video
            class="csh-video"
            src={content.hero.video.src}
            poster={content.hero.video.poster}
            width="1600"
            height="1000"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            aria-label={content.hero.video.alt}
          />
        </div>
      ) : content.hero.image ? (
        <div class="csh-frame">
          <ContentImage
            image={content.hero.image}
            priority
            sizes={heroSizes}
            widths={heroWidths}
          />
        </div>
      ) : (
        <div class="csh-frame">
          <Image
            src={fallbackImage}
            alt={title}
            widths={heroWidths}
            sizes={heroSizes}
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover aspect-[16/9]"
          />
        </div>
      )
    }
  </div>

  <div class="cs-body csh-intro">
    <div class="space-y-4 text-[1.0625rem] leading-[1.65] text-[color:var(--color-ink-soft)]">
      {introParagraphs.map((p) => <p>{p}</p>)}
      {
        content.hero.bullets && content.hero.bullets.length > 0 && (
          <ul class="pl-5 space-y-1 list-disc marker:text-[color:var(--color-ink)]">
            {content.hero.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .csh {
    padding-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .csh {
      padding-bottom: 4rem;
    }
  }

  /* Asymmetric 39/61 split — mirrors the home hero. */
  .csh-top {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .csh-top {
      grid-template-columns: 39fr 61fr;
      gap: 0;
      padding-top: 3rem;
      padding-bottom: 3.5rem;
      min-height: 22rem;
    }
  }
  .csh-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }
  .csh-back {
    position: relative;
    font-size: 0.875rem;
  }
  /* Invisible 44px hit area around the small text link (touch). */
  .csh-back::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.5rem;
  }
  .csh-logo {
    display: block;
  }
  .csh-brand {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .csh-right {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .csh-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.5rem, 4.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--color-ink);
    overflow-wrap: break-word;
  }
  /* Smallest phones: long single-word names ("RebajaTusCuentas") are
     wider than a 320px column at the 2.5rem floor. */
  @media (max-width: 359px) {
    .csh-title {
      font-size: 2rem;
    }
  }
  /* Phones: the tagline pill always wraps. Give the stacked pill rows air
     (at 1.02 they overlap), avoid a one-word last row, and keep the pill's
     side padding inside the column. */
  @media (max-width: 767px) {
    .csh-title {
      line-height: 1.2;
      text-wrap: pretty;
      padding-right: 0.4em;
    }
    /* Taglines are 3–5 words: the global ≥640px nowrap pushed the longest
       ("+52% IoT Hardware Activation Rate") past the column at 640–700px. */
    .csh-title .hl {
      white-space: normal;
    }
  }
  /* Tagline on its own line (was a <br>); as a block it can balance, so
     a wrapped pill splits evenly instead of leaving one word alone. */
  .csh-tag {
    display: block;
    text-wrap: balance;
  }
  .csh-desc {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--color-muted);
  }

  /* Hairline meta table. */
  .csh-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
  }
  @media (min-width: 1024px) {
    .csh-meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .csh-cell {
    padding: 0.9rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .csh-cell:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .csh-cell,
    .csh-cell:nth-child(even) {
      padding: 0.9rem 1.5rem 1.25rem;
      border-left: 1px solid var(--color-border);
    }
    .csh-cell:first-child {
      padding-left: 0;
      border-left: none;
    }
  }
  .csh-cell dt {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--color-muted);
  }
  .csh-cell dd {
    overflow-wrap: anywhere;
    margin-top: 0.35rem;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .csh-media {
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .csh-media {
      margin-top: 3rem;
    }
  }
  /* No backdrop: transparent heroes (e.g. Karta's floating card) sit
     straight on the page. */
  .csh-frame {
    overflow: hidden;
  }
  /* Full-bleed: no radius, image fills the viewport width. */
  .csh-frame :global(img),
  .csh-frame :global(video) {
    display: block;
    width: 100%;
    border-radius: 0 !important;
  }

  /* Contained hero on a full-width colour band (opt-in via hero.backdrop).
     The band is the image's own backdrop colour, so the picture's coloured
     area runs edge to edge; it stops at --csh-band-until (% of the image
     height), letting whatever sits below (the phone) rest on the page. */
  .csh-media--band {
    position: relative;
    isolation: isolate;
  }
  .csh-media--band::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: var(--csh-band-until);
    background: var(--csh-band);
    z-index: -1;
  }
  .csh-media--band .csh-frame {
    max-width: 860px;
    margin-inline: auto;
  }
  /* Complete screenshot as a card floating on the band. */
  .csh-media--card {
    padding: 2rem 1.25rem;
  }
  @media (min-width: 768px) {
    .csh-media--card {
      padding: 4rem 2rem;
    }
  }
  .csh-media--card .csh-frame {
    max-width: 920px;
    border-radius: 0.75rem;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 30px 60px -20px rgb(0 60 30 / 0.45);
  }
  .csh-media--card .csh-frame :global(img) {
    border-radius: 0.75rem !important;
  }
  /* Centred cropped screenshot: its cut right/bottom edges dissolve into
     the band instead of ending on a hard line. */
  .csh-media--fade {
    padding-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .csh-media--fade {
      padding-top: 3rem;
    }
  }
  .csh-media--fade .csh-frame :global(img) {
    -webkit-mask-image:
      linear-gradient(to right, #000 80%, transparent 99%),
      linear-gradient(to bottom, #000 72%, transparent 99%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, #000 80%, transparent 99%),
      linear-gradient(to bottom, #000 72%, transparent 99%);
    mask-composite: intersect;
  }
  /* Cropped screenshot: let its cut edges meet the band's right and bottom
     edges so it reads as sliding out of frame, not as a broken image. */
  .csh-media--end {
    padding-top: 1rem;
  }
  .csh-media--end .csh-frame {
    width: 90%;
    max-width: none;
    margin-left: auto;
    margin-right: 0;
  }
  @media (min-width: 768px) {
    .csh-media--end {
      padding-top: 1.5rem;
    }
    .csh-media--end .csh-frame {
      width: 64%;
    }
  }

  .csh-intro {
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .csh-intro {
      margin-top: 4rem;
    }
  }
  .csh-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
  }
</style>

<script>
  // Reduced motion: keep the hero video on its poster frame.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLVideoElement>(".csh-video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
    });
  }
</script>
