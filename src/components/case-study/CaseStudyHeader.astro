---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ContentImage from "~/components/case-study/ContentImage.astro";
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import type { CaseStudyContent } from "~/data/case-studies/types";
import { splitCaseTitle } from "~/lib/case-title";

type Props = {
  content: CaseStudyContent;
  fallbackImage: ImageMetadata;
  /** Full SEO title — used for alt text; the H1 shows a cleaner split. */
  title: string;
  brand: string;
  description: string;
  impact: string;
  timeline: string;
};

const { content, fallbackImage, title, brand, description, impact, timeline } =
  Astro.props;

const { name, tagline } = splitCaseTitle(title);
const introParagraphs = content.hero.intro.split(/\n\n+/);

// Hairline meta table — only cells backed by real data.
const meta = [
  { label: "Client", value: brand },
  { label: "Industry", value: content.kicker },
  { label: "Timeline", value: timeline },
  { label: "Impact", value: impact },
].filter((m) => m.value && m.value.trim().length > 0);

const heroSizes = "(min-width: 1440px) 1364px, calc(100vw - 2.5rem)";
const heroWidths = [640, 960, 1280, 1600, 1920];
---

<section class="csh">
  <div class="container-page csh-top">
    <div class="csh-left">
      <a href="/projects/" class="btn-link csh-back">
        <span class="rotate-180 inline-block"><ArrowIcon /></span>
        All projects
      </a>
      {
        content.brandLogo?.kind === "public" ? (
          <img
            src={content.brandLogo.src}
            alt={content.brandLogo.alt}
            height={content.brandLogo.height ?? 28}
            style={`height: ${content.brandLogo.height ?? 28}px; width: auto;`}
            class="csh-logo"
            loading="eager"
            decoding="async"
          />
        ) : (
          <p class="csh-brand">{brand}</p>
        )
      }
    </div>

    <div class="csh-right">
      <h1 class="csh-title">
        {name}
        {tagline && (
          <>
            <br />
            <span class="hl">{tagline}</span>
          </>
        )}
      </h1>
      <p class="csh-desc">{description}</p>
    </div>
  </div>

  <div class="container-page">
    <dl class="csh-meta">
      {
        meta.map((m) => (
          <div class="csh-cell">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="container-page csh-media">
    {
      content.hero.mobileStack && content.hero.mobileStack.length > 0 ? (
        <>
          <div class="hidden md:block csh-frame">
            {content.hero.image ? (
              <ContentImage
                image={content.hero.image}
                priority
                sizes={heroSizes}
                widths={heroWidths}
              />
            ) : (
              <Image
                src={fallbackImage}
                alt={title}
                widths={heroWidths}
                sizes={heroSizes}
                loading="eager"
                decoding="async"
                class="w-full h-auto object-cover aspect-[16/9]"
              />
            )}
          </div>
          <div class="md:hidden space-y-4">
            {content.hero.mobileStack.map((img) => (
              <div class="csh-frame">
                <ContentImage image={img} priority sizes="100vw" />
              </div>
            ))}
          </div>
        </>
      ) : content.hero.image ? (
        <div class="csh-frame">
          <ContentImage
            image={content.hero.image}
            priority
            sizes={heroSizes}
            widths={heroWidths}
          />
        </div>
      ) : (
        <div class="csh-frame">
          <Image
            src={fallbackImage}
            alt={title}
            widths={heroWidths}
            sizes={heroSizes}
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover aspect-[16/9]"
          />
        </div>
      )
    }
  </div>

  <div class="cs-body csh-intro">
    <div class="space-y-4 text-[1.0625rem] leading-[1.65] text-[color:var(--color-ink-soft)]">
      {introParagraphs.map((p) => <p>{p}</p>)}
      {
        content.hero.bullets && content.hero.bullets.length > 0 && (
          <ul class="pl-5 space-y-1 list-disc marker:text-[color:var(--color-ink)]">
            {content.hero.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .csh {
    padding-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .csh {
      padding-bottom: 4rem;
    }
  }

  /* Asymmetric 39/61 split — mirrors the home hero. */
  .csh-top {
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .csh-top {
      grid-template-columns: 39fr 61fr;
      gap: 0;
      padding-top: 3rem;
      padding-bottom: 3.5rem;
      min-height: 22rem;
    }
  }
  .csh-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }
  .csh-back {
    font-size: 0.875rem;
  }
  .csh-logo {
    display: block;
  }
  .csh-brand {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .csh-right {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .csh-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.5rem, 4.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--color-ink);
  }
  .csh-desc {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--color-muted);
  }

  /* Hairline meta table. */
  .csh-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
  }
  @media (min-width: 1024px) {
    .csh-meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .csh-cell {
    padding: 0.9rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .csh-cell:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .csh-cell,
    .csh-cell:nth-child(even) {
      padding: 0.9rem 1.5rem 1.25rem;
      border-left: 1px solid var(--color-border);
    }
    .csh-cell:first-child {
      padding-left: 0;
      border-left: none;
    }
  }
  .csh-cell dt {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--color-muted);
  }
  .csh-cell dd {
    margin-top: 0.35rem;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .csh-media {
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .csh-media {
      margin-top: 3rem;
    }
  }
  .csh-frame {
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-grey);
  }

  .csh-intro {
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .csh-intro {
      margin-top: 4rem;
    }
  }
</style>
