---
import type { ContentVideo } from "~/data/case-studies/types";

type Props = {
  video: ContentVideo;
  rounded?: boolean;
};
const { video, rounded = false } = Astro.props;
const radius = rounded ? "rounded-xl" : "";
const portrait = video.orientation === "portrait";
---

<figure class:list={["w-full", portrait && "md:max-w-sm md:mx-auto"]}>
  <div class={`overflow-hidden ${radius}`}>
    <video
      class="content-video w-full h-auto object-cover"
      poster={video.poster}
      muted
      loop
      playsinline
      preload="none"
      data-lazy-video
      aria-label={video.alt}
      style={[
        video.aspect ? `aspect-ratio: ${video.aspect};` : "",
        video.mobileAspect ? `--mobile-aspect: ${video.mobileAspect};` : "",
      ]
        .join(" ")
        .trim() || undefined}
    >
      {
        video.mobileSrc && (
          <source src={video.mobileSrc} media="(max-width: 767px)" />
        )
      }
      <source src={video.src} />
    </video>
  </div>
  {
    video.caption && (
      <figcaption class="mt-2 text-xs text-[color:var(--color-muted)]">
        {video.caption}
      </figcaption>
    )
  }
</figure>

<style>
  @media (max-width: 767px) {
    .content-video {
      aspect-ratio: var(--mobile-aspect, auto);
    }
  }
</style>

<script>
  // Below-the-fold clips: with preload="none" and no autoplay attribute
  // the browser downloads nothing until we call play(). Start each video
  // shortly before it scrolls into view, pause it when it leaves.
  const videos = document.querySelectorAll<HTMLVideoElement>(
    "video[data-lazy-video]",
  );
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (videos.length && !reduceMotion) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: "200px 0px" },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>
