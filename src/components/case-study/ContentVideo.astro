---
import type { ContentVideo } from "~/data/case-studies/types";

type Props = {
  video: ContentVideo;
  rounded?: boolean;
};
const { video, rounded = false } = Astro.props;
const radius = rounded ? "rounded-xl" : "";
---

<figure class="w-full">
  <div class={`overflow-hidden ${radius}`}>
    <video
      class="content-video w-full h-auto object-cover"
      poster={video.poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={video.alt}
      style={[
        video.aspect ? `aspect-ratio: ${video.aspect};` : "",
        video.mobileAspect ? `--mobile-aspect: ${video.mobileAspect};` : "",
      ]
        .join(" ")
        .trim() || undefined}
    >
      {
        video.mobileSrc && (
          <source src={video.mobileSrc} media="(max-width: 767px)" />
        )
      }
      <source src={video.src} />
    </video>
  </div>
  {
    video.caption && (
      <figcaption class="mt-2 text-xs text-[color:var(--color-muted)]">
        {video.caption}
      </figcaption>
    )
  }
</figure>

<style>
  @media (max-width: 767px) {
    .content-video {
      aspect-ratio: var(--mobile-aspect, auto);
    }
  }
</style>
