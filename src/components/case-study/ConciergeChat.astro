---
/**
 * Concierge conversation, Karta-style: a real photo with a WhatsApp-like
 * chat floating over it. Header = concierge name + online dot + channel tag;
 * each topic arrives as a request the member sends (dark bubble, read ticks),
 * the final item ("Among others.") lands as a centred system note, and the
 * concierge is left typing — the reply is always on its way.
 * Without JS / under reduced motion everything is shown at once (typing dots
 * static).
 */
import { Image } from "astro:assets";
import type { ContentImage } from "~/data/case-studies/types";

type Props = {
  /** Lead-in line shown beside/above the chat ("Karta Concierge helps you with:"). */
  heading: string;
  /** Name in the chat header ("Karta Concierge"). */
  title: string;
  /** Small mono channel tag in the header ("WhatsApp"). */
  channel?: string;
  /** Decorative photo the conversation floats over. */
  backdrop?: ContentImage;
  items: readonly string[];
};
const { heading, title, channel, backdrop, items } = Astro.props;
const requests = items.length > 2 ? items.slice(0, -1) : items;
const note = items.length > 2 ? items[items.length - 1] : undefined;
const photo = backdrop?.kind === "image" ? backdrop.image : undefined;
---

<div class="cc">
  <div class="cc-intro">
    <p class="cc-label mono">
      {title}{channel && <span aria-hidden="true"> / </span>}{channel}
    </p>
    <p class="cc-heading display-serif">{heading}</p>
  </div>

  <div class:list={["cc-stage", { "has-photo": photo }]}>
    {
      photo && (
        <Image
          src={photo}
          alt=""
          class="cc-photo"
          widths={[480, 741]}
          sizes="(min-width: 900px) 40rem, 100vw"
          format="webp"
          loading="lazy"
        />
      )
    }

    <div class="cc-card" data-cc>
      <div class="cc-head">
        <span class="cc-avatar" aria-hidden="true">{title.charAt(0)}</span>
        <span class="cc-who">
          <span class="cc-name">{title}</span>
          <span class="cc-status mono">
            <span class="cc-dot" aria-hidden="true"></span>online
          </span>
        </span>
        {channel && <span class="cc-channel mono">{channel}</span>}
      </div>

      <div class="cc-body">
        <ul class="cc-thread" aria-label={heading}>
          {
            requests.map((t) => (
              <li class="cc-msg">
                <span>{t}</span>
                <svg class="cc-ticks" viewBox="0 0 16 10" aria-hidden="true">
                  <path d="M1 5.5 3.8 8.3 9.6 1.7M6.4 7.6l.7.7 5.8-6.6" />
                </svg>
              </li>
            ))
          }
          {note && <li class="cc-msg cc-note mono">{note}</li>}
        </ul>
        <div class="cc-typing" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>
</div>

<script>
  const STEP = 600;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-cc]").forEach((card) => {
    if (reduce) return;
    const msgs = Array.from(card.querySelectorAll<HTMLElement>(".cc-msg"));
    card.setAttribute("data-armed", "");
    const obs = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        obs.disconnect();
        msgs.forEach((m, i) => {
          window.setTimeout(() => m.setAttribute("data-in", ""), 300 + i * STEP);
        });
        window.setTimeout(
          () => card.setAttribute("data-typing", ""),
          300 + msgs.length * STEP,
        );
      },
      { threshold: 0.35 },
    );
    obs.observe(card);
  });
</script>

<style>
  .cc {
    display: grid;
    gap: 1.5rem;
  }
  .cc-intro {
    display: grid;
    gap: 0.75rem;
  }
  .cc-label {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cc-heading {
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .cc-heading {
      font-size: 2.25rem;
    }
  }

  /* ——— Stage: photo with the chat floating over it ——— */
  .cc-stage {
    position: relative;
    display: flex;
    justify-content: flex-end;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-border);
    padding: 1rem;
  }
  .cc-stage.has-photo {
    border: 0;
    background: var(--color-ink);
    padding: clamp(11rem, 52vw, 15rem) 0.75rem 0.75rem;
  }
  @media (min-width: 900px) {
    .cc-stage.has-photo {
      padding: 7rem 2rem 2rem;
    }
  }
  .cc-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  @media (min-width: 900px) {
    /* Wide stage: drop to the couple watching the balloons; the chat sits
       to the right so they stay in view. */
    .cc-photo {
      object-position: 50% 78%;
    }
  }

  .cc-card {
    position: relative;
    width: 100%;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }
  .has-photo .cc-card {
    background: rgb(255 255 255 / 0.9);
    border-color: rgb(255 255 255 / 0.55);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
  }
  @media (min-width: 900px) {
    .cc-card {
      max-width: 23rem;
    }
  }

  .cc-head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgb(6 6 6 / 0.1);
  }
  .cc-avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.875rem;
    font-weight: 500;
    flex: none;
  }
  .cc-who {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .cc-name {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .cc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--color-muted);
  }
  .cc-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }
  .cc-channel {
    margin-left: auto;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cc-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
  }
  .cc-thread {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4375rem;
  }
  .cc-msg {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.5rem;
    max-width: 88%;
    padding: 0.5rem 0.625rem 0.5rem 0.75rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border-radius: 0.75rem 0.75rem 0.1875rem 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .cc-ticks {
    flex: none;
    width: 0.875rem;
    height: 0.5625rem;
    margin-bottom: 0.25rem;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cc-note {
    align-self: center;
    margin-top: 0.25rem;
    padding: 0.25rem 0.625rem;
    background: transparent;
    color: var(--color-muted);
    border: 1px solid rgb(6 6 6 / 0.12);
    border-radius: var(--radius-xs);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cc-typing {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: max-content;
    height: 2rem;
    padding: 0 0.875rem;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem 0.75rem 0.75rem 0.1875rem;
  }
  .cc-typing i {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: var(--radius-full);
    background: var(--color-muted-soft);
  }

  /* Armed by JS (motion allowed): requests arrive in turn, then the
     concierge starts typing (and keeps typing). */
  .cc-card[data-armed] .cc-msg {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cc-card[data-armed] .cc-msg[data-in] {
    opacity: 1;
    transform: none;
  }
  .cc-card[data-armed] .cc-typing {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cc-card[data-armed][data-typing] .cc-typing {
    opacity: 1;
  }
  .cc-card[data-armed] .cc-typing i {
    animation: cc-blink 1.1s infinite ease-in-out;
  }
  .cc-card[data-armed] .cc-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .cc-card[data-armed] .cc-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes cc-blink {
    0%,
    80%,
    100% {
      opacity: 0.35;
    }
    40% {
      opacity: 1;
    }
  }
</style>
