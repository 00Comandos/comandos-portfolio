---
import ArrowIcon from "~/components/ui/ArrowIcon.astro";
import SectionChip from "~/components/case-study/SectionChip.astro";
import ContentImage from "~/components/case-study/ContentImage.astro";
import Divider from "~/components/case-study/Divider.astro";
import type { CaseStudyContent } from "~/data/case-studies/types";

type Props = { content: CaseStudyContent["challenge"]; brand: string };
const { content, brand } = Astro.props;

const contactHref = `/contact/?project=${encodeURIComponent(`Like ${brand}`)}`;
---

<section id="challenge" class="bg-[color:var(--color-ink)] text-[color:var(--color-paper)] py-16 md:py-24">
  <div class="cs-body">
    <SectionChip variant="challenge" label="Challenge" tone="dark" />

    <h2 class="display-serif mt-6 text-[clamp(2.25rem,4vw,3.5rem)] max-w-[20ch]">
      {content.heading}
    </h2>
    <p class="mt-5 text-[1.0625rem] leading-[1.55] tracking-[-0.01em] text-white/70 max-w-[36rem]">
      {content.body}
    </p>

    <a href={contactHref} class="btn-dark-outline mt-7">
      {content.ctaLabel}
      <ArrowIcon />
    </a>

    <Divider tone="dark" />

    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-[0.9375rem] font-medium tracking-[-0.01em] text-white/55">Results</h3>
        <ul class="mt-4 space-y-2">
          {
            content.results.map((r) => (
              <li class="flex gap-2 text-[1rem] tracking-[-0.01em] text-white leading-[1.5]">
                <span aria-hidden="true" class="mt-[2px]">✓</span>
                <span set:html={r.replace(/\((.*?)\)/, '(<em class="not-italic text-white/60">$1</em>)')} />
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-[0.9375rem] font-medium tracking-[-0.01em] text-white/55">The team</h3>
        <ul class="mt-4 space-y-2">
          {
            content.team.map((t) => (
              <li class="flex flex-wrap items-center gap-2 text-[1rem] tracking-[-0.01em] text-white leading-[1.5]">
                <span aria-hidden="true">✓</span>
                <span>{t.label}</span>
                {t.badge && (
                  <span class="hl text-[0.875rem] font-medium">
                    {t.badge}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      content.image && (
        <div class="mt-10">
          <ContentImage image={content.image} />
        </div>
      )
    }
  </div>
</section>

<style>
  .btn-dark-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: transparent;
    color: var(--color-paper);
    padding: 0.5rem 1.15rem 0.5rem 1rem;
    min-height: 2.5rem;
    border-radius: var(--radius-full);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    line-height: 1.4;
    border: 1px solid var(--color-paper);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  /* Same leading-dot pill as .btn-outline, inverted for the dark band. */
  .btn-dark-outline::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: currentColor;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }
  .btn-dark-outline > :global(svg) {
    display: none;
  }
  /* Global focus ring is ink — invisible on this black band. */
  .btn-dark-outline:focus-visible {
    outline-color: var(--color-paper);
  }
  .btn-dark-outline:hover {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }
  .btn-dark-outline:hover::before {
    background: var(--color-accent);
  }
</style>
