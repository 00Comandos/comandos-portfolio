---
/*
 * /method hero — engraved line + halftone mountain (one ink, dot-screen
 * shading, lots of air). One main peak with a lit west face and a shaded
 * east face, a lower range behind. The teal route climbs the lit face camp
 * by camp (the four phases) to the summit: growth.
 * Final state without JS / under reduced motion.
 */
type Props = { camps: readonly string[]; summit?: string; ink?: string };
const { camps, summit = "Growth", ink = "var(--color-ink)" } = Astro.props;

const W = 1200;
const H = 520;
const P = (pts: [number, number][]) => "M" + pts.map((p) => p.join(" ")).join(" L");

// Main peak.
const peakL: [number, number][] = [[270, 520], [390, 330], [440, 296], [500, 190], [546, 166], [600, 70]];
const peakR: [number, number][] = [[600, 70], [660, 160], [706, 172], [764, 282], [826, 318], [950, 520]];
const peak = P([...peakL, ...peakR.slice(1)]) + " Z";
// Facet ridges: the central one splits lit (west) from shaded (east).
const ridgeC: [number, number][] = [[600, 70], [622, 196], [596, 326], [628, 520]];
const ridgeL = P([[546, 166], [560, 290], [522, 420], [536, 520]]);
const ridgeR = P([[706, 172], [694, 296], [744, 430], [740, 520]]);
const shadeFace = P([...ridgeC, [950, 520], ...[...peakR].reverse()]) + " Z";

// Back range (left and right of the peak), lighter.
const backL = P([[0, 452], [96, 400], [180, 426], [292, 330], [372, 382], [430, 360]]);
const backR = P([[800, 360], [880, 300], [956, 344], [1070, 268], [1140, 318], [1200, 300]]);
const backLFill = backL + " L430 520 L0 520 Z";
const backRFill = backR + " L1200 520 L800 520 Z";
const backLShade = P([[292, 330], [372, 382], [430, 360], [430, 520], [330, 520], [312, 420]]) + " Z";
const backRShade = P([[1070, 268], [1140, 318], [1200, 300], [1200, 520], [1110, 520], [1090, 400]]) + " Z";

// Hatching on the lit face (short engraving strokes, follow the slope).
const hatch = [
  [470, 300, 486, 330], [452, 352, 466, 384], [420, 410, 432, 440], [520, 236, 532, 262],
  [566, 130, 574, 150], [380, 460, 390, 486], [500, 470, 508, 496], [548, 360, 554, 388],
].map(([a, b, c, d]) => `M${a} ${b} L${c} ${d}`);

// Route up the lit face: base → camps 01–04 → summit = growth.
const path: [number, number][] = [
  [330, 506], [372, 480], [404, 452], [452, 432], [470, 382], [508, 352], [520, 292], [552, 254], [558, 194], [584, 142], [600, 72],
];
const campIdx = [2, 4, 6, 8];
const seg = path.slice(1).map((p, i) => Math.hypot(p[0] - path[i][0], p[1] - path[i][1]));
const total = seg.reduce((a, b) => a + b, 0);
const at = (idx: number) => seg.slice(0, idx).reduce((a, b) => a + b, 0) / total;
const route = P(path);
const ROUTE_START = 1.9;
const ROUTE_DUR = 3;
const camp = campIdx.map((idx) => ({ x: path[idx][0], y: path[idx][1], delay: ROUTE_START + at(idx) * ROUTE_DUR }));
const summitDelay = ROUTE_START + ROUTE_DUR;
---

<div class="mtn" data-mtn style={`--mtn-ink: ${ink};`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax meet">
    <defs>
      <pattern id="mtn-dots-dense" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <circle cx="2" cy="2" r="1.35" class="mtn-dot" />
      </pattern>
      <pattern id="mtn-dots-light" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <circle cx="2" cy="2" r="0.85" class="mtn-dot" />
      </pattern>
      <linearGradient id="mtn-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.55" stop-color="#fff" />
        <stop offset="1" stop-color="#fff" stop-opacity="0.15" />
      </linearGradient>
      <mask id="mtn-fade-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <rect x="0" y="0" width={W} height={H} fill="url(#mtn-fade)" />
      </mask>
    </defs>

    <path d={backLFill} class="mtn-paper" />
    <path d={backRFill} class="mtn-paper" />
    <g mask="url(#mtn-fade-mask)">
      <path class="mtn-shade" d={backLShade} fill="url(#mtn-dots-light)" />
      <path class="mtn-shade" d={backRShade} fill="url(#mtn-dots-light)" />
    </g>
    <path class="mtn-line mtn-back" d={backL} pathLength="1" />
    <path class="mtn-line mtn-back" d={backR} pathLength="1" style="--i:1" />

    <path d={peak} class="mtn-paper" />
    <g mask="url(#mtn-fade-mask)">
      <path class="mtn-shade" d={shadeFace} fill="url(#mtn-dots-dense)" />
    </g>
    <path class="mtn-line mtn-outline" d={P(peakL)} pathLength="1" />
    <path class="mtn-line mtn-outline" d={P(peakR)} pathLength="1" />
    <path class="mtn-line" d={P(ridgeC)} pathLength="1" style="--i:2" />
    <path class="mtn-line mtn-thin" d={ridgeL} pathLength="1" style="--i:3" />
    <path class="mtn-line mtn-thin" d={ridgeR} pathLength="1" style="--i:4" />
    {hatch.map((d, i) => <path class="mtn-hatch" d={d} style={`--i:${i}`} />)}

    <path class="mtn-line mtn-ground" d={`M0 519 L${W} 519`} pathLength="1" />

    <path class="mtn-route" d={route} pathLength="1" style={`--rs:${ROUTE_START}s;--rd:${ROUTE_DUR}s`} />
    <circle cx={path[0][0]} cy={path[0][1]} r="4" class="mtn-base" />
    {
      camp.map((c, i) => (
        <g class="mtn-camp" style={`--at:${c.delay.toFixed(2)}s`}>
          <circle cx={c.x} cy={c.y} r="6" class="mtn-camp-dot" />
          <text x={c.x - 16} y={c.y + 4} text-anchor="end" class="mtn-label">
            <tspan class="mtn-num">{String(i + 1).padStart(2, "0")}</tspan>
            <tspan class="mtn-name"> {camps[i]}</tspan>
          </text>
        </g>
      ))
    }
    <g class="mtn-flag" style={`--at:${summitDelay.toFixed(2)}s`}>
      <circle cx="600" cy="70" r="7" class="mtn-summit-dot" />
      <path d="M600 63 L600 22" class="mtn-pole" />
      <path d="M600 22 L632 31 L600 40 Z" class="mtn-pennant" />
      <text x="644" y="36" class="mtn-label mtn-summit">
        <tspan class="mtn-arrow">↗</tspan> {summit}
      </text>
    </g>
  </svg>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-mtn]").forEach((el) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    el.setAttribute("data-armed", "");
    requestAnimationFrame(() => requestAnimationFrame(() => el.setAttribute("data-play", "")));
  });
</script>

<style>
  .mtn {
    color: var(--mtn-ink);
  }
  .mtn svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .mtn path,
  .mtn circle {
    vector-effect: non-scaling-stroke;
  }
  .mtn-paper {
    fill: var(--color-paper);
  }
  .mtn-dot {
    fill: currentColor;
  }
  .mtn-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .mtn-outline {
    stroke-width: 1.6;
  }
  .mtn-thin,
  .mtn-back {
    stroke-width: 1;
  }
  .mtn-ground {
    stroke-width: 1;
    stroke: var(--color-border);
  }
  .mtn-hatch {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .mtn-route {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mtn-camp-dot {
    fill: var(--color-paper);
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .mtn-summit-dot,
  .mtn-base {
    fill: var(--color-accent);
    stroke: currentColor;
    stroke-width: 1.25;
  }
  .mtn-label {
    paint-order: stroke;
    stroke: var(--color-paper);
    stroke-width: 6px;
    stroke-linejoin: round;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: currentColor;
  }
  .mtn-num {
    fill: var(--color-muted);
  }
  .mtn-summit {
    font-size: 15px;
    font-weight: 500;
  }
  .mtn-arrow {
    fill: var(--color-accent);
  }
  .mtn-pole {
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .mtn-pennant {
    fill: var(--color-accent);
    stroke: currentColor;
    stroke-width: 1;
  }
  @media (max-width: 639px) {
    .mtn-label {
      font-size: 30px;
      stroke-width: 10px;
    }
    .mtn-summit {
      font-size: 32px;
    }
    .mtn-name {
      display: none;
    }
    .mtn-num {
      fill: currentColor;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mtn[data-armed] .mtn-line {
      stroke-dasharray: 1 2;
      stroke-dashoffset: 1;
    }
    .mtn[data-armed] .mtn-shade,
    .mtn[data-armed] .mtn-hatch,
    .mtn[data-armed] .mtn-camp,
    .mtn[data-armed] .mtn-flag,
    .mtn[data-armed] .mtn-base {
      opacity: 0;
    }
    .mtn[data-armed] .mtn-route {
      stroke-dasharray: 1.02 2;
      stroke-dashoffset: 1.02;
    }
    .mtn[data-play] .mtn-line {
      transition: stroke-dashoffset 1.6s cubic-bezier(0.45, 0, 0.2, 1);
      transition-delay: calc(var(--i, 0) * 0.12s);
      stroke-dashoffset: 0;
    }
    .mtn[data-play] .mtn-shade {
      transition: opacity 1s ease 1s;
      opacity: 1;
    }
    .mtn[data-play] .mtn-hatch {
      transition: opacity 0.5s ease;
      transition-delay: calc(1.3s + var(--i, 0) * 0.05s);
      opacity: 0.55;
    }
    .mtn[data-play] .mtn-base {
      transition: opacity 0.3s ease 1.7s;
      opacity: 1;
    }
    .mtn[data-play] .mtn-route {
      transition: stroke-dashoffset var(--rd) linear var(--rs);
      stroke-dashoffset: 0;
    }
    .mtn[data-play] .mtn-camp,
    .mtn[data-play] .mtn-flag {
      transition: opacity 0.35s ease var(--at);
      opacity: 1;
    }
  }
</style>
