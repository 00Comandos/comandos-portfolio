---
// Sibling of method/PhaseVisual for the services that have no phase of
// their own. Same system: hairline frame, mono label strip, 4:3 SVG, ink
// hairlines and a single teal highlight; same motion model (SSR markup is
// the settled state, CSS animations attach paused and run while ≥35% in
// view; no JS / reduced motion → static final composition).
//
// leadership · a design lead wiring a team to a quarterly roadmap.
import type { Lang } from "~/i18n";

type Props = { kind: "leadership"; lang: Lang; label: string };
const { lang, label } = Astro.props;

const copy = {
  en: { team: "TEAM", roadmap: "ROADMAP", lead: "LEAD", q: "Q", lanes: ["VISION", "RITUALS", "HIRING"] },
  es: { team: "EQUIPO", roadmap: "ROADMAP", lead: "LÍDER", q: "T", lanes: ["VISIÓN", "RITUALES", "CONTRATACIÓN"] },
}[lang];

const f = (v: number) => Math.round(v * 10) / 10;
const LEAD = { x: 160, y: 46 };
const TEAM = [72, 160, 248].map((x) => ({ x, y: 100 }));
const T = { x0: 40, x1: 288, y: 214 };
const qx = (q: number) => T.x0 + (q / 4) * (T.x1 - T.x0);
const LANES = [
  { y: 146, from: 0, to: 1.7, cls: "ink" },
  { y: 168, from: 0.9, to: 3.1, cls: "mut-bar" },
  { y: 190, from: 2, to: 4, cls: "out-bar" },
];
const link = (x: number) =>
  `M${LEAD.x} ${LEAD.y + 11} C${LEAD.x} ${f(LEAD.y + 32)} ${x} ${f(TEAM[0].y - 34)} ${x} ${TEAM[0].y - 9}`;
---

<figure class="svv" data-svv role="img" aria-label={label}>
  <div class="svv-bar" aria-hidden="true">
    <span>{copy.team} <b>04</b></span>
    <span>{copy.roadmap} <b>{copy.q}1</b> → <b>{copy.q}4</b></span>
  </div>
  <svg viewBox="0 0 320 240" aria-hidden="true" focusable="false">
    {
      [0, 1, 2, 3, 4].map((q) => (
        <line x1={f(qx(q))} x2={f(qx(q))} y1="128" y2={T.y} class="gridline" />
      ))
    }
    <line x1={T.x0} x2={T.x1} y1={T.y} y2={T.y} class="axis" />
    {
      [0, 1, 2, 3].map((q) => (
        <text x={f(qx(q + 0.5))} y={T.y + 16} class="svv-t mut" text-anchor="middle">
          {`${copy.q}${q + 1}`}
        </text>
      ))
    }

    {TEAM.map((n, i) => <path d={link(n.x)} class="a draw svv-link" pathLength="1" style={`--d:${0.35 + i * 0.12}s`} />)}

    {
      LANES.map((l, i) => (
        <Fragment>
          <path
            d={`M${TEAM[i].x} ${TEAM[i].y + 9} L${TEAM[i].x} ${l.y - 5}`}
            class="a pv-fade svv-drop"
            style={`--d:${1 + i * 0.15}s`}
          />
          <text x={f(qx(l.from) + 2)} y={l.y - 9} class="a pv-fade svv-t mut" style={`--d:${1.3 + i * 0.2}s`}>
            {copy.lanes[i]}
          </text>
          <rect
            x={f(qx(l.from))}
            y={l.y - 4}
            width={f(qx(l.to) - qx(l.from))}
            height="8"
            rx="4"
            class={`a svv-grow ${l.cls}`}
            style={`--d:${1.2 + i * 0.2}s`}
          />
        </Fragment>
      ))
    }

    {
      TEAM.map((n, i) => (
        <g class="a pv-pop" style={`--d:${0.7 + i * 0.12}s`}>
          <circle cx={n.x} cy={n.y} r="9" class="node" />
          <circle cx={n.x} cy={n.y - 2.6} r="2.4" class="ink" />
          <path d={`M${n.x - 4.6} ${n.y + 5.4} C${n.x - 4.6} ${n.y + 1} ${n.x + 4.6} ${n.y + 1} ${n.x + 4.6} ${n.y + 5.4}Z`} class="ink" />
        </g>
      ))
    }

    <circle class="a pv-pulse" cx={LEAD.x - 16} cy={LEAD.y} r="3" style="--d:2.2s" />
    <g class="a pv-pop" style="--d:0.1s">
      <rect x={LEAD.x - 26} y={LEAD.y - 11} width="52" height="22" rx="11" class="pill acc-stroke" />
      <circle cx={LEAD.x - 16} cy={LEAD.y} r="3" class="acc-fill" />
      <text x={LEAD.x + 4} y={LEAD.y + 3.5} class="svv-t" text-anchor="middle">{copy.lead}</text>
    </g>
  </svg>
</figure>

<script>
  function initServiceVisuals() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>("[data-svv]:not([data-svv-ready])").forEach((el) => {
      el.dataset.svvReady = "1";
      if (reduce) return;
      const play = (on: boolean) => el.toggleAttribute("data-play", on);
      if (!("IntersectionObserver" in window)) return play(true);
      new IntersectionObserver(
        (entries) => entries.forEach((e) => play(e.isIntersecting && e.intersectionRatio >= 0.35)),
        { threshold: [0, 0.35, 0.6] },
      ).observe(el);
    });
  }
  initServiceVisuals();
  document.addEventListener("astro:page-load", initServiceVisuals);
</script>

<style>
  .svv {
    --pv-ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
    width: 100%;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
  }
  .svv-bar {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .svv-bar b {
    font-weight: 500;
    color: var(--color-ink);
  }
  .svv svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .svv-t {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.06em;
    fill: var(--color-ink);
  }
  .svv text.mut {
    fill: var(--color-muted);
  }
  .svv .ink {
    fill: var(--color-ink);
  }
  .acc-fill {
    fill: var(--color-accent);
  }
  .gridline {
    stroke: var(--color-grey);
    stroke-width: 1;
  }
  .axis {
    stroke: var(--color-muted-soft);
    stroke-width: 1;
  }
  .pill {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 0.9;
  }
  .pill.acc-stroke {
    stroke: var(--color-accent);
    stroke-width: 1.25;
  }
  .node {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 0.9;
  }
  .svv-link {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 0.75;
  }
  .svv-drop {
    fill: none;
    stroke: var(--color-muted-soft);
    stroke-width: 0.75;
    stroke-dasharray: 1.5 2;
  }
  .svv .mut-bar {
    fill: var(--color-muted-soft);
  }
  .svv .out-bar {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 0.9;
  }
  .pv-pulse {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .svv-grow {
    transform-box: fill-box;
    transform-origin: left center;
  }

  /* ---------- Motion (only with JS and motion allowed) ---------- */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .svv .a {
      animation-fill-mode: both;
      animation-play-state: paused;
      animation-timing-function: var(--pv-ease);
      animation-delay: var(--d, 0s);
      animation-duration: 0.6s;
    }
    .svv[data-play] .a {
      animation-play-state: running;
    }
    .svv .draw {
      stroke-dasharray: 1 1;
      animation-name: svv-draw;
      animation-duration: 0.7s;
    }
    .svv .pv-fade {
      animation-name: svv-fade;
    }
    .svv .pv-pop {
      animation-name: svv-pop;
      animation-duration: 0.5s;
      transform-box: fill-box;
      transform-origin: center;
    }
    .svv .svv-grow {
      animation-name: svv-grow;
      animation-duration: 0.9s;
    }
    .svv .pv-pulse {
      animation-name: svv-pulse;
      animation-duration: 2.8s;
      animation-iteration-count: infinite;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1);
    }
  }
  @keyframes svv-draw {
    0% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes svv-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes svv-pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
  }
  @keyframes svv-grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes svv-pulse {
    0% {
      opacity: 0;
      transform: scale(1);
    }
    1% {
      opacity: 0.9;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(4);
    }
  }
</style>
