---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import FinalCTA from "~/components/home/FinalCTA.astro";
import ServicesPains from "./ServicesPains.astro";
import AudienceArt from "./AudienceArt.astro";
import { projects } from "~/data/projects";
import { homeImpact, homeWorkCopy } from "~/data/home-work-i18n";
import { site } from "~/lib/site";
import { localizedPath, ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const p = t.servicesPage;
const L = (href: string) => localizedPath(href, lang);

const pageUrl = `${site.url}${L("/services/")}`;
const homeUrl = `${site.url}${L("/")}`;
const num = (i: number) => String(i + 1).padStart(2, "0");

// Each home service line expanded with the page-only detail (keyed by id so
// EN / ES can't drift out of order).
const services = t.services.items.map((s) => ({
  ...s,
  ...p.detail.byId[s.id as keyof typeof p.detail.byId],
}));

// Proof tiles: the four headline metrics already used on the home Impact
// band, paired with each case's cover image and service tags.
const proof = homeImpact[lang].flatMap((stat) => {
  const project = projects.find((x) => x.slug === stat.slug);
  if (!project) return [];
  return [
    {
      ...stat,
      image: project.image,
      alt: project.title,
      tags: homeWorkCopy[lang][stat.slug]?.tags ?? [],
    },
  ];
});

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: p.breadcrumbHome, item: homeUrl },
      { "@type": "ListItem", position: 2, name: p.breadcrumb, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: `${site.name} — ${p.breadcrumb}`,
    url: pageUrl,
    description: p.metaDescription,
    inLanguage: lang,
    image: new URL("/images/Logo-Comandos.svg", site.url).toString(),
    email: "c@comandos.me",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Mexico City",
      addressCountry: "MX",
    },
    areaServed: ["MX", "LATAM"],
    availableLanguage: ["en", "es"],
    founder: { "@type": "Person", name: site.person.name, url: site.url },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: p.breadcrumb,
      itemListElement: services.map((s) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: s.title,
          description: s.body,
          url: `${pageUrl}#service-${s.id}`,
          provider: { "@type": "Organization", name: site.name, url: site.url },
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: p.faq.items.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  title={p.metaTitle}
  description={p.metaDescription}
  alternates={{ en: "/services/", es: "/es/services/" }}
  jsonLd={jsonLd}
>
  <!-- Hero: label left, headline right, hairline grid below. -->
  <section class="sv-hero" aria-labelledby="sv-hero-heading">
    <div class="container-page sv-hero-top">
      <span class="col-spacer" aria-hidden="true"></span>
      <h1 id="sv-hero-heading" class="sv-hero-title">
        {p.hero.title} <span class="hl">{p.hero.titleHl}</span>
        {p.hero.titleEnd}
      </h1>
    </div>

    <div class="sv-hero-grid">
      <div class="sv-hero-left">
        <p class="sv-hero-sub">{p.hero.sub}</p>
        <div class="sv-hero-actions">
          <a href={t.links.discovery} class="btn-primary">{p.hero.cta}</a>
          <a href="#services-detail" class="sv-link">{p.hero.secondary}</a>
        </div>
      </div>
      <nav class="sv-hero-index" aria-label={p.hero.indexLabel}>
        <ol>
          {
            services.map((s, i) => (
              <li>
                <a href={`#service-${s.id}`} class="sv-index-link">
                  <span class="sv-index-num">{num(i)}</span>
                  <span class="sv-index-title">{s.title}</span>
                  <svg
                    class="sv-index-arrow"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12l7 7 7-7" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <!-- The reality today: founder pains before the services. -->
  <ServicesPains lang={lang} />


  <!-- Service detail rows: number | title | body + fit | included + deliverables. -->
  <section id="services-detail" class="sv-detail" aria-labelledby="sv-detail-heading">
    <div class="container-page">
      <div class="sv-head sv-head--rows">
        <span class="col-spacer" aria-hidden="true"></span>
        <div class="sv-head-copy">
          <h2 id="sv-detail-heading" class="sv-h2">
            {p.detail.title} <span class="hl">{p.detail.titleHl}</span>
          </h2>
          <p class="sv-sub">{p.detail.sub}</p>
        </div>
      </div>

      <ol class="sv-rows">
        {
          services.map((s, i) => (
            <li class="sv-row" id={`service-${s.id}`}>
              <span class="sv-row-num">{num(i)}</span>
              <div class="sv-row-title">
                <h3>{s.title}</h3>
                <ul class="sv-tags">
                  {s.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
              <div class="sv-row-body">
                <p class="sv-row-lead">{s.body}</p>
                <p class="sv-label">{p.detail.fit}</p>
                <p class="sv-row-fit">{s.fit}</p>
              </div>
              <div class="sv-row-inc">
                <p class="sv-label">{p.detail.included}</p>
                <ul class="sv-list">
                  {s.included.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="sv-row-deliv">
                <p class="sv-label">{p.detail.deliverables}</p>
                <ul class="sv-list">
                  {s.deliverables.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Who it's for. -->
  <section class="sv-audience" aria-labelledby="sv-audience-heading" data-glyphs>
    <div class="container-page">
      <div class="sv-head">
        <span class="col-spacer" aria-hidden="true"></span>
        <h2 id="sv-audience-heading" class="sv-h2">
          {p.audience.title} <span class="hl">{p.audience.titleHl}</span> {p.audience.titleEnd}
        </h2>
      </div>
      <ul class="sv-audience-grid">
        {
          p.audience.items.map((a, i) => (
            <li class="sv-audience-cell" style={`--d:${i * 0.18}s`}>
              <div class="sv-audience-glyph">
                <AudienceArt kind={(i + 1) as 1 | 2 | 3 | 4} />
              </div>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process teaser — the full method lives on /method/. -->
  <section class="sv-process" aria-labelledby="sv-process-heading">
    <div class="container-page sv-process-grid">
      <span class="col-spacer" aria-hidden="true"></span>
      <div>
        <h2 id="sv-process-heading" class="sv-h2">
          {p.process.title} <span class="hl">{p.process.titleHl}</span>
        </h2>
        <p class="sv-sub">{p.process.body}</p>
        <ol class="sv-steps">
          {
            t.method.steps.map((step, i) => (
              <li>
                <span class="sv-step-num">{num(i)}</span>
                <span>{step.title}</span>
              </li>
            ))
          }
        </ol>
        <a href={L("/method/")} class="btn-outline sv-process-cta">
          {p.process.cta}
        </a>
      </div>
    </div>
  </section>

  <!-- Proof: four cases with their headline metric. -->
  <section class="sv-proof" aria-labelledby="sv-proof-heading">
    <div class="container-page">
      <div class="sv-proof-head">
        <div class="sv-proof-copy">
          <h2 id="sv-proof-heading" class="sv-h2">
            {p.proof.title} <span class="hl">{p.proof.titleHl}</span> {p.proof.titleEnd}
          </h2>
        </div>
        <a href="/projects/" class="btn-outline">{t.work.all}</a>
      </div>

      <ul class="sv-proof-grid">
        {
          proof.map((c) => (
            <li>
              <a href={`/projects/${c.slug}/`} class="sv-proof-link">
                <span class="sv-proof-media">
                  <Image
                    src={c.image}
                    alt={c.alt}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    class="sv-proof-img"
                  />
                </span>
                <span class="sv-proof-brand">{c.brand}</span>
                <span class="sv-proof-value">{c.value}</span>
                <span class="sv-proof-label">{c.label}</span>
                {c.tags.length > 0 && (
                  <span class="sv-proof-tags">
                    {c.tags.map((tag) => (
                      <span class="sv-proof-tag">{tag}</span>
                    ))}
                  </span>
                )}
                <span class="sr-only">— {t.work.readCase(c.brand)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Tools we plug into. -->

  <!-- FAQ: native disclosures, mirrored 1:1 in the FAQPage JSON-LD. -->
  <section class="sv-faq" aria-labelledby="sv-faq-heading">
    <div class="container-page sv-faq-grid">
      <div>
        <span class="col-spacer" aria-hidden="true"></span>
        <h2 id="sv-faq-heading" class="sv-h2 sv-faq-title">
          {p.faq.title} <span class="hl">{p.faq.titleHl}</span> {p.faq.titleEnd}
        </h2>
      </div>
      <div class="sv-faq-list">
        {
          p.faq.items.map((f) => (
            <details class="sv-faq-item">
              <summary>
                <span>{f.q}</span>
                <span class="sv-faq-icon" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA lang={lang} tone="dark" />
</BaseLayout>

<script>
  // Arm + play the audience glyphs when the dark band scrolls into view.
  document.querySelectorAll<HTMLElement>("[data-glyphs]").forEach((el) => {
    if (!("IntersectionObserver" in window)) return;
    el.setAttribute("data-armed", "");
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          el.setAttribute("data-play", "");
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(el);
  });
</script>

<style>
  /* Empty left column that keeps the asymmetric grid once the small
     section labels are gone (desktop only). */
  .col-spacer {
    display: none;
  }
  @media (min-width: 1024px) {
    .col-spacer {
      display: block;
    }
  }
  /* ---------- Shared ---------- */
  .sv-h2 {
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-ink);
    max-width: 20ch;
    text-wrap: balance;
  }
  .sv-sub {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .sv-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .sv-head {
      display: grid;
      grid-template-columns: 39fr 61fr;
      align-items: baseline;
      margin-bottom: 4rem;
    }
  }
  /* Detail header shares the rows' grid so the headline starts on the
     same line as each service's body copy. */
  @media (min-width: 1100px) {
    .sv-head--rows {
      grid-template-columns: 4rem minmax(0, 3fr) minmax(0, 4fr) minmax(0, 4fr);
      column-gap: 2.5rem;
    }
    .sv-head--rows .col-spacer {
      grid-column: 1 / 3;
    }
    .sv-head--rows .sv-head-copy {
      grid-column: 3 / -1;
    }
  }
  .sv-label {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .sv-link {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    padding-bottom: 2px;
    border-bottom: 1px solid var(--color-ink);
    transition: border-color 0.2s ease;
  }
  /* Invisible 44px hit area around the underlined text link (touch). */
  .sv-link::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.5rem;
  }
  .sv-link:hover {
    border-bottom-color: var(--color-accent);
  }

  /* ---------- Hero ---------- */
  .sv-hero-top {
    display: grid;
    gap: 1.5rem;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }
  @media (min-width: 1024px) {
    .sv-hero-top {
      grid-template-columns: 39fr 61fr;
      align-items: end;
      min-height: 22rem;
      padding-top: 4rem;
      padding-bottom: 2.25rem;
    }

  }
  .sv-hero-title {
    font-size: clamp(2.75rem, 5.4vw, 5.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-ink);
    max-width: 14ch;
  }
  .sv-hero-title .hl {
    padding-block: 0.02em;
  }
  /* Keep the short pills whole on phones too (global .hl only pins them
     from 640px); both fit a 320px line at these sizes. */
  .sv-hero-title .hl,
  .sv-h2 .hl {
    white-space: nowrap;
  }

  .sv-hero-grid {
    display: grid;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .sv-hero-grid {
      grid-template-columns: 39fr 61fr;
    }
  }
  .sv-hero-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.75rem 1.25rem;
  }
  @media (min-width: 768px) {
    .sv-hero-left {
      padding: 2.75rem 2.375rem;
    }
  }
  @media (min-width: 1024px) {
    .sv-hero-left {
      border-right: 1px solid var(--color-border);
      padding-left: max(2.375rem, calc((100vw - 1440px) / 2 + 2.375rem));
    }
  }
  .sv-hero-sub {
    font-size: clamp(1.25rem, 1.65vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 30rem;
  }
  .sv-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .sv-hero-index {
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .sv-hero-index {
      border-top: 0;
    }
  }
  .sv-hero-index li + li {
    border-top: 1px solid var(--color-border);
  }
  .sv-index-link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    color: var(--color-ink);
    transition: background-color 0.2s ease;
  }
  @media (min-width: 768px) {
    .sv-index-link {
      padding: 1.4rem 2.375rem;
    }
  }
  @media (min-width: 1024px) {
    .sv-index-link {
      padding-right: max(2.375rem, calc((100vw - 1440px) / 2 + 2.375rem));
    }
  }
  .sv-index-num {
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .sv-index-title {
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .sv-index-arrow {
    color: var(--color-muted);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  .sv-index-link:hover {
    background: var(--color-paper-soft);
  }
  .sv-index-link:hover .sv-index-arrow {
    color: var(--color-ink);
    transform: translateY(2px);
  }
  .sv-index-link:focus-visible {
    outline-offset: -2px;
  }

  /* ---------- Service detail rows ---------- */
  .sv-detail {
    scroll-margin-top: 5.5rem;
    padding-block: 4.5rem 5rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .sv-detail {
      padding-block: 7rem 7.5rem;
    }
  }
  .sv-rows {
    border-top: 1px solid var(--color-ink);
  }
  .sv-row {
    display: grid;
    grid-template-areas: "num" "title" "body" "inc" "deliv";
    row-gap: 1rem;
    padding-block: 2rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5.5rem;
  }
  .sv-row-num { grid-area: num; }
  .sv-row-title { grid-area: title; }
  .sv-row-body { grid-area: body; }
  .sv-row-inc { grid-area: inc; }
  .sv-row-deliv { grid-area: deliv; }
  @media (min-width: 768px) {
    .sv-row {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "num title title"
        ". body inc"
        ". body deliv";
      grid-template-rows: auto auto 1fr;
      column-gap: 2rem;
      row-gap: 0;
    }
    .sv-row-body,
    .sv-row-inc {
      margin-top: 1.5rem;
    }
  }
  @media (min-width: 1100px) {
    .sv-row {
      grid-template-columns: 4rem minmax(0, 3fr) minmax(0, 4fr) minmax(0, 4fr);
      grid-template-areas:
        "num title body inc"
        "num title deliv inc";
      grid-template-rows: auto 1fr;
      column-gap: 2.5rem;
      padding-block: 2.5rem 3rem;
    }
    .sv-row-body,
    .sv-row-inc {
      margin-top: 0;
    }
  }
  .sv-row-num {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
    padding-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .sv-row-title h3 {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .sv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .sv-tags li {
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
  }
  .sv-row-lead {
    font-size: 1.125rem;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .sv-row-fit {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .sv-row-inc > .sv-label {
    margin-top: 0.5rem;
  }
  @media (min-width: 1100px) {
    .sv-row-inc > .sv-label {
      margin-top: 0.4rem;
    }
  }
  .sv-row-deliv > .sv-label {
    margin-top: 0.75rem;
  }
  @media (min-width: 768px) {
    .sv-row-deliv > .sv-label {
      margin-top: 2rem;
    }
  }
  .sv-list li {
    position: relative;
    padding: 0.45rem 0 0.45rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    border-top: 1px solid var(--color-border);
  }
  .sv-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 9999px;
    background: var(--color-ink);
  }

  /* ---------- Audience ---------- */
  /* Dark band: the one black moment between the light sections.
     2×2 grid with generous cells so the four profiles can breathe. */
  .sv-audience {
    padding-block: 5rem;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  @media (min-width: 768px) {
    .sv-audience {
      padding-block: 8rem 8.5rem;
    }
  }
  .sv-audience :global(.sv-h2) {
    color: var(--color-paper);
  }
  .sv-audience-grid {
    display: grid;
    border-top: 1px solid rgb(255 255 255 / 0.5);
  }
  @media (min-width: 768px) {
    .sv-audience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .sv-audience-cell {
    display: grid;
    gap: 1.25rem;
    padding: 2.5rem 0 2.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }
  @media (min-width: 768px) {
    .sv-audience-cell {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: start;
      padding: 3.5rem 3rem 3.75rem;
    }
    .sv-audience-cell:nth-child(odd) {
      padding-left: 0;
      border-right: 1px solid rgb(255 255 255 / 0.16);
    }
    .sv-audience-cell:nth-child(n + 3) {
      border-bottom: 0;
    }
  }
  @media (min-width: 768px) and (max-width: 1099px) {
    .sv-audience-cell {
      grid-template-columns: 1fr;
