---
/*
 * Small line diagram per audience profile (services page, dark band).
 * Same vocabulary as the /method visuals: 1px strokes, dots, one teal
 * accent. Strokes draw in when the parent `[data-glyphs]` gets
 * `data-play`; without JS or under reduced motion the final state shows.
 *   1 Before PMF   — scattered tries converging on a target
 *   2 After PMF    — growth curve with its inflection point
 *   3 Maturing     — several products feeding one shared system
 *   4 No design lead — a team whose top node is still empty
 */
type Props = { kind: 1 | 2 | 3 | 4 };
const { kind } = Astro.props;

// Deterministic scatter for glyph 1.
const tries = [
  [18, 22], [34, 58], [52, 14], [70, 62], [92, 20], [108, 54], [40, 36], [86, 40],
];
---

<svg class="ag" viewBox="0 0 160 80" aria-hidden="true" focusable="false">
  {
    kind === 1 && (
      <g>
        {tries.map(([x, y], i) => (
          <circle class="ag-dot" cx={x} cy={y} r="1.6" style={`--i:${i}`} />
        ))}
        {tries.slice(0, 4).map(([x, y], i) => (
          <path class="ag-line ag-dash" pathLength="1" d={`M${x} ${y} L130 40`} style={`--i:${i}`} />
        ))}
        <circle class="ag-line" pathLength="1" cx="130" cy="40" r="14" />
        <circle class="ag-line ag-faint" pathLength="1" cx="130" cy="40" r="22" />
        <circle class="ag-accent ag-pop" cx="130" cy="40" r="3.2" />
      </g>
    )
  }
  {
    kind === 2 && (
      <g>
        <path class="ag-line ag-faint" pathLength="1" d="M10 70 H150 M10 70 V8" />
        <path class="ag-line" pathLength="1" d="M10 66 C40 64 58 62 72 52 S104 22 150 10" />
        <path class="ag-line ag-dash" pathLength="1" d="M72 52 V70" />
        <circle class="ag-accent ag-pop" cx="72" cy="52" r="3.2" />
        <text class="ag-text" x="78" y="66">FIT</text>
      </g>
    )
  }
  {
    kind === 3 && (
      <g>
        {[20, 62, 104].map((x, i) => (
          <rect class="ag-line" pathLength="1" x={x} y="8" width="36" height="22" rx="2" style={`--i:${i}`} />
        ))}
        {[38, 80, 122].map((x, i) => (
          <path class="ag-line ag-dash" pathLength="1" d={`M${x} 30 V52`} style={`--i:${i}`} />
        ))}
        <rect class="ag-line" pathLength="1" x="14" y="52" width="132" height="18" rx="2" />
        <rect class="ag-accent-fill ag-pop" x="20" y="58" width="40" height="6" rx="3" />
      </g>
    )
  }
  {
    kind === 4 && (
      <g>
        <path class="ag-line ag-faint" pathLength="1" d="M80 22 V36 M36 36 H124 M36 36 V48 M80 36 V48 M124 36 V48" />
        {[36, 80, 124].map((x, i) => (
          <circle class="ag-line" pathLength="1" cx={x} cy="58" r="9" style={`--i:${i}`} />
        ))}
        <circle class="ag-line ag-dash" pathLength="1" cx="80" cy="13" r="9" />
        <circle class="ag-accent ag-pop" cx="80" cy="13" r="3.2" />
        <text class="ag-text" x="94" y="16">?</text>
      </g>
    )
  }
</svg>

<style>
  .ag {
    display: block;
    width: 100%;
    max-width: 13rem;
    height: auto;
    overflow: visible;
    color: rgb(255 255 255 / 0.78);
  }
  .ag-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ag-faint {
    stroke: rgb(255 255 255 / 0.28);
  }
  .ag-dash {
    stroke-dasharray: 0.04 0.035;
    stroke: rgb(255 255 255 / 0.45);
  }
  .ag-dot {
    fill: rgb(255 255 255 / 0.55);
  }
  .ag-accent {
    fill: var(--color-accent);
  }
  .ag-accent-fill {
    fill: var(--color-accent);
  }
  .ag-text {
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.08em;
    fill: rgb(255 255 255 / 0.6);
  }

  /* Draw-in, only when motion is allowed and JS armed the section. */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-glyphs][data-armed]) .ag-line:not(.ag-dash) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global([data-glyphs][data-armed]) .ag-dash,
    :global([data-glyphs][data-armed]) .ag-dot,
    :global([data-glyphs][data-armed]) .ag-text {
      opacity: 0;
    }
    :global([data-glyphs][data-armed]) .ag-pop {
      opacity: 0;
      transform: scale(0.2);
      transform-box: fill-box;
      transform-origin: center;
    }
    :global([data-glyphs][data-play]) .ag-line:not(.ag-dash) {
      animation: ag-draw 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--d, 0s) + var(--i, 0) * 0.12s);
    }
    :global([data-glyphs][data-play]) .ag-dash,
    :global([data-glyphs][data-play]) .ag-dot,
    :global([data-glyphs][data-play]) .ag-text {
      animation: ag-fade 0.6s ease forwards;
      animation-delay: calc(var(--d, 0s) + 0.3s + var(--i, 0) * 0.08s);
    }
    :global([data-glyphs][data-play]) .ag-pop {
      animation:
        ag-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards,
        ag-pulse 2.4s ease-in-out 1.6s infinite;
      animation-delay: calc(var(--d, 0s) + 1s), calc(var(--d, 0s) + 1.6s);
    }
  }
  /* Drop the dash pattern at the end so closed shapes (rect/circle)
     don't keep a hairline gap from pathLength rounding. */
  @keyframes ag-draw {
    99% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 0;
      stroke-dasharray: none;
    }
  }
  @keyframes ag-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes ag-pop {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes ag-pulse {
    50% {
      opacity: 0.45;
    }
  }
</style>
