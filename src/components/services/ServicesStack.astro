---
// "One layer on top of the other" — the four services as a stack (bottom →
// top: Product Design, Design Systems, Growth, Leadership). Selecting a
// layer opens its preview: animated visual + where it shipped (a real case
// with its headline metric) + links to the case and to the detail row.
//
// Pattern: disclosure buttons (aria-expanded/aria-controls), one open at a
// time. Panels are server-rendered (images go through astro:assets); JS
// only toggles `.is-open`. Closed panels collapse with visibility:hidden
// (out of the a11y tree and tab order) rather than display:none, which
// would cancel the visuals' CSS animations that PhaseVisual's script
// holds on to. Desktop: stack left, panel right. Mobile: each
// panel opens inline under its layer. Without JS the first layer is open.
import { Image } from "astro:assets";
import { projects } from "~/data/projects";
import { ui, type Lang } from "~/i18n";
import PhaseVisual from "~/components/method/PhaseVisual.astro";
import ServiceVisual from "./ServiceVisual.astro";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui[lang];
const p = t.servicesPage.stack;
const num = (i: number) => String(i + 1).padStart(2, "0");

// Which animated visual each layer shows (method phases where they map).
const phaseFor: Partial<Record<string, 1 | 3 | 4>> = {
  "product-design": 1,
  "design-systems": 3,
  growth: 4,
};

const layers = t.services.items.map((s, i) => {
  const extra = p.byId[s.id as keyof typeof p.byId];
  const project = projects.find((x) => x.slug === extra.caseSlug);
  return { ...s, ...extra, i, project, phase: phaseFor[s.id] };
});
const n = layers.length;
// Grid rows. Desktop: top layer first, a connector row between layers.
// Mobile: layer, its panel, connector — also top layer first.
const rowLg = (i: number) => (n - 1 - i) * 2 + 1;
const rowSm = (i: number) => (n - 1 - i) * 3 + 1;
---

<section class="ss" aria-labelledby="ss-heading">
  <div class="container-page">
    <div class="ss-head">
      <p class="eyebrow">{p.eyebrow}</p>
      <div>
        <h2 id="ss-heading" class="ss-h2">
          {p.title} <span class="hl">{p.titleHl}</span>
        </h2>
        <p class="ss-sub">{p.sub}</p>
      </div>
    </div>

    <div class="ss-grid" data-ss>
      {
        layers.map((l) => (
          <Fragment>
            <button
              type="button"
              class:list={["ss-layer", { "is-active": l.i === 0 }]}
              id={`ss-layer-${l.id}`}
              aria-expanded={l.i === 0 ? "true" : "false"}
              aria-controls={`ss-panel-${l.id}`}
              data-ss-layer={l.i}
              style={`--row-lg:${rowLg(l.i)};--row-sm:${rowSm(l.i)}`}
            >
              <span class="ss-layer-num mono">
                {p.layer} {num(l.i)}
              </span>
              <span class="ss-layer-name">{l.title}</span>
              <span class="ss-layer-one">{l.oneLiner}</span>
              <span class="ss-layer-mark" aria-hidden="true" />
            </button>

            {l.i > 0 && (
              <span
                class="ss-conn"
                aria-hidden="true"
                style={`--row-lg:${rowLg(l.i) + 1};--row-sm:${rowSm(l.i) + 2}`}
              >
                <i />
                <i />
                <i />
              </span>
            )}

            <div
              class:list={["ss-panel", { "is-open": l.i === 0 }]}
              id={`ss-panel-${l.id}`}
              role="region"
              aria-labelledby={`ss-layer-${l.id}`}
              data-ss-panel={l.i}
              style={`--row-sm:${rowSm(l.i) + 1}`}
            >
              <p class="ss-panel-label mono">
                {p.layer} {num(l.i)} · {l.title}
              </p>
              <div class="ss-panel-body">
                <div class="ss-visual">
                  {l.phase ? (
                    <PhaseVisual phase={l.phase} lang={lang} label={l.visualLabel} />
                  ) : (
                    <ServiceVisual kind="leadership" lang={lang} label={l.visualLabel} />
                  )}
                </div>
                <div class="ss-info">
                  <p class="ss-lead">{l.body}</p>
                  {l.project && (
                    <a href={`/projects/${l.project.slug}/`} class="ss-case">
                      <span class="ss-case-label mono">{p.inPractice}</span>
                      <span class="ss-case-media">
                        <Image
                          src={l.project.image}
                          alt=""
                          widths={[360, 560, 720]}
                          sizes="(min-width: 1024px) 22vw, 90vw"
                          loading="lazy"
                          class="ss-case-img"
                        />
                      </span>
                      <span class="ss-case-brand">{l.project.brand}</span>
                      <span class="ss-case-metric">
                        <span class="ss-case-value">{l.value}</span>
                        <span class="ss-case-metric-label">{l.label}</span>
                      </span>
                      <span class="ss-case-cta">
                        {p.readCase}
                        <span class="sr-only"> — {l.project.brand}</span>
                        <span aria-hidden="true">→</span>
                      </span>
                    </a>
                  )}
                  <a href={`#service-${l.id}`} class="ss-detail-link">
                    {p.details}
                    <span aria-hidden="true">↓</span>
                  </a>
                </div>
              </div>
            </div>
          </Fragment>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initStack() {
    document.querySelectorAll<HTMLElement>("[data-ss]:not([data-ss-ready])").forEach((root) => {
      root.dataset.ssReady = "1";
      const layers = [...root.querySelectorAll<HTMLButtonElement>("[data-ss-layer]")];
      const panels = [...root.querySelectorAll<HTMLElement>("[data-ss-panel]")];
      const wide = window.matchMedia("(min-width: 1024px)");
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      let current = layers.findIndex((b) => b.getAttribute("aria-expanded") === "true");

      const select = (i: number) => {
        if (i === current) return;
        // On the stacked (mobile) layout, opening a panel above or below
        // shifts the page: keep the tapped layer where the finger is.
        const anchor = layers[i];
        const before = anchor.getBoundingClientRect().top;
        layers.forEach((b, k) => {
          const on = k === i;
          b.setAttribute("aria-expanded", String(on));
          b.classList.toggle("is-active", on);
          panels[k].classList.toggle("is-open", on);
        });
        current = i;
        // Replay the panel's visual from its first frame.
        panels[i]
          .querySelectorAll<HTMLElement>(".a")
          .forEach((el) => el.getAnimations().forEach((a) => (a.currentTime = 0)));
        if (!wide.matches) {
          const delta = anchor.getBoundingClientRect().top - before;
          if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: "instant" as ScrollBehavior });
        }
      };

      let hoverTimer = 0;
      layers.forEach((b, i) => {
        b.addEventListener("click", () => select(i));
        b.addEventListener("keydown", (e) => {
          // Up = the layer above (higher index); Home/End = bottom/top.
          const map: Record<string, number> = {
            ArrowUp: Math.min(i + 1, layers.length - 1),
            ArrowDown: Math.max(i - 1, 0),
            Home: 0,
            End: layers.length - 1,
          };
          if (!(e.key in map)) return;
          e.preventDefault();
          const next = map[e.key];
          layers[next].focus();
          select(next);
        });
        // Desktop mouse: hovering previews the layer (never moves focus).
        b.addEventListener("mouseenter", () => {
          if (!finePointer.matches || !wide.matches) return;
          clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(() => select(i), 140);
        });
        b.addEventListener("mouseleave", () => clearTimeout(hoverTimer));
      });
    });
  }
  initStack();
  document.addEventListener("astro:page-load", initStack);
</script>

<style>
  .ss {
    padding-block: 4.5rem 5rem;
  }
  @media (min-width: 768px) {
    .ss {
      padding-block: 7rem 7.5rem;
    }
  }
  .ss-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .ss-head {
      display: grid;
      grid-template-columns: 39fr 61fr;
      align-items: baseline;
      margin-bottom: 4rem;
    }
  }
  .ss-h2 {
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-ink);
    max-width: 20ch;
    text-wrap: balance;
  }
  .ss-sub {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  /* ---------- Grid ---------- */
  .ss-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .ss-grid > * {
    grid-column: 1;
    grid-row: var(--row-sm);
  }
  @media (min-width: 1024px) {
    .ss-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: repeat(7, auto) 1fr;
      column-gap: 3.5rem;
      align-items: start;
    }
    .ss-grid > * {
      grid-row: var(--row-lg);
    }
    .ss-grid > .ss-panel {
      grid-column: 2;
      grid-row: 1 / -1;
    }
  }

  /* ---------- Layers (slabs) ---------- */
  .ss-layer {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "num mark" "name mark" "one mark";
    align-items: center;
    width: 100%;
    padding: 1.1rem 1.25rem 1.2rem;
    text-align: left;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    /* A second outline under each slab reads as thickness. */
    box-shadow:
      0 6px 0 -1px var(--color-paper),
      0 6px 0 0 var(--color-border);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .ss-layer-num {
    grid-area: num;
    justify-self: start;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0.2rem 0.45rem;
    margin-left: -0.45rem;
    border-radius: 9999px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .ss-layer-name {
    grid-area: name;
    margin-top: 0.45rem;
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .ss-layer-one {
    grid-area: one;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .ss-layer-mark {
    grid-area: mark;
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    margin-left: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .ss-layer-mark::before {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: var(--color-muted-soft);
    transition: background-color 0.2s ease;
  }
  .ss-layer:hover {
    border-color: var(--color-muted-soft);
  }
  .ss-layer:focus-visible {
    outline-offset: 3px;
  }
  .ss-layer.is-active {
    border-color: var(--color-ink);
    background: var(--color-paper-soft);
    box-shadow:
      0 6px 0 -1px var(--color-paper-soft),
      0 6px 0 0 var(--color-ink);
  }
  .ss-layer.is-active .ss-layer-num {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .ss-layer.is-active .ss-layer-mark {
    border-color: var(--color-ink);
    background: var(--color-ink);
  }
  .ss-layer.is-active .ss-layer-mark::before {
    background: var(--color-accent);
  }
  /* Desktop: a hairline runs from the active layer to its panel. */
  @media (min-width: 1024px) {
    .ss-layer::after {
      content: "";
      position: absolute;
      top: 50%;
      left: calc(100% + 1px);
      width: 3.5rem;
      height: 1px;
      background: var(--color-ink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }
    .ss-layer.is-active::after {
      transform: scaleX(1);
    }
  }

  /* ---------- Connectors between layers ---------- */
  .ss-conn {
    display: flex;
    justify-content: space-around;
    height: 2.25rem;
    padding-inline: 18%;
    margin-top: 6px; /* clears the slab's thickness line */
  }
  .ss-conn i {
    position: relative;
    width: 1px;
    height: 100%;
    background: var(--color-border);
    overflow: hidden;
  }
  .ss-conn i::after {
    content: "";
    position: absolute;
    left: -1px;
    bottom: 0;
    width: 3px;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--color-accent);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ss-conn i::after {
      animation: ss-flow 2.4s cubic-bezier(0.45, 0, 0.3, 1) infinite;
    }
    .ss-conn i:nth-child(2)::after {
      animation-delay: 0.8s;
    }
    .ss-conn i:nth-child(3)::after {
      animation-delay: 1.6s;
    }
  }
  /* Value flows up: each layer is built on the one below. */
  @keyframes ss-flow {
    0% {
      transform: translateY(0.5rem);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    70%,
    100% {
      transform: translateY(-2.5rem);
      opacity: 0;
    }
  }

  /* ---------- Panel ---------- */
  .ss-panel {
    margin: 1rem 0 0.25rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    overflow: hidden;
  }
  .ss-panel:not(.is-open) {
    visibility: hidden;
    height: 0;
    margin: 0;
    border-width: 0;
  }
  @media (min-width: 1024px) {
    .ss-panel {
      margin: 0;
    }
  }
  .ss-panel-label {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ss-panel-body {
    display: grid;
    gap: 1.25rem;
    padding: 1rem;
  }
  @media (min-width: 640px) {
    .ss-panel-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.25rem;
    }
  }
  .ss-visual :global(.pv) {
    margin-top: 0;
  }
  .ss-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .ss-lead {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .ss-case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink);
  }
  .ss-case-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ss-case-media {
    display: block;
    margin-top: 0.75rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background: var(--color-grey);
  }
  .ss-case-media :global(.ss-case-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ss-case-brand {
    margin-top: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .ss-case-brand::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: currentColor;
    transition: background-color 0.2s ease;
  }
  .ss-case-metric {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 0.35rem;
  }
  .ss-case-value {
    font-size: clamp(2.25rem, 3.2vw, 3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .ss-case-metric-label {
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }
  .ss-case-cta {
    margin-top: 0.85rem;
    display: inline-flex;
    gap: 0.4rem;
    justify-self: start;
    font-size: 0.9375rem;
    font-weight: 500;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--color-ink);
    transition: border-color 0.2s ease;
  }
  .ss-case:hover .ss-case-brand {
    color: var(--color-ink);
  }
  .ss-case:hover .ss-case-brand::before {
    background: var(--color-accent);
  }
  .ss-case:hover .ss-case-cta {
    border-bottom-color: var(--color-accent);
  }
  .ss-detail-link {
    position: relative;
    display: inline-flex;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }
  .ss-detail-link::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.5rem;
  }
  .ss-detail-link:hover {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-layer,
    .ss-layer::after,
    .ss-layer-num,
    .ss-layer-mark,
    .ss-layer-mark::before {
      transition: none;
    }
  }
</style>
