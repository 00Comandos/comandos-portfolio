---
// "Works with what you already use" — the tools we plug into. Plain
// wordmarks (no logos, no partnership claims).
import { ui, type Lang } from "~/i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const p = ui[lang].servicesPage.tools;
---

<section class="st" aria-labelledby="st-heading">
  <div class="container-page">
    <div class="st-head">
      <p class="eyebrow">{p.eyebrow}</p>
      <div>
        <h2 id="st-heading" class="st-h2">
          {p.title} <span class="hl">{p.titleHl}</span>
        </h2>
        <p class="st-sub">{p.sub}</p>
      </div>
    </div>

    <ul class="st-grid">
      {
        p.items.map((tool) => (
          <li class="st-cell">
            <span class="st-kind mono">{tool.kind}</span>
            <span class="st-name">{tool.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .st {
    background: var(--color-paper-soft);
    padding-block: 4.5rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .st {
      padding-block: 6.5rem;
    }
  }
  .st-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .st-head {
      display: grid;
      grid-template-columns: 39fr 61fr;
      align-items: baseline;
      margin-bottom: 3.5rem;
    }
  }
  .st-h2 {
    font-size: clamp(2rem, 4.2vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-ink);
    max-width: 18ch;
    text-wrap: balance;
  }
  .st-sub {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .st-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-ink);
    border-left: 1px solid var(--color-border);
  }
  @media (min-width: 900px) {
    .st-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .st-cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 8.5rem;
    padding: 1rem 1rem 1.25rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-paper);
    transition: background-color 0.2s ease;
  }
  @media (min-width: 768px) {
    .st-cell {
      min-height: 10rem;
      padding: 1.25rem 1.5rem 1.5rem;
    }
  }
  .st-kind {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .st-name {
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--color-ink);
  }
</style>
