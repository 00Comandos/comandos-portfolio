---
/*
 * Isometric line illustration per audience profile (services page, dark
 * band). Same vocabulary as the "reality today" drawings (ServicesPains),
 * inverted for the black background: 1px light strokes, near-black faces,
 * one teal accent. Blocks rise in when the parent `[data-glyphs]` gets
 * `data-play`; without JS or under reduced motion the final state shows.
 *   1 Before PMF      — scattered tries on an empty floor, one finds the spot
 *   2 After PMF       — bars bending upward, the last one takes off
 *   3 Maturing        — several products sitting on one shared system
 *   4 No design lead  — a team whose top block is still empty
 */
import { box, fitViewBox, pt, type IsoGrid } from "./iso";

type Props = { kind: 1 | 2 | 3 | 4 };
const { kind } = Astro.props;

type Kind = "solid" | "acc" | "ghost" | "floor";
type Piece = { i: number; j: number; z0: number; z1: number; di?: number; dj?: number; gap?: number; kind: Kind; cls?: string };

const g: IsoGrid = { ox: 100, oy: 40, w: 18, h: 10.4 };

const scenes: Record<1 | 2 | 3 | 4, Piece[]> = {
  1: [
    ...[0, 1, 2, 3].flatMap((i) => [0, 1, 2, 3].map((j) => ({ i, j, z0: 0, z1: 0.01, kind: "floor" as Kind }))),
    { i: 0, j: 2, z0: 0, z1: 10, kind: "solid" },
    { i: 3, j: 0, z0: 0, z1: 16, kind: "solid" },
    { i: 2, j: 3, z0: 0, z1: 7, kind: "solid" },
    { i: 1, j: 1, z0: 0, z1: 24, kind: "acc", cls: "aa-bob" },
  ],
  2: [8, 12, 19, 32, 52].map((z, i) => ({
    i,
    j: 0,
    z0: 0,
    z1: z,
    gap: 0.2,
    kind: (i === 4 ? "acc" : "solid") as Kind,
    cls: i === 4 ? "aa-bob" : undefined,
  })),
  3: [
    { i: 0, j: 0, z0: 0, z1: 8, di: 3, dj: 3, gap: 0, kind: "acc" },
    { i: 0.25, j: 1.75, z0: 8, z1: 22, kind: "solid" },
    { i: 1, j: 1, z0: 8, z1: 30, kind: "solid" },
    { i: 1.75, j: 0.25, z0: 8, z1: 18, kind: "solid" },
  ],
  4: [
    { i: 0, j: 1, z0: 0, z1: 16, kind: "solid" },
    { i: 1, j: 1, z0: 0, z1: 16, kind: "solid" },
    { i: 2, j: 1, z0: 0, z1: 16, kind: "solid" },
    { i: 1, j: 1, z0: 26, z1: 44, kind: "ghost", cls: "aa-blink" },
  ],
};

// Painter's order: back rows first, then bottom to top.
const pieces = [...scenes[kind]].sort((a, b) => (a.kind === "floor" ? -1 : 0) - (b.kind === "floor" ? -1 : 0) || a.i + a.j - (b.i + b.j) || a.z0 - b.z0);
const shapes = pieces.map((p) => ({ ...p, ...box(g, p.i, p.j, p.z1, { di: p.di, dj: p.dj, z0: p.z0, gap: p.gap }) }));

// Guide line from the empty lead block down to the team (glyph 4).
const guide = kind === 4 ? [pt(g, 1.5, 1.5, 26), pt(g, 1.5, 1.5, 16)] : null;
const view = fitViewBox(shapes.flatMap((s) => [s.top, s.left, s.right]));
---

<svg class="aa" viewBox={view} aria-hidden="true" focusable="false">
  {
    shapes.map((s, k) => (
      <g class:list={["aa-shape", `is-${s.kind}`, s.cls]} style={`--i:${k}`}>
        {s.kind !== "floor" && <path d={s.left} class="f-left" />}
        {s.kind !== "floor" && <path d={s.right} class="f-right" />}
        <path d={s.top} class="f-top" />
      </g>
    ))
  }
  {guide && <path class="aa-guide" d={`M${guide[0].join(" ")} L${guide[1].join(" ")}`} />}
</svg>

<style>
  .aa {
    display: block;
    width: auto;
    max-width: 100%;
    height: 100%;
    overflow: visible;
  }
  .aa path {
    vector-effect: non-scaling-stroke;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .aa-shape path {
    stroke: rgb(255 255 255 / 0.82);
  }
  .f-top {
    fill: #1c1c1c;
  }
  .f-left {
    fill: #111;
  }
  .f-right {
    fill: #0a0a0a;
  }
  .is-acc .f-top {
    fill: color-mix(in srgb, var(--color-accent) 55%, var(--color-ink));
  }
  .is-acc .f-left {
    fill: color-mix(in srgb, var(--color-accent) 28%, var(--color-ink));
  }
  .is-acc .f-right {
    fill: color-mix(in srgb, var(--color-accent) 18%, var(--color-ink));
  }
  .is-floor path {
    fill: transparent;
    stroke: rgb(255 255 255 / 0.22);
    stroke-dasharray: 2 3;
  }
  .is-ghost path {
    fill: transparent;
    stroke: var(--color-accent);
    stroke-dasharray: 3 3;
  }
  .is-ghost .f-top {
    fill: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .aa-guide {
    stroke: rgb(255 255 255 / 0.4);
    stroke-dasharray: 2 3;
    fill: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Rise-in once the band is on screen (armed by ServicesPage). */
    :global([data-glyphs][data-armed]) .aa-shape:not(.is-floor) {
      opacity: 0;
      transform: translateY(10px);
    }
    :global([data-glyphs][data-play]) .aa-shape:not(.is-floor) {
      animation: aa-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--d, 0s) + var(--i, 0) * 0.07s);
    }
    :global([data-glyphs][data-play]) .aa-bob {
      animation:
        aa-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards,
        aa-bob 3.2s ease-in-out 1.4s infinite;
      animation-delay: calc(var(--d, 0s) + var(--i, 0) * 0.07s), calc(var(--d, 0s) + 1.4s);
    }
    :global([data-glyphs][data-play]) .aa-blink {
      animation:
        aa-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards,
        aa-blink 2.6s ease-in-out 1.4s infinite;
      animation-delay: calc(var(--d, 0s) + var(--i, 0) * 0.07s), calc(var(--d, 0s) + 1.4s);
    }
  }
  @keyframes aa-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes aa-bob {
    0%,
    100% {
      opacity: 1;
      transform: none;
    }
    50% {
      opacity: 1;
      transform: translateY(-4px);
    }
  }
  @keyframes aa-blink {
    0%,
    100% {
      opacity: 1;
      transform: none;
    }
    50% {
      opacity: 0.35;
      transform: none;
    }
  }
</style>
