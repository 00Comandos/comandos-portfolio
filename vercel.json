{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/ds/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/ds",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ],
  "redirects": [
    { "source": "/north-face-growth/", "destination": "/method/", "permanent": true },
    { "source": "/north-face-growth", "destination": "/method/", "permanent": true },
    {
      "source": "/:path((?!goods/|b/).*)",
      "has": [{ "type": "host", "value": "comandos.me" }],
      "destination": "https://www.comandos.me/:path",
      "permanent": true
    }
  ]
}
